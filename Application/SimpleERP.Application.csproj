<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\SimpleERP.Domain.csproj" />
    <!--
      IStringLocalizer<T> lives here. The Web project gets it free from the ASP.NET Core
      shared framework, but Application is a plain class library, so it needs the
      abstractions package explicitly — required once the services' validation messages
      are localized (Phase B); the resource files themselves need no package.
    -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="8.0.0" />
    <!--
      ILogger<T> lives here, for the same reason. Abstractions only, deliberately: the
      services declare what happened, and the Web project alone decides where that goes
      (console, rolling file, Postgres). Nothing in Application knows Serilog exists.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
