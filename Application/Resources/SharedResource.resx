<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Neutral (English) resources.

    This file deliberately contains ONLY enum display names. Every other string in the app
    uses its English text as the resource key, and ASP.NET Core returns the key unchanged
    when no entry matches, so plain English needs no entry here.

    Enum display names are the exception: their keys are synthetic ("PaymentType_Cash"),
    not natural language, so without an English entry the UI would render the raw key.
    Keys are built by SimpleERP.Web.Services.EnumDisplay.Key(enumTypeName, rawValue) from
    the raw enum name the Application layer already flattens onto DTOs via .ToString().
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
