@page "/Customers/Edit/{id:guid}"
@model SimpleERP.Web.Pages.Customers.EditModel
@{ ViewData["Title"]=Localizer["Edit Customer"].Value; }
<div style="max-width:480px">
@if(Model.Error!=null){<div class="alert alert-danger">@Model.Error</div>}
<div class="card"><div class="card-title">@Localizer["Edit Customer"]</div>
<form method="post">
  <input type="hidden" asp-for="Input.Id"/>
  <div class="fg"><label>@Localizer["Full Name"] *</label><input type="text" class="upper" asp-for="Input.Name" required/></div>
  <div class="fg"><label>@Localizer["Phone"]</label><input type="text" asp-for="Input.Phone"/></div>
  <div class="fg"><label>@Localizer["Address"]</label><textarea asp-for="Input.Address" rows="2"></textarea></div>
  <div class="frow frow2">
    <div class="fg"><label>NPWP</label><input type="text" asp-for="Input.TaxId" maxlength="50" placeholder="@Localizer["Optional"]"/></div>
    <div class="fg"><label>@Localizer["NIK (KTP)"]</label><input type="text" asp-for="Input.NationalId" maxlength="20" inputmode="numeric" placeholder="@Localizer["Optional, 16 digits"]"/></div>
  </div>
  <div class="fg"><label>@Localizer["Status"]</label><select asp-for="Input.IsActive"><option value="true">@Localizer["Active"]</option><option value="false">@Localizer["Inactive"]</option></select></div>
  <partial name="_SaleDefaults" model="Model.Defaults" />
  <div style="display:flex;gap:10px;margin-top:6px">
    <button type="submit" class="btn btn-primary">@Localizer["Update"]</button>
    <a href="/Customers" class="btn btn-outline">@Localizer["Cancel"]</a>
  </div>
</form></div></div>
