@page "/RebateRules/Edit"
@model SimpleERP.Web.Pages.RebateRules.EditModel
@{ ViewData["Title"] = Model.IsNew ? "New Rebate Rule" : "Edit Rebate Rule"; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:640px">
    <input type="hidden" asp-for="Input.Id" />

    <div class="card">
        <div class="card-title">@(Model.IsNew ? "➕ New Rebate Rule" : "✏️ Edit Rebate Rule")</div>

        <div class="fg">
            <label>Rule Name *</label>
            <input type="text" asp-for="Input.Name" required maxlength="200" placeholder="e.g. Q3 volume rebate — AC units" />
        </div>

        <div style="display:flex;gap:12px">
            <div class="fg" style="flex:1">
                <label>Supplier *</label>
                <select asp-for="Input.SupplierId" asp-items="Model.SupplierOptions" required>
                    <option value="">— Select —</option>
                </select>
            </div>
            <div class="fg" style="flex:1">
                <label>Product</label>
                <select asp-for="Input.ProductId" asp-items="Model.ProductOptions">
                    <option value="">— All products from this supplier —</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Condition — what earns the rebate</div>
        <div class="fg">
            <label>Trigger *</label>
            <select asp-for="Input.ConditionType" id="condType" onchange="syncCond()">
                <option value="1">Volume — buying (enough of) the product</option>
                <option value="2">Price drop — billed below a reference cost</option>
                <option value="3">On-time payment — paying by the due date</option>
            </select>
        </div>

        <div id="cond-volume">
            <div style="display:flex;gap:12px">
                <div class="fg" style="flex:1">
                    <label>Min Quantity (period)</label>
                    <input type="number" asp-for="Input.ThresholdQty" min="0" step="0.01" placeholder="blank = any qty" />
                </div>
                <div class="fg" style="flex:1">
                    <label>Min Value (period)</label>
                    <input type="number" asp-for="Input.ThresholdValue" min="0" step="0.01" placeholder="blank = no minimum" />
                </div>
            </div>
            <div style="font-size:11px;color:#9ca3af;margin-top:-4px">
                Thresholds are cumulative across the period below, per product.
            </div>
        </div>

        <div id="cond-pricedrop" style="display:none">
            <div class="fg">
                <label>Reference Cost (per unit)</label>
                <input type="number" asp-for="Input.ReferenceCost" min="0" step="0.01" placeholder="0" />
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    Any line billed below this earns back the difference × quantity.
                </div>
            </div>
        </div>

        <div id="cond-ontime" style="display:none">
            <div class="fg">
                <label>Grace Days</label>
                <input type="number" asp-for="Input.OnTimePaymentDays" min="0" placeholder="0" />
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    Days after the due date still counted as on time. 0 = must pay on or before due.
                </div>
            </div>
        </div>

        <div style="display:flex;gap:12px;border-top:1px solid #f3f4f6;padding-top:12px;margin-top:6px">
            <div class="fg" style="flex:1;margin-bottom:0">
                <label>Period Start</label>
                <input type="date" asp-for="Input.PeriodStart" />
            </div>
            <div class="fg" style="flex:1;margin-bottom:0">
                <label>Period End</label>
                <input type="date" asp-for="Input.PeriodEnd" />
            </div>
        </div>
        <div style="font-size:11px;color:#9ca3af;margin-top:6px">Leave blank for an open-ended rule.</div>
    </div>

    <div class="card">
        <div class="card-title">Reward — what the supplier gives back</div>
        <div class="fg">
            <label>Reward Type *</label>
            <select asp-for="Input.RewardType" id="rewardType" onchange="syncReward()">
                <option value="1">Percent discount — % of purchase value</option>
                <option value="2">Fixed cash</option>
                <option value="3">Credit note</option>
                <option value="4">In-kind goods — free stock</option>
                <option value="5">Lucky draw — value known only at settlement</option>
            </select>
        </div>

        <div id="reward-percent" class="fg">
            <label>Discount %</label>
            <input type="number" asp-for="Input.RewardRate" min="0" max="99.99" step="0.01" placeholder="0" />
        </div>

        <div id="reward-cash" class="fg" style="display:none">
            <label>Cash / Credit Amount</label>
            <input type="number" asp-for="Input.RewardAmount" min="0" step="0.01" placeholder="0" />
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">Accrued once per qualifying purchase.</div>
        </div>

        <div id="reward-inkind" style="display:none">
            <div style="display:flex;gap:12px">
                <div class="fg" style="flex:2">
                    <label>Reward Product</label>
                    <select asp-for="Input.RewardProductId" asp-items="Model.ProductOptions">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="fg" style="flex:1">
                    <label>Free Qty</label>
                    <input type="number" asp-for="Input.RewardQty" min="0" step="0.01" placeholder="0" />
                </div>
            </div>
            <div style="font-size:11px;color:#9ca3af;margin-top:-4px">
                Received into stock at zero cost when claimed, pulling the moving-average cost down.
            </div>
        </div>

        <div id="reward-luckydraw" style="display:none">
            <div class="alert alert-warning" style="font-size:12px;line-height:1.6">
                A lucky-draw rebate accrues at zero — its value isn't known until the
                supplier settles. You enter the settled amount later on the Rebates page.
            </div>
        </div>
    </div>

    <div class="card">
        <div class="fg" style="display:flex;align-items:center;gap:10px;margin-bottom:0">
            <input type="checkbox" asp-for="Input.IsActive" style="width:18px;height:18px;margin:0" />
            <label style="margin:0">Active — applies to new purchases</label>
        </div>
        @if (Model.InUse)
        {
            <div class="alert alert-warning" style="font-size:12px;line-height:1.6;margin-top:10px">
                This rule has already accrued rebates, so it can't be deleted — untick
                Active to retire it. Existing accruals keep their link to it.
            </div>
        }
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-primary" style="padding:10px 32px">💾 Save</button>
        <a href="/RebateRules" class="btn btn-outline">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
function syncCond() {
    const v = document.getElementById('condType').value;
    document.getElementById('cond-volume').style.display    = v === '1' ? '' : 'none';
    document.getElementById('cond-pricedrop').style.display = v === '2' ? '' : 'none';
    document.getElementById('cond-ontime').style.display    = v === '3' ? '' : 'none';
}
function syncReward() {
    const v = document.getElementById('rewardType').value;
    document.getElementById('reward-percent').style.display   = v === '1' ? '' : 'none';
    document.getElementById('reward-cash').style.display      = (v === '2' || v === '3') ? '' : 'none';
    document.getElementById('reward-inkind').style.display    = v === '4' ? '' : 'none';
    document.getElementById('reward-luckydraw').style.display = v === '5' ? '' : 'none';
}
syncCond();
syncReward();
</script>
}
