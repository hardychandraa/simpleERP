@page "/SalesPersons/Edit"
@model SimpleERP.Web.Pages.SalesPersons.EditModel
@{ ViewData["Title"] = Localizer["Edit Sales Person"].Value; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:520px">
    <input type="hidden" asp-for="Input.Id" />

    <div class="card">
        <div class="card-title">✏️ @Localizer["Edit Sales Person"]</div>

        <div class="fg">
            <label>@Localizer["Name"] *</label>
            <input type="text" asp-for="Input.Name" required maxlength="200" />
        </div>

        <div class="fg">
            <label>@Localizer["Sales Code"] *</label>
            <input type="text" asp-for="Input.Code" required maxlength="10" placeholder="@Localizer["e.g. S01"]" style="text-transform:uppercase" />
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">@Localizer["Printed on the invoice instead of the name."]</div>
        </div>

        <div class="fg">
            <label>@Localizer["Phone"]</label>
            <input type="text" asp-for="Input.Phone" maxlength="50" placeholder="@Localizer["Optional"]" />
        </div>

        <div class="fg" style="display:flex;align-items:center;gap:10px">
            <input type="checkbox" asp-for="Input.IsActive" style="width:18px;height:18px;margin:0" />
            <label style="margin:0">@Localizer["Active — available when creating new sales"]</label>
        </div>

        @if (Model.InUse)
        {
            <div class="alert alert-warning" style="font-size:12px;line-height:1.6;margin-top:6px">
                @Localizer["This person is credited with existing sales, so they can't be deleted — untick Active to retire them. Renaming here updates every invoice that shows their name, since attribution is stored as a link, not a copy."]
            </div>
        }
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-primary" style="padding:10px 32px">💾 @Localizer["Save"]</button>
        <a href="/SalesPersons" class="btn btn-outline">@Localizer["Cancel"]</a>
    </div>
</form>
