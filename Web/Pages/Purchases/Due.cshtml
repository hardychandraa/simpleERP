@page "/Purchases/Due"
@model SimpleERP.Web.Pages.Purchases.DueModel
@{ ViewData["Title"] = "Payables by Supplier"; }

@if (Model.Msg != null) { <div class="alert alert-success">@Model.Msg</div> }

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
  <div>
    <span style="font-size:13px;color:#6b7280">Total Owed: </span>
    <span style="font-size:20px;font-weight:700;color:#dc2626">@Model.TotalOutstanding.ToString("N0")</span>
  </div>
  <a href="/Purchases" class="btn btn-outline btn-sm">View by Purchase →</a>
</div>

@if (!Model.Summary.Any())
{
  <div class="card"><p style="color:#059669;font-size:14px;text-align:center;padding:20px">✓ Nothing outstanding to suppliers.</p></div>
}
else
{
  <div class="card">
    <table>
      <thead><tr><th>Supplier</th><th>Phone</th><th style="text-align:center">Open POs</th><th style="text-align:right">Total Owed</th><th></th></tr></thead>
      <tbody>
      @foreach (var d in Model.Summary)
      {
        <tr style="@(d.HasOverdue ? "background:#fff7f7" : "")">
          <td>
            <strong>@d.SupplierName</strong>
            @if (d.HasOverdue)
            {
              <span style="margin-left:6px;background:#fee2e2;color:#b91c1c;font-size:11px;font-weight:700;padding:2px 6px;border-radius:8px">⚠ OVERDUE</span>
            }
          </td>
          <td>@(d.Phone ?? "—")</td>
          <td style="text-align:center"><span class="badge info">@d.OpenPurchases</span></td>
          <td style="text-align:right"><span style="font-weight:700;color:#dc2626">@d.TotalDue.ToString("N0")</span></td>
          <td style="text-align:right;white-space:nowrap">
            <a href="/Purchases/Statement/@d.SupplierId" class="btn btn-primary btn-sm">📄 Statement &amp; Pay</a>
          </td>
        </tr>
      }
      </tbody>
    </table>
    <p style="font-size:11px;color:#9ca3af;margin-top:10px">
      A statement lists every open PO for that supplier so several can be settled in one
      payment, netting off any debit notes they already owe back.
    </p>
  </div>
}
