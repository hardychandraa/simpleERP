@page "/Purchases"
@model SimpleERP.Web.Pages.Purchases.IndexModel
@{ ViewData["Title"] = Localizer["Purchases"].Value; }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="card" style="margin-bottom:14px">
    <form method="get" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap">
        <div class="fg" style="margin:0;flex:1;min-width:130px">
            <label>@Localizer["From"]</label>
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1;min-width:130px">
            <label>@Localizer["To"]</label>
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1.5;min-width:160px">
            <label>@Localizer["Search"]</label>
            <input type="text" name="search" value="@Model.Search" placeholder="@Localizer["PO no., supplier doc, supplier..."]" />
        </div>
        <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
        <a href="/Purchases" class="btn btn-outline">@Localizer["Reset"]</a>
        <a href="/Purchases?pending=true" class="btn @(Model.PendingOnly ? "btn-warn" : "btn-outline")">⚠ @Localizer["Needs checking"] (@Model.PendingCount)</a>
        <a href="/Purchases/Create" class="btn btn-success" style="margin-left:auto">＋ @Localizer["New Purchase"]</a>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>@Localizer["PO Number"]</th>
                <th>@Localizer["Supplier Doc"]</th>
                <th>@Localizer["Date"]</th>
                <th>@Localizer["Supplier"]</th>
                <th>@Localizer["Payment"]</th>
                <th style="text-align:right">@Localizer["Total"]</th>
                <th style="text-align:right">@Localizer["Paid"]</th>
                <th style="text-align:right">@Localizer["Balance"]</th>
                <th style="text-align:center">@Localizer["Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Purchases)
            {
                <tr>
                    <td><strong>@p.PurchaseNumber</strong>
                        @if (p.NeedsReview && p.Status == "Active") { <br/><span class="badge warn" style="font-size:10px">@Localizer["Needs checking"]</span> }</td>
                    <td style="color:@(string.IsNullOrEmpty(p.SupplierDocumentNumber) ? "#9ca3af" : "inherit")">
                        @(string.IsNullOrEmpty(p.SupplierDocumentNumber) ? "—" : p.SupplierDocumentNumber)
                    </td>
                    <td>@p.PurchaseDate.ToLocalTime().ToString("dd-MMM-yy")</td>
                    <td>@p.SupplierName</td>
                    <td>
                        <span class="badge @(p.PaymentType == "Cash" ? "ok" : "warn")">
                            @Localizer[EnumDisplay.Key("PaymentType", p.PaymentType)]
                        </span>
                        @if (p.DueDate.HasValue && p.NetBalanceDue > 0)
                        {
                            <div style="font-size:11px;color:@(p.IsOverdue?"#dc2626":"#d97706");font-weight:600">
                                @(p.IsOverdue ? $"⚠ {Localizer["OVERDUE"].Value}" : "") @p.DueDate.Value.ToString("dd-MMM-yy")
                            </div>
                        }
                    </td>
                    <td style="text-align:right">@p.GrandTotal.ToString("N0")</td>
                    @* Paid includes applied debit notes and Balance is net of them (2026-10-05). *@
                    <td style="text-align:right">@((p.AmountPaid + p.AppliedNotesTotal).ToString("N0"))</td>
                    <td style="text-align:right">
                        @if (p.NetBalanceDue > 0 && p.Status == "Active")
                        {
                            <span style="color:#dc2626;font-weight:700">@p.NetBalanceDue.ToString("N0")</span>
                        }
                        else
                        {
                            <span style="color:#9ca3af">—</span>
                        }
                    </td>
                    <td style="text-align:center"><span class="badge @(p.Status == "Active" ? "ok" : "err")">@Localizer[EnumDisplay.Key("PurchaseStatus", p.Status)]</span></td>
                    <td><a href="/Purchases/@p.Id" class="btn btn-outline btn-sm">@Localizer["View"]</a></td>
                </tr>
            }
            @if (!Model.Purchases.Any())
            {
                <tr>
                    <td colspan="10" style="text-align:center;color:#9ca3af;padding:30px">
                        @Localizer["No purchases found."] <a href="/Purchases/Create">@Localizer["Create one"] &rarr;</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
