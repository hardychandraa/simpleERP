@page
@model SimpleERP.Web.Pages.Purchases.CreateModel
@using System.Text.Json
@{ ViewData["Title"] = "New Purchase"; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" id="purchaseForm">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px">

        <!-- Left: document header -->
        <div class="card" style="margin-bottom:0">
            <div class="card-title">Supplier Invoice</div>

            <div class="fg">
                <label>Supplier *</label>
                <select asp-for="SupplierId" id="supplierSelect" required onchange="onSupplierChange()">
                    <option value="">— Select supplier —</option>
                    @foreach (var s in Model.SupplierOptions)
                    {
                        <option value="@s.Id" data-term="@s.PaymentTermId">@s.Name</option>
                    }
                </select>
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    Manage under <a href="/Suppliers">Suppliers</a>.
                </div>
            </div>

            <div style="display:flex;gap:12px">
                <div class="fg" style="flex:1.3">
                    <label>Supplier Doc No.</label>
                    <input type="text" asp-for="SupplierDocumentNumber" maxlength="100"
                           placeholder="Their invoice number" />
                    <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                        The number printed on their paperwork. Rebate settlements are
                        matched back to it later.
                    </div>
                </div>
                <div class="fg" style="flex:1">
                    <label>Invoice Date *</label>
                    <input type="date" asp-for="PurchaseDate" required
                           value="@(Model.PurchaseDate?.ToString("yyyy-MM-dd"))"
                           onchange="updateDueDatePreview()" />
                </div>
            </div>

            <div class="fg">
                <label>Payment Type</label>
                <select asp-for="PaymentType" id="paymentTypeSelect" onchange="onPaymentTypeChange()">
                    <option value="1">Cash — paid now</option>
                    <option value="2">Credit — pay later</option>
                </select>
            </div>

            <div class="fg" id="paymentTermRow" style="display:none">
                <label>Credit Term</label>
                <select asp-for="PaymentTermId" id="paymentTermSelect" onchange="updateDueDatePreview()">
                    <option value="">— open credit (no fixed due date) —</option>
                    @foreach (var t in Model.TermOptions)
                    {
                        <option value="@t.Id" data-days="@t.DueDays">
                            @t.Name (@(t.DueDays == 0 ? "same day" : $"{t.DueDays} days"))
                        </option>
                    }
                </select>
            </div>

            <div id="dueDatePreview" style="display:none;margin-top:6px">
                <span style="font-size:13px;color:#6b7280">Payment due: </span>
                <span id="dueDateText" style="font-weight:600;color:#d97706"></span>
                <div style="font-size:11px;color:#9ca3af;margin-top:2px">
                    Counted from the supplier's invoice date, not from today.
                </div>
            </div>

            <div class="fg" style="margin-top:10px;display:flex;align-items:center;gap:10px">
                <input type="checkbox" asp-for="IsTaxInclusive" id="taxInclusiveCheck"
                       style="width:18px;height:18px;margin:0" onchange="render()" />
                <label for="taxInclusiveCheck" style="margin:0;white-space:nowrap">
                    Costs already include PPN
                </label>
            </div>
            <div style="font-size:11px;color:#9ca3af;margin:-4px 0 10px 28px">
                Stock is always valued ex-PPN either way — input VAT is reclaimed, not
                a cost of the goods.
            </div>

            <div class="fg">
                <label>Notes</label>
                <input type="text" asp-for="Notes" maxlength="500" placeholder="Optional remarks..." />
            </div>
        </div>

        <!-- Right: live summary + submit -->
        <div class="card" style="margin-bottom:0">
            <div class="card-title">Summary</div>
            <table style="font-size:14px;width:100%">
                <tr>
                    <td style="padding:6px 0;color:#6b7280">Subtotal</td>
                    <td style="text-align:right;font-weight:600" id="sumSub">0</td>
                </tr>
                <tr>
                    <td style="padding:6px 0;color:#dc2626">Line discount</td>
                    <td style="text-align:right;color:#dc2626" id="sumDisc">—</td>
                </tr>
            </table>

            <div style="border-top:1px solid #f3f4f6;padding-top:10px;margin-top:4px">
                <label style="font-size:12px;color:#6b7280">Document Discount</label>
                <div style="display:flex;gap:4px;margin-top:4px">
                    <input type="number" asp-for="InvoiceDiscountInput" min="0" step="0.01"
                           placeholder="0" style="flex:1;min-width:0" oninput="render()" />
                    <select id="invDiscMode" onchange="onInvDiscModeChange()"
                            style="width:58px;flex:none;padding:0 2px 0 8px"
                            title="Fixed amount off the whole invoice, or a percentage of the total">
                        <option value="amt">Rp</option>
                        <option value="pct">%</option>
                    </select>
                </div>
                <input type="hidden" asp-for="InvoiceDiscountIsPercent" id="invDiscIsPct" value="false" />
                <div id="invDiscHint" style="font-size:11px;color:#9ca3af;margin-top:4px;min-height:14px"></div>
            </div>

            <table style="font-size:14px;width:100%;margin-top:6px">
                <tr id="rowInvDisc" style="display:none">
                    <td style="padding:6px 0;color:#dc2626">Document discount</td>
                    <td style="text-align:right;color:#dc2626" id="sumInvDisc">—</td>
                </tr>
                <tr>
                    <td style="padding:6px 0;color:#6b7280;border-top:1px solid #f3f4f6">DPP <span style="font-size:11px;color:#9ca3af">(tax base)</span></td>
                    <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6" id="sumBase">0</td>
                </tr>
                <tr>
                    <td style="padding:6px 0;color:#6b7280">PPN Masukan <span id="sumVatLabel" style="font-size:11px;color:#9ca3af"></span></td>
                    <td style="text-align:right" id="sumTax">0</td>
                </tr>
                <tr style="border-top:2px solid #e5e7eb">
                    <td style="padding:10px 0;font-size:17px;font-weight:700">Grand Total</td>
                    <td style="text-align:right;font-size:17px;font-weight:700;color:#2563eb" id="sumTotal">0</td>
                </tr>
            </table>
            <input type="hidden" name="ItemsJson" id="ItemsJson" value="[]" />
            <button type="submit" id="submitBtn" class="btn btn-primary"
                    style="width:100%;margin-top:14px;padding:12px;font-size:15px">
                📥 Post Purchase &amp; Receive Stock
            </button>
            <div style="font-size:11px;color:#9ca3af;margin-top:8px;text-align:center">
                Every line is received into stock in one transaction.
            </div>
            <div id="submitErr" class="alert alert-danger" style="display:none;margin-top:10px"></div>
        </div>
    </div>

    <!-- Item builder -->
    <div class="card">
        <div class="card-title">Add Items</div>

        <div style="display:grid;grid-template-columns:2.5fr 0.7fr 1.1fr 1.35fr auto;gap:10px;align-items:flex-end;margin-bottom:8px">
            <div>
                <label>Product</label>
                <select id="inProd" onchange="onProductChange()">
                    <option value="">— Select —</option>
                    @foreach (var p in Model.AvailableProducts)
                    {
                        <option value="@p.Id"
                                data-cost="@p.AvgCost"
                                data-stock="@p.CurrentStock"
                                data-name="@p.Name">
                            @p.Name (@p.SKU) — Stk: @p.CurrentStock.ToString("N0")
                        </option>
                    }
                </select>
            </div>
            <div>
                <label>Qty</label>
                <input type="number" id="inQty" min="0.01" step="0.01" value="1" />
            </div>
            <div>
                <label>Unit Cost</label>
                <input type="number" id="inCost" min="0" step="0.01" placeholder="0" oninput="onDiscountInput()" />
            </div>
            <!-- position:relative so the resolved-amount hint sits below without adding
                 height to this cell, which would break the row's flex-end alignment -->
            <div style="position:relative">
                <label>Discount</label>
                <div style="display:flex;gap:4px">
                    <input type="number" id="inDisc" min="0" step="0.01" value="0" placeholder="0"
                           style="flex:1;min-width:0" oninput="onDiscountInput()" />
                    <select id="inDiscMode" onchange="onDiscountInput()"
                            style="width:58px;flex:none;padding:0 2px 0 8px"
                            title="Fixed amount per unit, or a percentage of unit cost">
                        <option value="amt">Rp</option>
                        <option value="pct">%</option>
                    </select>
                </div>
                <div id="discHint"
                     style="position:absolute;top:100%;left:0;font-size:10px;color:#9ca3af;
                            white-space:nowrap;pointer-events:none;line-height:1.3"></div>
            </div>
            <div>
                <label>&nbsp;</label>
                <button type="button" class="btn btn-success" onclick="addItem()">Add</button>
            </div>
        </div>

        <div style="margin-bottom:14px">
            <label style="font-size:12px;color:#6b7280">Line Notes <span style="font-weight:400">(batch, expiry, condition…)</span></label>
            <input type="text" id="inNotes" maxlength="500" placeholder="Optional..." />
        </div>

        <div id="addErr" class="alert alert-danger" style="display:none;margin-bottom:10px"></div>

        <table id="tbl">
            <thead>
                <tr>
                    <th>Product</th>
                    <th style="text-align:center">Qty</th>
                    <th style="text-align:right">Unit Cost</th>
                    <th style="text-align:right">Disc</th>
                    <th style="text-align:right">Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tblBody">
                <tr id="emptyRow">
                    <td colspan="6" style="text-align:center;color:#9ca3af;padding:24px">
                        No items yet — select a product above and click Add.
                    </td>
                </tr>
            </tbody>
        </table>
        <p style="font-size:11px;color:#9ca3af;margin-top:10px;line-height:1.6">
            The same product may appear on more than one line — two batches at two
            prices is normal, and each is costed in order.
        </p>
    </div>
</form>

@section Scripts {
<script>
const PRODUCTS = @Html.Raw(JsonSerializer.Serialize(
    Model.AvailableProducts.Select(p => new {
        id = p.Id.ToString(),
        name = p.Name,
        cost = p.AvgCost,
        stock = p.CurrentStock
    })
));

const SUPPLIER_TERMS = @Html.Raw(JsonSerializer.Serialize(
    Model.SupplierOptions.ToDictionary(
        s => s.Id.ToString(),
        s => s.PaymentTermId?.ToString() ?? "")
));

let items = [];  // { productId, name, qty, cost, disc, discPct, notes, total }

// ── Supplier → default credit term ───────────────────────────────────────────
// Only a convenience default: the term is stored per purchase, so changing the
// supplier's default later never touches a document already posted.
function onSupplierChange() {
    const supplierId = document.getElementById('supplierSelect').value;
    const termId = SUPPLIER_TERMS[supplierId] || '';
    if (termId) {
        document.getElementById('paymentTypeSelect').value = '2';
        onPaymentTypeChange();
        document.getElementById('paymentTermSelect').value = termId;
    }
    updateDueDatePreview();
}

function onPaymentTypeChange() {
    const isCash = document.getElementById('paymentTypeSelect').value === '1';
    document.getElementById('paymentTermRow').style.display = isCash ? 'none' : 'block';
    if (isCash) document.getElementById('paymentTermSelect').value = '';
    updateDueDatePreview();
}

// Due date runs from the supplier's invoice date, matching PurchaseService.
function updateDueDatePreview() {
    const isCash   = document.getElementById('paymentTypeSelect').value === '1';
    const termSel  = document.getElementById('paymentTermSelect');
    const termOpt  = termSel.options[termSel.selectedIndex];
    const days     = termOpt && termOpt.value ? parseInt(termOpt.dataset.days, 10) : null;
    const dateVal  = document.getElementById('PurchaseDate').value;
    const block    = document.getElementById('dueDatePreview');

    if (!isCash && days !== null && !isNaN(days) && dateVal) {
        const d = new Date(dateVal + 'T00:00:00');
        d.setDate(d.getDate() + days);
        document.getElementById('dueDateText').textContent =
            d.toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'});
        block.style.display = 'block';
    } else {
        block.style.display = 'none';
    }
}

function onProductChange() {
    const sel = document.getElementById('inProd');
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    // Seed with the current moving-average cost as a starting point; the supplier's
    // actual billed cost is what should end up here.
    const costEl = document.getElementById('inCost');
    if (!costEl.value) costEl.value = opt.dataset.cost;
    onDiscountInput();
}

// Shows what a percentage resolves to per unit, before the line is committed.
function onDiscountInput() {
    const val   = parseFloat(document.getElementById('inDisc').value) || 0;
    const isPct = document.getElementById('inDiscMode').value === 'pct';
    const cost  = parseFloat(document.getElementById('inCost').value) || 0;
    const hint  = document.getElementById('discHint');

    hint.textContent = (isPct && val > 0 && cost > 0)
        ? '= ' + fmt(Math.round((cost * val / 100) * 100) / 100) + ' /unit'
        : '';
}

function addItem() {
    hideErr('addErr');
    const selEl     = document.getElementById('inProd');
    const prodId    = selEl.value;
    const qty       = parseFloat(document.getElementById('inQty').value)  || 0;
    const cost      = parseFloat(document.getElementById('inCost').value) || 0;
    const discInput = parseFloat(document.getElementById('inDisc').value) || 0;
    const discIsPct = document.getElementById('inDiscMode').value === 'pct';
    const notes     = document.getElementById('inNotes').value.trim();

    if (!prodId)       return showErr('addErr', 'Please select a product.');
    if (qty <= 0)      return showErr('addErr', 'Quantity must be greater than zero.');
    if (cost < 0)      return showErr('addErr', 'Cost cannot be negative.');
    if (discInput < 0) return showErr('addErr', 'Discount cannot be negative.');
    if (discIsPct && discInput >= 100)
        return showErr('addErr', 'Discount percent must be less than 100.');

    // Resolve percent to a per-unit amount, mirroring the server so the preview
    // totals match what gets posted. The server recomputes it regardless.
    const discPct = discIsPct ? discInput : null;
    const discAmt = discIsPct ? Math.round((cost * discInput / 100) * 100) / 100 : discInput;

    if (discAmt >= cost && cost > 0)
        return showErr('addErr', 'Discount cannot equal or exceed unit cost.');

    const prod = PRODUCTS.find(p => p.id === prodId);
    if (!prod) return showErr('addErr', 'Product not found.');

    items.push({
        productId: prodId,
        name:      prod.name,
        qty, cost,
        disc:      discAmt,
        discPct:   discPct,
        notes:     notes || null,
        total:     (cost - discAmt) * qty
    });

    render();

    selEl.value = '';
    document.getElementById('inQty').value      = '1';
    document.getElementById('inCost').value     = '';
    document.getElementById('inDisc').value     = '0';
    document.getElementById('inDiscMode').value = 'amt';
    document.getElementById('inNotes').value    = '';
    onDiscountInput();
}

function removeItem(idx) { items.splice(idx, 1); render(); }

function render() {
    const body = document.getElementById('tblBody');

    if (items.length === 0) {
        body.innerHTML = '';
        body.appendChild(document.getElementById('emptyRow'));
        syncSummary(0, 0);
        document.getElementById('ItemsJson').value = '[]';
        return;
    }

    let subTotal = 0, discTotal = 0, html = '';
    items.forEach((item, i) => {
        subTotal  += item.cost * item.qty;
        discTotal += item.disc * item.qty;
        const notesTag = item.notes
            ? `<br><small style="color:#6b7280">📝 ${esc(item.notes)}</small>` : '';
        html += `<tr>
            <td><strong>${esc(item.name)}</strong>${notesTag}</td>
            <td style="text-align:center">${item.qty}</td>
            <td style="text-align:right">${fmt(item.cost)}</td>
            <td style="text-align:right;color:#dc2626">${item.disc > 0
                ? '-' + fmt(item.disc) + (item.discPct ? `<br><small style="color:#9ca3af">(${item.discPct}%)</small>` : '')
                : '—'}</td>
            <td style="text-align:right;font-weight:600">${fmt(item.total)}</td>
            <td><button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})">✕</button></td>
        </tr>`;
    });
    body.innerHTML = html;
    syncSummary(subTotal, discTotal);

    document.getElementById('ItemsJson').value = JSON.stringify(items.map(i => ({
        productId:       i.productId,
        qty:             i.qty,
        unitCost:        i.cost,
        discountAmount:  i.disc,
        discountPercent: i.discPct,
        notes:           i.notes || null
    })));
}

const VAT_RATE = @Model.VatRate.ToString(System.Globalization.CultureInfo.InvariantCulture);

function onInvDiscModeChange() {
    const isPct = document.getElementById('invDiscMode').value === 'pct';
    document.getElementById('invDiscIsPct').value = isPct ? 'true' : 'false';
    render();
}

// Mirrors PurchaseService exactly: resolve the document discount, then apply PPN to
// the remainder. Kept deliberately in step — a preview that disagrees with what gets
// posted is worse than no preview, which the sales side learned the hard way.
function syncSummary(sub, disc) {
    const lineNet  = sub - disc;
    const rawInput = parseFloat(document.getElementById('InvoiceDiscountInput').value) || 0;
    const isPct    = document.getElementById('invDiscMode').value === 'pct';
    const taxIncl  = document.getElementById('taxInclusiveCheck').checked;

    let invDisc = isPct ? Math.round((lineNet * rawInput / 100) * 100) / 100 : rawInput;
    if (invDisc < 0) invDisc = 0;
    if (invDisc > lineNet) invDisc = lineNet;   // preview only; the server rejects this outright

    const netTotal = lineNet - invDisc;

    let base, tax, grand;
    if (VAT_RATE <= 0) {
        base = netTotal; tax = 0; grand = netTotal;
    } else if (taxIncl) {
        grand = netTotal;
        base  = Math.round((netTotal / (1 + VAT_RATE)) * 100) / 100;
        tax   = netTotal - base;
    } else {
        base  = netTotal;
        tax   = Math.round((netTotal * VAT_RATE) * 100) / 100;
        grand = base + tax;
    }

    document.getElementById('sumSub').textContent  = fmt(sub);
    document.getElementById('sumDisc').textContent = disc > 0 ? '-' + fmt(disc) : '—';

    document.getElementById('rowInvDisc').style.display = invDisc > 0 ? '' : 'none';
    document.getElementById('sumInvDisc').textContent   = invDisc > 0 ? '-' + fmt(invDisc) : '—';

    document.getElementById('invDiscHint').textContent = (isPct && rawInput > 0 && lineNet > 0)
        ? '= ' + fmt(invDisc) + ' off the invoice' : '';

    document.getElementById('sumBase').textContent = fmt(base);
    document.getElementById('sumTax').textContent  = fmt(tax);
    document.getElementById('sumVatLabel').textContent =
        VAT_RATE > 0 ? '(' + (VAT_RATE * 100).toFixed(2).replace(/\.?0+$/, '') + '%' + (taxIncl ? ', included' : '') + ')' : '';
    document.getElementById('sumTotal').textContent = fmt(grand);
}

document.getElementById('purchaseForm').addEventListener('submit', function(e) {
    if (items.length === 0) {
        e.preventDefault();
        showErr('submitErr', 'Please add at least one item before posting.');
    }
    if (!document.getElementById('supplierSelect').value) {
        e.preventDefault();
        showErr('submitErr', 'Please select a supplier.');
    }
});

function fmt(n)    { return Math.round(n).toLocaleString(); }
function esc(s)    { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
function showErr(id, msg) { const el = document.getElementById(id); el.textContent = msg; el.style.display = 'block'; }
function hideErr(id)      { document.getElementById(id).style.display = 'none'; }

onPaymentTypeChange();
</script>
}
