@page "/Purchases/{id:guid}"
@model SimpleERP.Web.Pages.Purchases.DetailModel
@{ ViewData["Title"] = $"Purchase {Model.Purchase.PurchaseNumber}"; }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr?"alert-danger":"alert-success") no-print">@Model.Msg</div>
}

<div class="no-print" style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
    <a href="/Purchases" class="btn btn-outline btn-sm">← Purchases</a>
    <button onclick="window.print()" class="btn btn-secondary btn-sm">🖨 Print</button>
    @if (Model.Purchase.Status == "Active")
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Purchase.Id" style="margin-left:auto"
              onsubmit="return confirm('Cancel this purchase? Received stock will be reversed.')">
            <button type="submit" class="btn btn-danger btn-sm">✕ Cancel Purchase</button>
        </form>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 360px;gap:16px">
<!-- Document -->
<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
        <div>
            <div style="font-size:20px;font-weight:800;color:#1a1a2e">Purchase</div>
            <div style="color:#6b7280;font-size:12px">Supplier invoice received into stock</div>
        </div>
        <div style="text-align:right">
            <div style="font-size:18px;font-weight:700;color:#2563eb">@Model.Purchase.PurchaseNumber</div>
            <div style="color:#9ca3af;font-size:12px">@Model.Purchase.PurchaseDate.ToLocalTime().ToString("dd MMM yyyy")</div>
            @if (Model.Purchase.Status == "Cancelled")
            {
                <div style="color:#dc2626;font-weight:700;font-size:13px;margin-top:4px">⛔ CANCELLED</div>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;padding:12px;background:#f9fafb;border-radius:6px">
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Supplier</div>
            <div style="font-weight:600">@Model.Purchase.SupplierName</div>
            @if (!string.IsNullOrEmpty(Model.Purchase.SupplierPhone))
            {
                <div style="color:#6b7280;font-size:12px">📞 @Model.Purchase.SupplierPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.Purchase.SupplierDocumentNumber))
            {
                <div style="color:#6b7280;font-size:12px;margin-top:3px">📄 Their doc: <strong>@Model.Purchase.SupplierDocumentNumber</strong></div>
            }
        </div>
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Payment</div>
            @{
                var isCash = Model.Purchase.PaymentType == "Cash";
                var isOverdue = Model.Purchase.DueDate.HasValue
                             && Model.Purchase.DueDate.Value.Date < DateTime.UtcNow.Date
                             && Model.Purchase.BalanceDue > 0;
            }
            <span class="badge @(isCash ? "ok" : "warn")">@(isCash ? "💵 Cash" : "📋 Credit")</span>
            @if (!string.IsNullOrEmpty(Model.Purchase.PaymentTermName))
            {
                <span style="font-size:12px;color:#6b7280"> · @Model.Purchase.PaymentTermName</span>
            }
            @if (Model.Purchase.DueDate.HasValue)
            {
                var dueLbl = isOverdue
                    ? $"⚠ OVERDUE since {Model.Purchase.DueDate.Value:dd MMM yyyy}"
                    : $"Due by {Model.Purchase.DueDate.Value:dd MMM yyyy}";
                <div style="font-size:12px;font-weight:600;color:@(isOverdue?"#dc2626":"#d97706");margin-top:3px">@dueLbl</div>
            }
            @if (Model.StillOwed > 0)
            {
                <div style="color:#dc2626;font-weight:700;font-size:12px;margin-top:3px">Still owed: @Model.StillOwed.ToString("N0")</div>
            }
            else if (!isCash && Model.Purchase.Status == "Active")
            {
                <div style="color:#059669;font-size:12px;margin-top:3px">✓ Fully paid</div>
            }
        </div>
    </div>

    <table style="margin-bottom:14px">
        <thead>
            <tr>
                <th>Product</th>
                <th style="text-align:center">Qty</th>
                <th style="text-align:right">Unit Cost</th>
                <th style="text-align:right">Disc</th>
                <th style="text-align:right">Line Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Purchase.Items)
        {
            <tr>
                <td>
                    <div style="font-weight:600">@item.ProductName</div>
                    <div style="font-size:11px;color:#9ca3af">@item.SKU</div>
                    @if (!string.IsNullOrEmpty(item.Notes))
                    {
                        <div style="font-size:11px;color:#4b5563">📝 @item.Notes</div>
                    }
                </td>
                <td style="text-align:center">@item.Qty.ToString("N0")</td>
                <td style="text-align:right">@item.UnitCost.ToString("N0")</td>
                <td style="text-align:right;color:#dc2626">
                    @if (item.DiscountAmount > 0)
                    {
                        @($"-{item.DiscountAmount:N0}")
                        @if (item.DiscountPercent.HasValue)
                        {
                            <br /><small style="color:#9ca3af">(@item.DiscountPercent.Value.ToString("0.##")%)</small>
                        }
                    }
                    else
                    {
                        @("—")
                    }
                </td>
                <td style="text-align:right;font-weight:600">@item.LineTotal.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>

    <div style="max-width:240px;margin-left:auto">
        <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">Subtotal</span><span>@Model.Purchase.SubTotal.ToString("N0")</span></div>
        @if (Model.Purchase.DiscountTotal > 0)
        {
            <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#dc2626">Line discount</span><span style="color:#dc2626">-@Model.Purchase.DiscountTotal.ToString("N0")</span></div>
        }
        @if (Model.Purchase.InvoiceDiscountAmount > 0)
        {
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#dc2626">
                    Document discount
                    @if (Model.Purchase.InvoiceDiscountPercent.HasValue)
                    {
                        <span style="font-size:11px;color:#9ca3af">(@Model.Purchase.InvoiceDiscountPercent.Value.ToString("0.##")%)</span>
                    }
                </span>
                <span style="color:#dc2626">-@Model.Purchase.InvoiceDiscountAmount.ToString("N0")</span>
            </div>
        }
        @if (Model.Purchase.TaxAmount > 0)
        {
            <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">DPP (tax base)</span><span>@Model.Purchase.TaxBase.ToString("N0")</span></div>
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#6b7280">
                    PPN @((Model.Purchase.TaxRate * 100).ToString("0.##"))%
                    @if (Model.Purchase.IsTaxInclusive) { <span style="font-size:11px;color:#9ca3af">(included)</span> }
                </span>
                <span>@Model.Purchase.TaxAmount.ToString("N0")</span>
            </div>
        }
        <div style="display:flex;justify-content:space-between;padding:9px 0;border-top:2px solid #1a1a2e;font-size:16px;font-weight:700"><span>Grand Total</span><span>@Model.Purchase.GrandTotal.ToString("N0")</span></div>
        <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">Paid</span><span style="color:#059669;font-weight:600">@Model.Purchase.AmountPaid.ToString("N0")</span></div>
        @if (Model.StillOwed > 0)
        {
            <div style="display:flex;justify-content:space-between;padding:4px 0;font-weight:700;color:#dc2626"><span>Balance Owed</span><span>@Model.StillOwed.ToString("N0")</span></div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Purchase.Notes))
    {
        <div style="margin-top:12px;padding:10px;background:#f9fafb;border-radius:6px;font-size:13px;color:#6b7280"><strong>Notes:</strong> @Model.Purchase.Notes</div>
    }
</div>

<!-- Side panel: pay supplier + history -->
<div class="no-print">
    @if (Model.Purchase.PaymentType != "Cash" && Model.Purchase.Status == "Active")
    {
        <div class="card">
            <div class="card-title">💳 Pay Supplier</div>
            @if (Model.StillOwed <= 0)
            {
                <div class="alert alert-success" style="font-size:12px">✓ Fully paid. No balance remaining.</div>
            }
            else
            {
                <form method="post" asp-page-handler="Payment" asp-route-id="@Model.Purchase.Id">
                    <div class="fg">
                        <label>Amount to pay</label>
                        <input type="number" asp-for="PayInput.Amount" min="0.01" step="0.01" max="@Model.StillOwed" placeholder="@Model.StillOwed.ToString("N0")" required />
                        <div style="font-size:11px;color:#6b7280;margin-top:3px">Outstanding: @Model.StillOwed.ToString("N0")</div>
                    </div>
                    <div class="fg">
                        <label>Notes (optional)</label>
                        <input type="text" asp-for="PayInput.Notes" placeholder="e.g. Transfer, cheque..." />
                    </div>
                    <button type="submit" class="btn btn-success" style="width:100%">✓ Record Payment</button>
                </form>
            }
        </div>
    }

    @if (Model.Payments.Any())
    {
        <div class="card">
            <div class="card-title">Payment History</div>
            <table>
                <thead><tr><th>Date</th><th style="text-align:right">Amount</th><th>Notes</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td style="font-size:12px">@p.PaymentDate.ToLocalTime().ToString("dd-MMM-yy HH:mm")</td>
                        <td style="text-align:right;font-weight:600;color:#059669">@p.Amount.ToString("N0")</td>
                        <td style="color:#9ca3af;font-size:12px">@(p.Notes ?? "—")</td>
                    </tr>
                }
                <tr style="background:#f9fafb">
                    <td style="font-weight:700">Total</td>
                    <td style="text-align:right;font-weight:700;color:#059669">@Model.Purchase.AmountPaid.ToString("N0")</td>
                    <td></td>
                </tr>
                </tbody>
            </table>
        </div>
    }
</div>
</div>
