@page
@model ErrorModel
@{ ViewData["Title"] = Localizer["Error"].Value; }
<div class="card" style="max-width:500px;margin-top:40px;">
  <h2 style="color:#dc2626;">@Localizer["Something went wrong"]</h2>
  @if(Model.RequestId!=null){
    <p style="font-size:12px;color:#6b7280;margin-top:10px;line-height:1.6">
      @Localizer["Quote this reference when reporting the problem — the full details are recorded against it."]
    </p>
    <p style="font-family:'Courier New',monospace;font-size:15px;font-weight:700;color:#374151;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:6px;padding:8px 12px;margin-top:6px;display:inline-block">@Model.RequestId</p>
  }
  <a href="/" class="btn btn-primary" style="margin-top:16px;">&larr; @Localizer["Go Home"]</a>
</div>
