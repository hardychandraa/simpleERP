@page "/Returns/Customer/{id:guid}"
@model SimpleERP.Web.Pages.Returns.CustomerDetailModel
@{
    ViewData["Title"] = $"Sales Return {Model.Return.ReturnNumber}";
    var isActive = Model.Return.Status == "Active";
}

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success") no-print">@Model.Msg</div>
}

<div class="no-print" style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
    <a href="/Returns" class="btn btn-outline btn-sm">← Returns</a>
    <a href="/Sales/@Model.Return.SaleId" class="btn btn-outline btn-sm">Invoice @Model.Return.InvoiceNumber</a>
    <button onclick="window.print()" class="btn btn-secondary btn-sm">🖨 Print</button>
    @if (isActive)
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Return.Id" style="margin-left:auto"
              onsubmit="return confirm('Cancel this return? The goods will be taken back out of stock and the credit note voided.')">
            <button type="submit" class="btn btn-danger btn-sm">✕ Cancel Return</button>
        </form>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start">

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
        <div>
            <div style="font-size:20px;font-weight:800;color:#1a1a2e">Sales Return</div>
            <div style="color:#6b7280;font-size:12px">Goods returned by the customer</div>
        </div>
        <div style="text-align:right">
            <div style="font-size:18px;font-weight:700;color:#2563eb">@Model.Return.ReturnNumber</div>
            <div style="color:#9ca3af;font-size:12px">@Model.Return.ReturnDate.ToLocalTime().ToString("dd MMM yyyy")</div>
            @if (!isActive)
            {
                <div style="color:#dc2626;font-weight:700;font-size:13px;margin-top:4px">⛔ CANCELLED</div>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;padding:12px;background:#f9fafb;border-radius:6px">
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Customer</div>
            <div style="font-weight:600">@Model.Return.CustomerName</div>
            <div style="font-size:12px;color:#6b7280">Against invoice @Model.Return.InvoiceNumber</div>
        </div>
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Reason</div>
            <div style="font-weight:600">@Model.Return.Reason</div>
        </div>
    </div>

    <table style="margin-bottom:14px">
        <thead>
            <tr>
                <th>Product</th>
                <th style="text-align:center">Qty</th>
                <th style="text-align:right">Sold at</th>
                <th style="text-align:right">Credit</th>
                <th style="text-align:right">Restocked at</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Return.Items)
        {
            <tr>
                <td>
                    <div style="font-weight:600">@item.ProductName</div>
                    <div style="font-size:11px;color:#9ca3af">@item.SKU</div>
                    @if (!string.IsNullOrEmpty(item.Notes))
                    {
                        <div style="font-size:11px;color:#4b5563">📝 @item.Notes</div>
                    }
                </td>
                <td style="text-align:center">@item.Qty.ToString("N0")</td>
                <td style="text-align:right;color:#6b7280">@item.UnitPrice.ToString("N0")</td>
                <td style="text-align:right;font-weight:600">@item.CreditAmount.ToString("N0")</td>
                <td style="text-align:right;color:#6b7280">@item.CostAtSale.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>

    <div style="max-width:260px;margin-left:auto">
        <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6">
            <span style="color:#6b7280">Credit subtotal</span><span>@Model.Return.SubTotal.ToString("N0")</span>
        </div>
        @if (Model.Return.TaxAmount > 0)
        {
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#6b7280">DPP (tax base)</span><span>@Model.Return.TaxBase.ToString("N0")</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#6b7280">
                    PPN @((Model.Return.TaxRate * 100).ToString("0.##"))% reversed
                    @if (Model.Return.IsTaxInclusive) { <span style="font-size:11px;color:#9ca3af">(included)</span> }
                </span>
                <span>@Model.Return.TaxAmount.ToString("N0")</span>
            </div>
        }
        <div style="display:flex;justify-content:space-between;padding:9px 0;border-top:2px solid #1a1a2e;font-size:16px;font-weight:700">
            <span>Total Credited</span><span>@Model.Return.GrandTotal.ToString("N0")</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:4px 0">
            <span style="color:#6b7280">Cost restocked</span>
            <span style="color:#6b7280">@Model.Return.CostRestocked.ToString("N0")</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Return.Notes))
    {
        <div style="margin-top:12px;padding:10px;background:#f9fafb;border-radius:6px;font-size:13px;color:#6b7280">
            <strong>Notes:</strong> @Model.Return.Notes
        </div>
    }
</div>

<div class="no-print">
    <div class="card">
        <div class="card-title">📄 Credit Note</div>
        @if (Model.Return.CreditNoteId == null)
        {
            <p style="color:#9ca3af;font-size:13px">No credit note on this return.</p>
        }
        else
        {
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-weight:700;font-size:15px;color:#2563eb">@Model.Return.CreditNoteNumber</span>
                <span class="badge @(Model.Return.CreditNoteStatus == "Open" ? "warn"
                                   : Model.Return.CreditNoteStatus == "Settled" ? "ok" : "gray")">
                    @Model.Return.CreditNoteStatus
                </span>
            </div>
            <div style="font-size:20px;font-weight:700;margin-bottom:8px">@Model.Return.GrandTotal.ToString("N0")</div>
            @if (Model.Return.CreditNoteStatus == "Open")
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    This credit is still owed to the customer. Settle it on the
                    <a href="/CreditNotes">Credit &amp; Debit Notes</a> page once it has been
                    applied to an invoice or refunded.
                </p>
            }
            else if (Model.Return.CreditNoteStatus == "Settled")
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    Already applied or refunded — which is why this return can no longer be cancelled.
                </p>
            }
            else
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    Voided along with this return.
                </p>
            }
            <a href="/CreditNotes" class="btn btn-outline btn-sm" style="width:100%;justify-content:center">
                Open notes register
            </a>
        }
    </div>

    <div class="card">
        <div class="card-title">What This Return Did</div>
        <ul style="font-size:12px;color:#6b7280;line-height:1.8;padding-left:18px">
            <li>Put @Model.Return.Items.Sum(i => i.Qty).ToString("N0") unit(s) back into stock, valued
                at the cost they were sold at (@Model.Return.CostRestocked.ToString("N0")).</li>
            <li>Raised credit note @Model.Return.CreditNoteNumber for @Model.Return.GrandTotal.ToString("N0").</li>
            <li>Left invoice @Model.Return.InvoiceNumber exactly as posted — its total and payments
                are unchanged, by design.</li>
        </ul>
        <div class="alert alert-info" style="margin:10px 0 0;font-size:11px;line-height:1.5">
            Commission already accrued on this invoice is <strong>not</strong> clawed back
            automatically — whether a returned sale reduces commission is a policy question,
            still open. Check the invoice if commission was earned on it.
        </div>
    </div>

    <div class="card">
        <div class="card-title">Recorded By</div>
        <div style="font-size:13px">@Model.Return.CreatedBy</div>
    </div>
</div>
</div>
