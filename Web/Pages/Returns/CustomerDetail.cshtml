@page "/Returns/Customer/{id:guid}"
@model SimpleERP.Web.Pages.Returns.CustomerDetailModel
@{
    ViewData["Title"] = Localizer["Sales Return {0}", Model.Return.ReturnNumber].Value;
    var isActive = Model.Return.Status == "Active";
}

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success") no-print">@Model.Msg</div>
}

<div class="no-print" style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
    <a href="/Returns" class="btn btn-outline btn-sm">&larr; @Localizer["Returns"]</a>
    <a href="/Sales/@Model.Return.SaleId" class="btn btn-outline btn-sm">@Localizer["Invoice {0}", Model.Return.InvoiceNumber]</a>
    <button onclick="window.print()" class="btn btn-secondary btn-sm">🖨 @Localizer["Print"]</button>
    @if (isActive)
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Return.Id" style="margin-left:auto"
              onsubmit="return confirm('@Localizer["Cancel this return? The goods will be taken back out of stock and the credit note voided."]')">
            <button type="submit" class="btn btn-danger btn-sm">✕ @Localizer["Cancel Return"]</button>
        </form>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start">

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
        <div>
            <div style="font-size:20px;font-weight:800;color:#1a1a2e">@Localizer["Sales Return"]</div>
            <div style="color:#6b7280;font-size:12px">@Localizer["Goods returned by the customer"]</div>
        </div>
        <div style="text-align:right">
            <div style="font-size:18px;font-weight:700;color:#2563eb">@Model.Return.ReturnNumber</div>
            <div style="color:#9ca3af;font-size:12px">@Model.Return.ReturnDate.ToLocalTime().ToString("dd MMM yyyy")</div>
            @if (!isActive)
            {
                <div style="color:#dc2626;font-weight:700;font-size:13px;margin-top:4px;text-transform:uppercase">⛔ @Localizer["Cancelled"]</div>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;padding:12px;background:#f9fafb;border-radius:6px">
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">@Localizer["Customer"]</div>
            <div style="font-weight:600">@Model.Return.CustomerName</div>
            <div style="font-size:12px;color:#6b7280">@Localizer["Against invoice {0}", Model.Return.InvoiceNumber]</div>
        </div>
        <div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">@Localizer["Reason"]</div>
            <div style="font-weight:600">@Model.Return.Reason</div>
        </div>
    </div>

    <table style="margin-bottom:14px">
        <thead>
            <tr>
                <th>@Localizer["Product"]</th>
                <th style="text-align:center">@Localizer["Qty"]</th>
                <th style="text-align:right">@Localizer["Sold at"]</th>
                <th style="text-align:right">@Localizer["Credit"]</th>
                <th style="text-align:right">@Localizer["Restocked at"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Return.Items)
        {
            <tr>
                <td>
                    <div style="font-weight:600">@item.ProductName</div>
                    <div style="font-size:11px;color:#9ca3af">@item.SKU</div>
                    @if (!string.IsNullOrEmpty(item.Notes))
                    {
                        <div style="font-size:11px;color:#4b5563">📝 @item.Notes</div>
                    }
                </td>
                <td style="text-align:center">@item.Qty.ToString("N0")</td>
                <td style="text-align:right;color:#6b7280">@item.UnitPrice.ToString("N0")</td>
                <td style="text-align:right;font-weight:600">@item.CreditAmount.ToString("N0")</td>
                <td style="text-align:right;color:#6b7280">@item.CostAtSale.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>

    <div style="max-width:260px;margin-left:auto">
        <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6">
            <span style="color:#6b7280">@Localizer["Credit subtotal"]</span><span>@Model.Return.SubTotal.ToString("N0")</span>
        </div>
        @if (Model.Return.TaxAmount > 0)
        {
            @* DPP and PPN stay bare — identical in both languages. *@
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#6b7280">DPP (@Localizer["tax base"])</span><span>@Model.Return.TaxBase.ToString("N0")</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:4px 0">
                <span style="color:#6b7280">
                    PPN @((Model.Return.TaxRate * 100).ToString("0.##"))% @Localizer["reversed"]
                    @if (Model.Return.IsTaxInclusive) { <span style="font-size:11px;color:#9ca3af">(@Localizer["included"])</span> }
                </span>
                <span>@Model.Return.TaxAmount.ToString("N0")</span>
            </div>
        }
        <div style="display:flex;justify-content:space-between;padding:9px 0;border-top:2px solid #1a1a2e;font-size:16px;font-weight:700">
            <span>@Localizer["Total Credited"]</span><span>@Model.Return.GrandTotal.ToString("N0")</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:4px 0">
            <span style="color:#6b7280">@Localizer["Cost restocked"]</span>
            <span style="color:#6b7280">@Model.Return.CostRestocked.ToString("N0")</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Return.Notes))
    {
        <div style="margin-top:12px;padding:10px;background:#f9fafb;border-radius:6px;font-size:13px;color:#6b7280">
            <strong>@Localizer["Notes:"]</strong> @Model.Return.Notes
        </div>
    }
</div>

<div class="no-print">
    <div class="card">
        <div class="card-title">📄 @Localizer["Credit Note"]</div>
        @if (Model.Return.CreditNoteId == null)
        {
            <p style="color:#9ca3af;font-size:13px">@Localizer["No credit note on this return."]</p>
        }
        else
        {
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-weight:700;font-size:15px;color:#2563eb">@Model.Return.CreditNoteNumber</span>
                <span class="badge @(Model.Return.CreditNoteStatus == "Open" ? "warn"
                                   : Model.Return.CreditNoteStatus == "Settled" ? "ok" : "gray")">
                    @Localizer[EnumDisplay.Key("CreditNoteStatus", Model.Return.CreditNoteStatus)]
                </span>
            </div>
            <div style="font-size:20px;font-weight:700;margin-bottom:8px">@Model.Return.GrandTotal.ToString("N0")</div>
            @if (Model.Return.CreditNoteStatus == "Open")
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    @Localizer["This credit is still owed to the customer. Settle it on the"]
                    <a href="/CreditNotes">@Localizer["Credit & Debit Notes"]</a>
                    @Localizer["page once it has been applied to an invoice or refunded."]
                </p>
            }
            else if (Model.Return.CreditNoteStatus == "Settled")
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    @Localizer["Already applied or refunded — which is why this return can no longer be cancelled."]
                </p>
            }
            else
            {
                <p style="font-size:12px;color:#6b7280;line-height:1.6">
                    @Localizer["Voided along with this return."]
                </p>
            }
            <a href="/CreditNotes" class="btn btn-outline btn-sm" style="width:100%;justify-content:center">
                @Localizer["Open notes register"]
            </a>
        }
    </div>

    <div class="card">
        <div class="card-title">@Localizer["What This Return Did"]</div>
        @{ var unitsBack = Model.Return.Items.Sum(i => i.Qty); }
        <ul style="font-size:12px;color:#6b7280;line-height:1.8;padding-left:18px">
            <li>
                @(unitsBack == 1
                    ? Localizer["Put {0} unit back into stock, valued at the cost it was sold at ({1}).",  unitsBack.ToString("N0"), Model.Return.CostRestocked.ToString("N0")]
                    : Localizer["Put {0} units back into stock, valued at the cost they were sold at ({1}).", unitsBack.ToString("N0"), Model.Return.CostRestocked.ToString("N0")])
            </li>
            <li>@Localizer["Raised credit note {0} for {1}.", Model.Return.CreditNoteNumber, Model.Return.GrandTotal.ToString("N0")]</li>
            <li>@Localizer["Left invoice {0} exactly as posted — its total and payments are unchanged, by design.", Model.Return.InvoiceNumber]</li>
            <li>@Localizer["Clawed back the commission earned on the returned units, if this invoice was credited to a sales person."]</li>
        </ul>
        <div class="alert alert-info" style="margin:10px 0 0;font-size:11px;line-height:1.5">
            @Localizer["The clawback is posted as a"] <strong>@Localizer["negative accrual"]</strong>@Localizer[", not by editing or deleting what was already earned — so it nets off the sales person's next payout even if the original commission has already been paid out. Because of that, this return can no longer be cancelled once its clawback exists."]
        </div>
    </div>

    <div class="card">
        <div class="card-title">@Localizer["Recorded By"]</div>
        <div style="font-size:13px">@Model.Return.CreatedBy</div>
    </div>
</div>
</div>
