@page "/Returns"
@model SimpleERP.Web.Pages.Returns.IndexModel
@{ ViewData["Title"] = Localizer["Returns"].Value; var supplierSide = User.SeesSupplierSide(); }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="stats" style="grid-template-columns:repeat(@(supplierSide ? 2 : 1),1fr)">
    <div class="stat orange">
        <div class="stat-lbl">@Localizer["Credited to customers"]</div>
        <div class="stat-val">@Model.CustomerCreditTotal.ToString("N0")</div>
        @{ var activeCustomerReturns = Model.CustomerReturns.Count(r => r.Status == "Active"); }
        <div style="font-size:11px;color:#9ca3af;margin-top:2px">
            @(activeCustomerReturns == 1
                ? Localizer["{0} active sales return",  activeCustomerReturns]
                : Localizer["{0} active sales returns", activeCustomerReturns])
        </div>
    </div>
    @if (supplierSide) {
    <div class="stat teal">
        <div class="stat-lbl">@Localizer["Debited to suppliers"]</div>
        <div class="stat-val">@Model.SupplierDebitTotal.ToString("N0")</div>
        @{ var activeSupplierReturns = Model.SupplierReturns.Count(r => r.Status == "Active"); }
        <div style="font-size:11px;color:#9ca3af;margin-top:2px">
            @(activeSupplierReturns == 1
                ? Localizer["{0} active purchase return",  activeSupplierReturns]
                : Localizer["{0} active purchase returns", activeSupplierReturns])
        </div>
    </div>
    }
</div>

<div class="card" style="margin-bottom:14px">
    <form method="get" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap">
        <div class="fg" style="margin:0;flex:1;min-width:130px">
            <label>@Localizer["From"]</label>
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1;min-width:130px">
            <label>@Localizer["To"]</label>
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1.5;min-width:160px">
            <label>@Localizer["Search"]</label>
            <input type="text" name="search" value="@Model.Search" placeholder="@Localizer["Return no., document, name..."]" />
        </div>
        <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
        <a href="/Returns" class="btn btn-outline">@Localizer["Reset"]</a>
        <a href="/CreditNotes" class="btn btn-outline" style="margin-left:auto">📄 @Localizer["Credit & Debit Notes"]</a>
    </form>
    <p style="font-size:12px;color:#6b7280;margin-top:12px;line-height:1.6">
        @Localizer["A return always starts from the document it reverses: open the"]
        <a href="/Sales">@Localizer["Invoice"]</a> @if (supplierSide) {<text>@Localizer["or the"] <a href="/Purchases">@Localizer["Purchase"]</a></text>} @Localizer["and use"]
        <strong>@Localizer["Return items"]</strong>
        @Localizer["there. Posting a return restocks (or issues) the goods and raises a credit or debit note — the original document is never edited."]
    </p>
</div>

<!-- ── Sales returns ─────────────────────────────────────────────────────────── -->
<div class="card">
    <div class="card-title">↩ @Localizer["Sales Returns"] (@Model.CustomerReturns.Count)</div>
    @if (Model.CustomerReturns.Count == 0)
    {
        <p style="color:#9ca3af;font-size:13px">
            @Localizer["No sales returns. Start one from an"] <a href="/Sales">@Localizer["Invoice"]</a>.
        </p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@Localizer["Return No."]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Invoice"]</th>
                    <th>@Localizer["Customer"]</th>
                    <th>@Localizer["Reason"]</th>
                    <th style="text-align:center">@Localizer["Lines"]</th>
                    <th style="text-align:right">@Localizer["Credited"]</th>
                    <th style="text-align:center">@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.CustomerReturns)
            {
                <tr>
                    <td><strong>@r.ReturnNumber</strong></td>
                    <td>@r.ReturnDate.ToLocalTime().ToString("dd-MMM-yy")</td>
                    <td><a href="/Sales/@r.SourceId" style="color:#2563eb">@r.SourceDocument</a></td>
                    <td>@r.CounterpartyName</td>
                    <td style="font-size:12px;color:#6b7280">@r.Reason</td>
                    <td style="text-align:center">@r.LineCount</td>
                    <td style="text-align:right;font-weight:600">@r.GrandTotal.ToString("N0")</td>
                    <td style="text-align:center"><span class="badge @(r.Status == "Active" ? "ok" : "err")">@Localizer[EnumDisplay.Key("ReturnStatus", r.Status)]</span></td>
                    <td><a href="/Returns/Customer/@r.Id" class="btn btn-outline btn-sm">@Localizer["View"]</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<!-- ── Purchase returns (Admin only) ─────────────────────────────────────────── -->
@if (supplierSide) {
<div class="card">
    <div class="card-title">↪ @Localizer["Purchase Returns"] (@Model.SupplierReturns.Count)</div>
    @if (Model.SupplierReturns.Count == 0)
    {
        <p style="color:#9ca3af;font-size:13px">
            @Localizer["No purchase returns. Start one from a"] <a href="/Purchases">@Localizer["Purchase"]</a>.
        </p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@Localizer["Return No."]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Purchase"]</th>
                    <th>@Localizer["Supplier"]</th>
                    <th>@Localizer["Reason"]</th>
                    <th style="text-align:center">@Localizer["Lines"]</th>
                    <th style="text-align:right">@Localizer["Debited"]</th>
                    <th style="text-align:center">@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.SupplierReturns)
            {
                <tr>
                    <td><strong>@r.ReturnNumber</strong></td>
                    <td>@r.ReturnDate.ToLocalTime().ToString("dd-MMM-yy")</td>
                    <td><a href="/Purchases/@r.SourceId" style="color:#2563eb">@r.SourceDocument</a></td>
                    <td>@r.CounterpartyName</td>
                    <td style="font-size:12px;color:#6b7280">@r.Reason</td>
                    <td style="text-align:center">@r.LineCount</td>
                    <td style="text-align:right;font-weight:600">@r.GrandTotal.ToString("N0")</td>
                    <td style="text-align:center"><span class="badge @(r.Status == "Active" ? "ok" : "err")">@Localizer[EnumDisplay.Key("ReturnStatus", r.Status)]</span></td>
                    <td><a href="/Returns/Supplier/@r.Id" class="btn btn-outline btn-sm">@Localizer["View"]</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
}
