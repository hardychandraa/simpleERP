@page "/Expenses/Edit"
@model SimpleERP.Web.Pages.Expenses.EditModel
@{ ViewData["Title"] = Localizer["Edit Expense"].Value; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:560px">
    <input type="hidden" asp-for="Input.Id" />

    <div class="card">
        <div class="card-title">✏️ @Localizer["Edit Expense"]</div>

        <div style="display:flex;gap:12px">
            <div class="fg" style="flex:1">
                <label>@Localizer["Date"] *</label>
                <input type="date" asp-for="Input.ExpenseDate" required
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="fg" style="flex:1">
                <label>@Localizer["Amount"] *</label>
                <input type="number" asp-for="Input.Amount" required min="1" step="0.01" />
            </div>
        </div>

        <div class="fg">
            <label>@Localizer["Category"] *</label>
            <select data-searchable asp-for="Input.CategoryId" required>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id">
                        @c.Name@(c.IsTaxDeductible ? "" : "  " + Localizer["(non-deductible)"].Value)
                    </option>
                }
            </select>
        </div>

        <div class="fg">
            <label>@Localizer["Description"]</label>
            <input type="text" asp-for="Input.Description" maxlength="500" />
        </div>

        <div class="fg">
            <label>@Localizer["Reference No."]</label>
            <input type="text" asp-for="Input.ReferenceNo" maxlength="100" />
        </div>
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-primary" style="padding:10px 32px">💾 @Localizer["Save"]</button>
        <a href="/Expenses" class="btn btn-outline">@Localizer["Cancel"]</a>
    </div>
</form>
