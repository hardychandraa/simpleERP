@page "/Expenses/Create"
@model SimpleERP.Web.Pages.Expenses.CreateModel
@{ ViewData["Title"] = Localizer["Record Expense"].Value; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:560px">
    <div class="card">
        <div class="card-title">💸 @Localizer["Record Expense"]</div>

        <div style="display:flex;gap:12px">
            <div class="fg" style="flex:1">
                <label>@Localizer["Date"] *</label>
                <input type="date" asp-for="Input.ExpenseDate" required
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="fg" style="flex:1">
                <label>@Localizer["Amount"] *</label>
                <input type="number" asp-for="Input.Amount" required min="1" step="0.01"
                       placeholder="0" />
            </div>
        </div>

        <div class="fg">
            <label>@Localizer["Category"] *</label>
            <select asp-for="Input.CategoryId" required>
                <option value="">— @Localizer["select a category"] —</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id">
                        @c.Name@(c.IsTaxDeductible ? "" : "  " + Localizer["(non-deductible)"].Value)
                    </option>
                }
            </select>
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                @Localizer["Manage the list under"] <a href="/Expenses/Categories">@Localizer["Categories"]</a>.
            </div>
        </div>

        <div class="fg">
            <label>@Localizer["Description"]</label>
            <input type="text" asp-for="Input.Description" maxlength="500"
                   placeholder="@Localizer["What was it for?"]" />
        </div>

        <div class="fg">
            <label>@Localizer["Reference No."]</label>
            <input type="text" asp-for="Input.ReferenceNo" maxlength="100"
                   placeholder="@Localizer["Receipt / invoice number (optional)"]" />
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                @Localizer["Lets an entry be traced back to the paper record."]
            </div>
        </div>
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-primary" style="padding:10px 32px">💾 @Localizer["Save"]</button>
        <a href="/Expenses" class="btn btn-outline">@Localizer["Cancel"]</a>
    </div>
</form>
