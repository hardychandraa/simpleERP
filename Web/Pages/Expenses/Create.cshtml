@page "/Expenses/Create"
@model SimpleERP.Web.Pages.Expenses.CreateModel
@{ ViewData["Title"] = "Record Expense"; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:560px">
    <div class="card">
        <div class="card-title">💸 Record Expense</div>

        <div style="display:flex;gap:12px">
            <div class="fg" style="flex:1">
                <label>Date *</label>
                <input type="date" asp-for="Input.ExpenseDate" required
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="fg" style="flex:1">
                <label>Amount *</label>
                <input type="number" asp-for="Input.Amount" required min="1" step="0.01"
                       placeholder="0" />
            </div>
        </div>

        <div class="fg">
            <label>Category *</label>
            <select asp-for="Input.CategoryId" required>
                <option value="">— select a category —</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id">
                        @c.Name@(c.IsTaxDeductible ? "" : "  (non-deductible)")
                    </option>
                }
            </select>
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                Manage the list under <a href="/Expenses/Categories">Categories</a>.
            </div>
        </div>

        <div class="fg">
            <label>Description</label>
            <input type="text" asp-for="Input.Description" maxlength="500"
                   placeholder="What was it for?" />
        </div>

        <div class="fg">
            <label>Reference No.</label>
            <input type="text" asp-for="Input.ReferenceNo" maxlength="100"
                   placeholder="Receipt / invoice number (optional)" />
            <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                Lets an entry be traced back to the paper record.
            </div>
        </div>
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-primary" style="padding:10px 32px">💾 Save</button>
        <a href="/Expenses" class="btn btn-outline">Cancel</a>
    </div>
</form>
