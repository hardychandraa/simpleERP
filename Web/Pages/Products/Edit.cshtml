@page "/Products/Edit/{id:guid}"
@model SimpleERP.Web.Pages.Products.EditModel
@{ ViewData["Title"] = "Edit Product"; }
<div style="max-width:600px">
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="card"><div class="card-title">Edit Product</div>
<form method="post">
  <input type="hidden" asp-for="Input.Id"/>
  <div class="frow frow2">
    <div class="fg"><label>Product Name *</label><input type="text" asp-for="Input.Name" required/></div>
    <div class="fg"><label>SKU *</label><input type="text" asp-for="Input.SKU" required/></div>
  </div>
  <div class="frow frow2">
    <div class="fg"><label>Selling Price *</label><input type="number" asp-for="Input.UnitPrice" required min="0" step="0.01"/></div>
    <div class="fg"><label>Category</label><input type="text" asp-for="Input.Category"/></div>
  </div>
  <div class="frow frow3">
    <div class="fg"><label>Warranty (months)</label><input type="number" asp-for="Input.DefaultWarrantyMonths" min="0" max="120"/></div>
    <div class="fg"><label>Low Stock Threshold</label><input type="number" asp-for="Input.LowStockThreshold" min="0"/></div>
    <div class="fg"><label>Status</label><select asp-for="Input.IsActive"><option value="true">Active</option><option value="false">Inactive</option></select></div>
  </div>
  <div style="display:flex;gap:10px;margin-top:6px">
    <button type="submit" class="btn btn-primary">Update</button>
    <a href="/Products" class="btn btn-outline">Cancel</a>
  </div>
</form></div></div>
