@page "/Products/Edit/{id:guid}"
@model SimpleERP.Web.Pages.Products.EditModel
@{ ViewData["Title"] = Localizer["Edit Product"].Value; }
<div style="max-width:600px">
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="card"><div class="card-title">@Localizer["Edit Product"]</div>
<form method="post">
  <input type="hidden" asp-for="Input.Id"/>
  <div class="frow frow2">
    <div class="fg"><label>@Localizer["Product Name"] *</label><input type="text" asp-for="Input.Name" required/></div>
    <div class="fg"><label>@Localizer["SKU"] *</label><input type="text" asp-for="Input.SKU" required/></div>
  </div>
  <div class="frow frow3">
    <div class="fg"><label>@Localizer["Selling Price"] *</label><input type="number" asp-for="Input.UnitPrice" required min="0" step="0.01"/></div>
    <div class="fg"><label>@Localizer["Unit"] *</label><input type="text" asp-for="Input.Unit" required maxlength="10" placeholder="@Localizer["e.g. PCS, UNIT, SET"]" style="text-transform:uppercase"/></div>
    <div class="fg"><label>@Localizer["Category"]</label><input type="text" asp-for="Input.Category"/></div>
  </div>
  <div class="frow frow3">
    <div class="fg"><label>@Localizer["Warranty (months)"]</label><input type="number" asp-for="Input.DefaultWarrantyMonths" min="0" max="120"/></div>
    <div class="fg"><label>@Localizer["Low Stock Threshold"]</label><input type="number" asp-for="Input.LowStockThreshold" min="0"/></div>
    <div class="fg"><label>@Localizer["Status"]</label><select asp-for="Input.IsActive"><option value="true">@Localizer["Active"]</option><option value="false">@Localizer["Inactive"]</option></select></div>
  </div>
  <div style="display:flex;gap:10px;margin-top:6px">
    <button type="submit" class="btn btn-primary">@Localizer["Update"]</button>
    <a href="/Products" class="btn btn-outline">@Localizer["Cancel"]</a>
  </div>
</form></div></div>
