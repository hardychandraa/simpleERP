@page
@model SimpleERP.Web.Pages.Products.IndexModel
@{ ViewData["Title"] = Localizer["Products"].Value;
   var seesCost = User.SeesCost(); var maintains = User.MaintainsMasterData(); }
@if (Model.Msg != null) {
    <div class="alert @(Model.IsErr?"alert-danger":"alert-success")">@Model.Msg</div>
}
<div class="search-bar">
    <form method="get" style="display:contents">
        <input type="text" name="search" value="@Model.Search" placeholder="@Localizer["Search name, SKU, category..."]" />
        <button type="submit" class="btn btn-primary btn-sm">@Localizer["Search"]</button>
        @if (!string.IsNullOrEmpty(Model.Search)) {
            <a href="/Products@(Model.ShowEmpty ? "?showEmpty=true" : "")" class="btn btn-outline btn-sm">✕ @Localizer["Clear"]</a>
        }
        <label style="display:inline-flex;align-items:center;gap:8px;margin:0;text-transform:none;letter-spacing:0;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap">
            <input type="checkbox" name="showEmpty" value="true" checked="@Model.ShowEmpty" onchange="this.form.submit()" style="width:18px;height:18px" />
            @Localizer["Show 0 stock"]
        </label>
    </form>
    <div style="margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
      @if (seesCost) {<span><strong>@Localizer["Total Stock Value:"] </strong><span style="font-size:18px;font-weight:700;color:#059669">@Model.TotalStockValue.ToString("N0")</span></span>}
      <button type="button" id="waCopy" class="btn btn-outline">📋 @Localizer["Copy for WhatsApp"]</button>
      <a href="/Inventory/Ledger" class="btn btn-outline">📒 @Localizer["Ledger"]</a>
      @if (seesCost) {<a href="/Reports/StockList" class="btn btn-outline">🗃 @Localizer["Stock List"]</a>}
      @if (maintains) {
      <a href="/Products/Create" class="btn btn-primary">＋ @Localizer["Add Product"]</a>
      }
    </div>
</div>
<div class="card">
<table>
  <thead><tr><th>@Localizer["Name"]</th><th>@Localizer["SKU"]</th><th>@Localizer["Category"]</th><th>@Localizer["Price"]</th><th>@Localizer["Unit"]</th><th>@Localizer["Stock"]</th><th>@Localizer["Low Alert"]</th>@if (seesCost) {<th>@Localizer["Avg Cost"]</th><th>@Localizer["Stock Value"]</th>}<th>@Localizer["Warranty"]</th><th>@Localizer["Status"]</th>@if (maintains) {<th></th>}</tr></thead>
  <tbody>
  @foreach (var p in Model.Products) {
    <tr>
      <td><strong>@p.Name</strong></td>
      <td><code style="font-size:11px">@p.SKU</code></td>
      <td>@(p.Category ?? "—")</td>
      <td>@p.UnitPrice.ToString("N0")</td>
      <td style="font-size:12px">@p.Unit</td>
      @* The stock opens this product's Kartu Stok. *@
      <td><a href="/Inventory/Ledger?productId=@p.Id" title="@Localizer["Ledger"]" style="text-decoration:none"><span class="badge @(p.CurrentStock<=0?"err":p.IsLow?"warn":"ok")">@p.CurrentStock.ToString("N0")</span></a></td>
      <td style="color:#9ca3af;font-size:12px">≤ @p.LowStockThreshold</td>
      @if (seesCost) { <td>@p.AvgCost.ToString("N0")</td><td>@Model.StockValue.GetValueOrDefault(p.Id).ToString("N0")</td> }
      <td>@(p.DefaultWarrantyMonths.HasValue ? Localizer["{0} mo", p.DefaultWarrantyMonths].Value : "—")</td>
      <td><span class="badge @(p.IsActive?"ok":"gray")">@(p.IsActive?Localizer["Active"]:Localizer["Inactive"])</span></td>
      @if (maintains) {
      <td style="white-space:nowrap">
        <a href="/Products/Edit/@p.Id" class="btn btn-outline btn-sm">@Localizer["Edit"]</a>
        @if (p.IsActive) {
          <form method="post" asp-page-handler="Deactivate" style="display:inline" onsubmit="return confirm('@Localizer["Deactivate this product?"]')">
            <input type="hidden" name="id" value="@p.Id"/>
            <input type="hidden" name="search" value="@Model.Search"/>
            <input type="hidden" name="showEmpty" value="@(Model.ShowEmpty ? "true" : "false")"/>
            <button type="submit" class="btn btn-danger btn-sm">@Localizer["Off"]</button>
          </form>
        }
      </td>
      }
    </tr>
  }
  @if (!Model.Products.Any()) {
    <tr><td colspan="12" style="text-align:center;color:#9ca3af;padding:28px">
      @(!string.IsNullOrEmpty(Model.Search) ? Localizer["No results for \"{0}\".", Model.Search]
        : Model.HiddenEmpty > 0 ? Localizer["No products in stock."] : Localizer["No products yet."])
      @if (maintains) { <a href="/Products/Create">@Localizer["Add one"] &rarr;</a> }
    </td></tr>
  }
  </tbody>
</table>
@if (Model.HiddenEmpty > 0) {
  <div style="font-size:12px;color:#6b7280;margin-top:10px">
    @Localizer[Model.HiddenEmpty == 1 ? "{0} product with 0 stock hidden." : "{0} products with 0 stock hidden.", Model.HiddenEmpty]
    <a href="/Products?showEmpty=true@(string.IsNullOrEmpty(Model.Search) ? "" : "&search=" + Uri.EscapeDataString(Model.Search))">@Localizer["Show"]</a>
  </div>
}
</div>
@{
    // The stock message copies what the table shows (search and "Show 0 stock" apply), active products
    // only, never a negative figure, grouped by category. Stock only, no prices (HC, 2026-10-17).
    var noCategory = Localizer["No category"].Value;
    var waGroups = Model.Products
        .Where(p => p.IsActive && p.CurrentStock >= 0)
        .GroupBy(p => string.IsNullOrWhiteSpace(p.Category) ? noCategory : p.Category!.Trim())
        .OrderBy(g => g.Key == noCategory ? 1 : 0).ThenBy(g => g.Key)
        .Select(g => new { c = g.Key, items = g.OrderBy(p => p.Name).Select(p => new {
            n = p.Name, q = p.CurrentStock.ToString("N0"), u = p.Unit }) });
    var waData = new {
        title = Localizer["Stock {0}", Model.StoreName].Value,
        at = DateTime.Now.ToString("d MMM yyyy, HH:mm"),
        groups = waGroups,
        copied = Localizer["Copied. Paste it in WhatsApp."].Value,
        failed = Localizer["Copy failed."].Value,
        empty = Localizer["No products in stock."].Value,
    };
}
<script type="application/json" id="waData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(waData))</script>
<script>
(function () {
  var btn = document.getElementById('waCopy'); if (!btn) return;
  var d = JSON.parse(document.getElementById('waData').textContent);
  function text() {
    // WhatsApp formatting: *bold*, _italic_.
    var out = ['*' + d.title + '*', '_' + d.at + '_'];
    d.groups.forEach(function (g) {
      out.push('', '*' + g.c + '*');
      g.items.forEach(function (i) {
        out.push('• ' + i.n + ' — ' + i.q + ' ' + i.u);
      });
    });
    return out.join('\n');
  }
  function fallback(t) {
    var ta = document.createElement('textarea'); ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta); return ok;
  }
  function done(ok) {
    var old = btn.textContent; btn.textContent = ok ? '✓ ' + d.copied : d.failed;
    setTimeout(function () { btn.textContent = old; }, 2500);
  }
  btn.addEventListener('click', function () {
    if (!d.groups.length) { alert(d.empty); return; }
    var t = text();
    if (navigator.clipboard && window.isSecureContext)
      navigator.clipboard.writeText(t).then(function () { done(true); }, function () { done(fallback(t)); });
    else done(fallback(t));
  });
})();
</script>
