@page
@model SimpleERP.Web.Pages.Products.CreateModel
@{ ViewData["Title"] = Localizer["Add Product"].Value; }
<div style="max-width:600px">
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="card"><div class="card-title">@Localizer["New Product"]</div>
<form method="post">
  <div class="frow frow2">
    <div class="fg"><label>@Localizer["Product Name"] *</label><input type="text" asp-for="Input.Name" required placeholder="@Localizer["e.g. Samsung Galaxy A55"]"/></div>
    <div class="fg"><label>@Localizer["SKU"] *</label><input type="text" asp-for="Input.SKU" required placeholder="@Localizer["e.g. SAM-A55"]"/></div>
  </div>
  <div class="frow frow3">
    <div class="fg"><label>@Localizer["Selling Price"] *</label><input type="number" asp-for="Input.UnitPrice" required min="0" step="0.01"/></div>
    <div class="fg"><label>@Localizer["Unit"] *</label><input type="text" asp-for="Input.Unit" required maxlength="10" placeholder="@Localizer["e.g. PCS, UNIT, SET"]" style="text-transform:uppercase"/></div>
    <div class="fg"><label>@Localizer["Category"]</label><input type="text" asp-for="Input.Category" placeholder="@Localizer["e.g. Smartphone"]"/></div>
  </div>
  <div class="frow frow2">
    <div class="fg"><label>@Localizer["Default Warranty (months)"]</label><input type="number" asp-for="Input.DefaultWarrantyMonths" min="0" max="120"/></div>
    <div class="fg"><label>@Localizer["Low Stock Alert Threshold"]</label><input type="number" asp-for="Input.LowStockThreshold" min="0" value="2"/></div>
  </div>
  <div style="display:flex;gap:10px;margin-top:6px">
    <button type="submit" class="btn btn-primary">@Localizer["Save Product"]</button>
    <a href="/Products" class="btn btn-outline">@Localizer["Cancel"]</a>
  </div>
</form></div></div>
