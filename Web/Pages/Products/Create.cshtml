@page
@model SimpleERP.Web.Pages.Products.CreateModel
@{ ViewData["Title"] = "Add Product"; }
<div style="max-width:600px">
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="card"><div class="card-title">New Product</div>
<form method="post">
  <div class="frow frow2">
    <div class="fg"><label>Product Name *</label><input type="text" asp-for="Input.Name" required placeholder="e.g. Samsung Galaxy A55"/></div>
    <div class="fg"><label>SKU *</label><input type="text" asp-for="Input.SKU" required placeholder="e.g. SAM-A55"/></div>
  </div>
  <div class="frow frow2">
    <div class="fg"><label>Selling Price *</label><input type="number" asp-for="Input.UnitPrice" required min="0" step="0.01"/></div>
    <div class="fg"><label>Category</label><input type="text" asp-for="Input.Category" placeholder="e.g. Smartphone"/></div>
  </div>
  <div class="frow frow2">
    <div class="fg"><label>Default Warranty (months)</label><input type="number" asp-for="Input.DefaultWarrantyMonths" min="0" max="120"/></div>
    <div class="fg"><label>Low Stock Alert Threshold</label><input type="number" asp-for="Input.LowStockThreshold" min="0" value="2"/></div>
  </div>
  <div style="display:flex;gap:10px;margin-top:6px">
    <button type="submit" class="btn btn-primary">Save Product</button>
    <a href="/Products" class="btn btn-outline">Cancel</a>
  </div>
</form></div></div>
