@page
@model SimpleERP.Web.Pages.Inventory.StockInModel
@{ ViewData["Title"]=Localizer["Stock In"].Value; }
<div style="max-width:520px">
@if(Model.Error!=null){<div class="alert alert-danger">@Model.Error</div>}
@if(Model.Success!=null){<div class="alert alert-success">✓ @Model.Success</div>}
<div class="card"><div class="card-title">@Localizer["Receive Stock (Purchase)"]</div>
<form method="post">
  <div class="fg"><label>@Localizer["Product"] *</label>
    <select data-searchable asp-for="Input.ProductId" asp-items="Model.Products" required>
      <option value="">— @Localizer["Select product"] —</option>
    </select>
  </div>
  <div class="frow frow2">
    <div class="fg"><label>@Localizer["Quantity"] *</label><input type="number" asp-for="Input.Qty" required min="0.01" step="0.01" placeholder="0"/></div>
    <div class="fg"><label>@Localizer["Unit Cost"] *</label><input type="number" asp-for="Input.UnitCost" required min="0" step="0.01" placeholder="0"/></div>
  </div>
  <div class="fg"><label>@Localizer["Notes"]</label><input type="text" asp-for="Input.Notes" placeholder="@Localizer["Supplier / PO ref..."]"/></div>
  <div class="alert alert-warning" style="font-size:12px;margin-bottom:14px">⚠ @Localizer["Cost will update the Moving Average for this product."]</div>
  @if(Model.NeedsZeroCostConfirm){
    <div class="alert alert-warning" style="margin-bottom:14px">
      <strong>⚠ @Localizer["Unit cost is 0."]</strong>
      @Localizer["Receiving at cost 0 lowers this product's average cost, and the margin on every later sale. Only do this for goods received free."]
      <label style="display:flex;align-items:center;gap:8px;margin-top:10px;text-transform:none;letter-spacing:0;font-size:14px;cursor:pointer">
        <input type="checkbox" name="ConfirmZeroCost" value="true" style="width:18px;height:18px" />
        @Localizer["Yes, receive at cost 0"]
      </label>
    </div>
  }
  <div style="display:flex;gap:10px">
    <button type="submit" class="btn btn-success">📥 @Localizer["Receive"]</button>
    <a href="/Products?showEmpty=true" class="btn btn-outline">@Localizer["Cancel"]</a>
  </div>
</form></div></div>
