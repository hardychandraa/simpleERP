@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>@ViewData["Title"] — SimpleERP</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<nav class="sb" id="sb">
  <div class="sb-brand">
    <h1>⚡ SimpleERP</h1>
    <small>@Localizer["Store Management System"]</small>
  </div>
  <div class="sb-nav">
    @{
        var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        // Hides what Staff cannot reach anyway — the folder conventions in Program.cs are
        // the actual gate. A link they can see but not open is just a dead end.
        var isAdmin = User.IsInRole("Admin");
    }
    <div class="sb-sec">@Localizer["Main"]</div>
    <a href="/" class="@(page=="/Index"?"active":"")">🏠 @Localizer["Dashboard"]</a>

    <div class="sb-sec">@Localizer["Records"]</div>
    <a href="/Products"  class="@(page.StartsWith("/Products") ?"active":"")">📦 @Localizer["Products"]</a>
    <a href="/Customers" class="@(page.StartsWith("/Customers")?"active":"")">👥 @Localizer["Customers"]</a>

    <div class="sb-sec">@Localizer["Transactions"]</div>
    <a href="/Sales/Create" class="@(page=="/Sales/Create"?"active":"")">🧾 @Localizer["New Sale"]</a>
    <a href="/Sales"        class="@(page.StartsWith("/Sales/")&&page!="/Sales/Create"&&page!="/Sales/TandaTerima"?"active":"")">📋 @Localizer["Sales History"]</a>
    <a href="/Payments"     class="@(page.StartsWith("/Payments")?"active":"")">💳 @Localizer["Due Payments"]</a>
    <a href="/Sales/TandaTerima" class="@(page=="/Sales/TandaTerima"?"active":"")">🗂 @Localizer["Tanda Terima"]</a>
    @if (isAdmin)
    {
        <a href="/Commissions"  class="@(page.StartsWith("/Commissions")?"active":"")">🧾 @Localizer["Commissions"]</a>
    }

    <div class="sb-sec">@Localizer["Purchasing"]</div>
    <a href="/Purchases/Create" class="@(page=="/Purchases/Create"?"active":"")">📥 @Localizer["New Purchase"]</a>
    <a href="/Purchases"        class="@(page.StartsWith("/Purchases/")&&page!="/Purchases/Create"&&page!="/Purchases/Due"&&page!="/Purchases/Statement"?"active":"")">📦 @Localizer["Purchases"]</a>
    <a href="/Purchases/Due"    class="@(page=="/Purchases/Due"||page=="/Purchases/Statement"?"active":"")">💰 @Localizer["Payables"]</a>
    @if (isAdmin)
    {
        <a href="/Rebates"      class="@(page.StartsWith("/Rebates")?"active":"")">💰 @Localizer["Rebates"]</a>
    }

    <div class="sb-sec">@Localizer["Adjustments"]</div>
    <a href="/Returns"     class="@(page.StartsWith("/Returns")?"active":"")">↩ @Localizer["Returns"]</a>
    <a href="/CreditNotes" class="@(page.StartsWith("/CreditNotes")?"active":"")">📄 @Localizer["Credit / Debit Notes"]</a>

    <div class="sb-sec">@Localizer["Inventory"]</div>
    <a href="/Inventory/StockIn"  class="@(page=="/Inventory/StockIn" ?"active":"")">📥 @Localizer["Stock In"]</a>
    <a href="/Inventory/Adjust"   class="@(page=="/Inventory/Adjust"  ?"active":"")">⚖️ @Localizer["Adjust Stock"]</a>
    <a href="/Inventory"          class="@(page=="/Inventory/Index"   ?"active":"")">📊 @Localizer["Stock Levels"]</a>
    <a href="/Inventory/Ledger"   class="@(page=="/Inventory/Ledger"  ?"active":"")">📒 @Localizer["Ledger"]</a>

    <div class="sb-sec">@Localizer["Reports"]</div>
    <a href="/Reports/EndOfDay"  class="@(page=="/Reports/EndOfDay" ?"active":"")">📅 @Localizer["End of Day"]</a>
    @if (isAdmin)
    {
        <a href="/Reports/ProfitLoss" class="@(page=="/Reports/ProfitLoss"?"active":"")">📊 @Localizer["Profit & Loss"]</a>
        <a href="/Reports/Position"  class="@(page=="/Reports/Position" ?"active":"")">⚖️ @Localizer["Position Summary"]</a>
    }
    <a href="/Reports/Warranty"  class="@(page=="/Reports/Warranty" ?"active":"")">🛡 @Localizer["Warranty"]</a>
    @if (isAdmin)
    {
        <a href="/Audit"         class="@(page.StartsWith("/Audit") ?"active":"")">🔍 @Localizer["Audit Log"]</a>
        <a href="/Expenses"      class="@(page.StartsWith("/Expenses")    ?"active":"")">💸 @Localizer["Expenses"]</a>
    }

    <div class="sb-sec">@Localizer["Master Data"]</div>
    <a href="/Suppliers"         class="@(page.StartsWith("/Suppliers")   ?"active":"")">🏭 @Localizer["Suppliers"]</a>
    @if (isAdmin)
    {
        <a href="/RebateRules"   class="@(page.StartsWith("/RebateRules") ?"active":"")">🎁 @Localizer["Rebate Rules"]</a>
    }
    <a href="/PaymentTerms"      class="@(page.StartsWith("/PaymentTerms")?"active":"")">📆 @Localizer["Payment Terms"]</a>
    <a href="/SalesPersons"      class="@(page.StartsWith("/SalesPersons")?"active":"")">👤 @Localizer["Sales People"]</a>
    @if (isAdmin)
    {
        <a href="/CommissionRules" class="@(page.StartsWith("/CommissionRules")?"active":"")">🎯 @Localizer["Commission Rules"]</a>

        <div class="sb-sec">@Localizer["System"]</div>
        <a href="/Settings" class="@(page=="/Settings/Index"?"active":"")">⚙️ @Localizer["Settings"]</a>
        <a href="/Settings/Users" class="@(page.StartsWith("/Settings/Users")?"active":"")">🔑 @Localizer["Users"]</a>
        <a href="/Settings/Backup" class="@(page=="/Settings/Backup"?"active":"")">💾 @Localizer["Backup"]</a>
        <a href="/Settings/Logs" class="@(page=="/Settings/Logs"?"active":"")">🩺 @Localizer["Diagnostic Log"]</a>
    }
  </div>
</nav>
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <button type="button" class="nav-toggle no-print" aria-controls="sb" aria-expanded="false"
              aria-label="@Localizer["Menu"]" title="@Localizer["Menu"]">☰</button>
      <h2>@ViewData["Title"]</h2>
    </div>
    <div class="topbar-right">
      @{
          // Round-trip back to the page the user is on, query string included, so switching
          // language never loses a filter or a date range they had applied.
          var returnUrl = ViewContext.HttpContext.Request.Path
                        + ViewContext.HttpContext.Request.QueryString;
          var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
      }
      <span class="lang no-print" title="@Localizer["Language"]">
        @foreach (var (code, label) in new[] { ("id", "ID"), ("en", "EN") })
        {
            <a href="/set-language?culture=@code&amp;returnUrl=@Uri.EscapeDataString(returnUrl)"
               class="@(currentLang == code ? "on" : "")" style="border-radius:6px">@label</a>
        }
      </span>
      <span class="topbar-clock" id="topbarClock">@DateTime.Now.ToString("ddd, dd MMM yyyy  HH:mm")</span>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <span class="user-box no-print">
          <a href="/Account/ChangePassword" style="text-decoration:none;font-weight:600"
             title="@Localizer["Change Password"]">
            @(User.FindFirst("DisplayName")?.Value ?? User.Identity.Name)
            <span class="badge @(isAdmin ? "info" : "gray")" style="margin-left:4px">@Localizer[isAdmin ? "Admin" : "Staff"]</span>
          </a>
          @* POST, not a link: a GET logout can be triggered by any image tag on any page. *@
          <form method="post" action="/Account/Logout" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline btn-sm">@Localizer["Log out"]</button>
          </form>
        </span>
      }
    </div>
  </div>
  <div class="content">
    @RenderBody()
  </div>
</div>
<div class="nav-backdrop no-print"></div>
<script>
  // Phone/tablet menu: the ☰ button slides the sidebar in; the backdrop, Esc or a link closes it.
  (() => {
    const btn = document.querySelector('.nav-toggle');
    const set = open => { document.body.classList.toggle('nav-open', open); btn.setAttribute('aria-expanded', open); };
    btn.addEventListener('click', () => set(!document.body.classList.contains('nav-open')));
    document.querySelector('.nav-backdrop').addEventListener('click', () => set(false));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') set(false); });
    document.querySelectorAll('.sb-nav a').forEach(a => a.addEventListener('click', () => set(false)));
  })();
  // Data tables (those with a header row) get a sideways-scroll wrapper, so on a phone a wide
  // table scrolls inside its card. Screen only: the wrapper has no style in print.
  document.querySelectorAll('.content table').forEach(t => {
    if (!t.tHead || t.parentElement.classList.contains('table-scroll')) return;
    const w = document.createElement('div');
    w.className = 'table-scroll';
    t.parentNode.insertBefore(w, t);
    w.appendChild(t);
  });
  window.SEARCHABLE_T = {
    noMatch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["No matches"].Value)),
    search:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Type to search…"].Value))
  };
</script>
<script src="/js/searchable-select.js" asp-append-version="true"></script>
<script>
  // .upper fields hold the value itself in upper case, not just its look, so what is
  // posted, searched and shown elsewhere matches what the user saw while typing.
  document.addEventListener('input', e => {
    const el = e.target;
    if (!el.classList || !el.classList.contains('upper')) return;
    const up = el.value.toUpperCase();
    if (up === el.value) return;
    const start = el.selectionStart, end = el.selectionEnd;
    el.value = up;
    el.setSelectionRange(start, end);
  });
</script>
@{ var dtf = CultureInfo.CurrentCulture.DateTimeFormat; }
<script>
  // The top-bar clock was rendered once by the server and then stood still (HC, 2026-10-07).
  // Keep it ticking with the browser's clock, in the same "ddd, dd MMM yyyy  HH:mm" format
  // and the same day/month names as the server's culture.
  (function () {
    const el = document.getElementById('topbarClock');
    if (!el) return;
    const days   = @Html.Raw(Json.Serialize(dtf.AbbreviatedDayNames));
    const months = @Html.Raw(Json.Serialize(dtf.AbbreviatedMonthNames));
    const p2 = n => String(n).padStart(2, '0');
    function tick() {
      const d = new Date();
      el.textContent = `${days[d.getDay()]}, ${p2(d.getDate())} ${months[d.getMonth()]} ${d.getFullYear()}  ${p2(d.getHours())}:${p2(d.getMinutes())}`;
    }
    tick();
    setInterval(tick, 15000);
  })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
