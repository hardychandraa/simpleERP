@model string?
@using SimpleERP.Application.Services
@* Why a Staff sale was flagged Perlu dicek (G4/G5/G7), worded in the reader's language. Admin only:
   a below-cost line names the product. *@
<ul style="margin:4px 0 0 18px;padding:0;font-size:13px">
@foreach (var r in SaleReview.Parse(Model))
{
    var a = r.Skip(1).ToArray();
    string Arg(int i) => i < a.Length ? a[i] : "";
    // Amounts are stored as plain invariant numbers; shown in the reader's number format.
    string Amt(int i) => decimal.TryParse(Arg(i), System.Globalization.NumberStyles.Number,
        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v.ToString("N0") : Arg(i);
    <li>@(r[0] switch {
        SaleReview.BelowCost   => Localizer["{0}: sold below cost (HPP)", Arg(0)],
        SaleReview.Discount    => Localizer["{0}: {1}% below the master price", Arg(0), Arg(1)],
        SaleReview.Backdated   => Localizer["Dated {0} (yesterday)", Arg(0)],
        SaleReview.SalesPerson => Localizer["Salesperson {0} instead of the customer's {1}", Arg(0), Arg(1)],
        SaleReview.CreditLimit => Localizer["Over the credit limit: {1} owed after this sale, limit {0}", Amt(0), Amt(1)],
        SaleReview.ChangeRequest => Localizer["{0} asks to cancel or revise: {1}", Arg(0), Arg(1)],
        SaleReview.Overdue     => Arg(0) == "1"
            ? Localizer["Customer has {0} overdue invoice: {1}, {2} days past due", Arg(0), Arg(1), Arg(2)]
            : Localizer["Customer has {0} overdue invoices, oldest {1}, {2} days past due", Arg(0), Arg(1), Arg(2)],
        _                      => Localizer[r[0]] })</li>
}
</ul>
