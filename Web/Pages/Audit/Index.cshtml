@page "/Audit"
@model SimpleERP.Web.Pages.Audit.IndexModel
@{ ViewData["Title"] = Localizer["Audit Log"].Value; }
<div class="card">
  @* The Action code and Detail text below are deliberately NOT localized — HC's decision,
     2026-08-01. They are written into the database and this entity is an immutable audit
     trail, so localizing at write time would make the stored text depend on whichever
     language the operator happened to have selected: a permanently mixed-language table
     that could never be re-rendered in the other language. The values are mostly
     structured data anyway (document numbers, names, amounts, `|`-separated fields), so
     canonical English keeps them consistent and greppable. The page chrome around them
     IS localized. *@
  <div class="card-title">@Localizer["Recent Activity (last 200 events)"]</div>
  <table>
    <thead><tr><th>@Localizer["Time"]</th><th>@Localizer["User"]</th><th>@Localizer["Action"]</th><th>@Localizer["Detail"]</th></tr></thead>
    <tbody>
    @foreach (var log in Model.Logs)
    {
        var clr = log.Action.Contains("Cancel") ? "err" : log.Action.Contains("Create") ? "ok" : log.Action.Contains("Adjust") ? "warn" : "info";
      <tr>
        <td style="font-size:12px;white-space:nowrap">@log.Timestamp.ToLocalTime().ToString("dd-MMM-yy HH:mm:ss")</td>
        <td style="font-size:12px;color:#9ca3af">@log.User</td>
        <td><span class="badge @clr">@log.Action</span></td>
        <td style="font-size:12px;color:#374151;max-width:400px">@(log.Detail ?? "—")</td>
      </tr>
    }
    @if (!Model.Logs.Any())
    {
      <tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:28px">@Localizer["No audit events yet."]</td></tr>
    }
    </tbody>
  </table>
</div>
