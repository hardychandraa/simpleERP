@page
@model IndexModel
@{ ViewData["Title"] = Localizer["Dashboard"].Value; }

@if (Model.ShowTotals) {
<div class="stats">
  <div class="stat blue"><div class="stat-lbl">@Localizer["Active Products"]</div><div class="stat-val">@Model.TotalProducts</div></div>
  <div class="stat green"><div class="stat-lbl">@Localizer["Today Revenue"]</div><div class="stat-val" style="font-size:17px">@Model.TodayRevenue.ToString("N0")</div></div>
  <div class="stat teal"><div class="stat-lbl">@Localizer["Today Cash In"]</div><div class="stat-val" style="font-size:17px">@Model.TodayCashIn.ToString("N0")</div></div>
  <div class="stat red"><div class="stat-lbl">@Localizer["Outstanding Due"]</div><div class="stat-val" style="font-size:17px">@Model.TotalOutstanding.ToString("N0")</div></div>
</div>
}

<partial name="_PendingChecks" model="Model.PendingChecks" />
@if (Model.LateChecks > 0)
{
    @* R6: an unchecked Goods In has already added stock and a payable; a fake one hides until checked. *@
    <div class="alert alert-danger no-print" style="line-height:1.6">
        ⏰ @Localizer["{0} purchase(s) unchecked for {1}+ days (oldest {2} days). Check them against the supplier invoice.", Model.LateChecks, SimpleERP.Application.DTOs.GoodsInCheck.AlertAfterDays, Model.OldestCheckDays]
        <a href="/Purchases?pending=true" style="font-weight:700;margin-left:6px">@Localizer["Check now"] &rarr;</a>
    </div>
}
@if (Model.SalesToCheck + Model.NotesToApprove + Model.ReturnsToCheck + Model.PaymentsToVerify > 0)
{
    <div class="alert alert-warning no-print" style="line-height:1.8">
        ⚠ <strong>@Localizer["Staff work to check"]:</strong>
        @if (Model.PaymentsToVerify > 0) { <a href="/Payments/Pending" style="font-weight:700;margin-left:6px">@Localizer["{0} payment(s) to verify", Model.PaymentsToVerify] &rarr;</a> }
        @if (Model.SalesToCheck > 0)   { <a href="/Sales?pending=true" style="font-weight:700;margin-left:6px">@Localizer["{0} sale(s)", Model.SalesToCheck] &rarr;</a> }
        @if (Model.NotesToApprove > 0) { <a href="/CreditNotes" style="font-weight:700;margin-left:10px">@Localizer["{0} credit note(s) to approve", Model.NotesToApprove] &rarr;</a> }
        @if (Model.ReturnsToCheck > 0) { <a href="/Returns" style="font-weight:700;margin-left:10px">@Localizer["{0} staff return(s)", Model.ReturnsToCheck] &rarr;</a> }
    </div>
}
@if (Model.CancelledToday.Any())
{
    <div class="card no-print" style="margin-bottom:14px">
        <div class="card-title">⛔ @Localizer["Cancelled or revised today"]</div>
        <table>
            <thead><tr><th>@Localizer["Invoice"]</th><th>@Localizer["Customer"]</th><th style="text-align:right">@Localizer["Total"]</th><th>@Localizer["By"]</th><th>@Localizer["Reason"]</th></tr></thead>
            <tbody>
            @foreach (var c in Model.CancelledToday)
            {
                <tr><td><a href="/Sales/@c.Id">@c.InvoiceNumber</a> <span style="font-size:11px;color:#9ca3af">@c.CancelledAt?.ToLocalTime().ToString("HH:mm")</span></td>
                    <td>@c.CustomerName</td><td style="text-align:right">@c.GrandTotal.ToString("N0")</td>
                    <td style="font-size:12px">@c.CancelledBy</td><td style="font-size:12px">@(c.CancelReason ?? "—")</td></tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.PendingCounts > 0)
{
    <div class="alert alert-warning no-print" style="line-height:1.6">
        ⚠ @Localizer["{0} stock count(s) have differences waiting for your decision.", Model.PendingCounts]
        <a href="/StockCounts?waiting=true" style="font-weight:700;margin-left:6px">@Localizer["Check now"] &rarr;</a>
    </div>
}

@if (Model.OverdueCount > 0) {
  @* The count and the emphasised words stay as markup outside the localized fragments, so the
     bolding survives translation. Both languages lead with the number, so splitting here is safe. *@
  <div class="alert alert-danger">
    🚨 <strong>@Model.OverdueCount</strong>
    @(Model.OverdueCount == 1 ? Localizer["sale is"] : Localizer["sales are"])
    <strong>@Localizer["OVERDUE"]</strong> &mdash; @Localizer["payment due date has passed."]
    <a href="/Sales/Due?view=invoice" style="color:#b91c1c;font-weight:700;margin-left:6px">@Localizer["View overdue"] &rarr;</a>
  </div>
} else if (Model.OutstandingCount > 0) {
  <div class="alert alert-warning">
    ⚠ <strong>@Model.OutstandingCount</strong>
    @(Model.OutstandingCount == 1
        ? Localizer["sale has an unpaid balance totalling"]
        : Localizer["sales have unpaid balances totalling"])
    <strong>@Model.TotalOutstanding.ToString("N0")</strong>.
    <a href="/Sales/Due" style="color:#92400e;font-weight:700;margin-left:6px">@Localizer["Collect now"] &rarr;</a>
  </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <div class="card">
    <div class="card-title">@Localizer["Recent Sales"]</div>
    @if (!Model.RecentSales.Any()) { <p style="color:#9ca3af;font-size:13px">@Localizer["No sales yet."] <a href="/Sales/Create">@Localizer["Create one"] &rarr;</a></p> }
    else {
      <table>
        <thead><tr><th>@Localizer["Invoice"]</th><th>@Localizer["Customer"]</th><th>@Localizer["Total"]</th><th>@Localizer["Type"]</th><th>@Localizer["Status"]</th></tr></thead>
        <tbody>
        @foreach (var s in Model.RecentSales) {
          <tr>
            <td><a href="/Sales/@s.Id" style="color:#2563eb;text-decoration:none;font-weight:600">@s.InvoiceNumber</a></td>
            <td>@s.CustomerName</td>
            <td>@s.GrandTotal.ToString("N0")</td>
            <td><span class="badge @(s.PaymentType=="Cash"?"ok":"warn")">@Localizer[EnumDisplay.Key("PaymentType", s.PaymentType)]</span></td>
            <td><span class="badge @(s.Status=="Active"?"ok":"err")">@Localizer[EnumDisplay.Key("SaleStatus", s.Status)]</span></td>
          </tr>
        }
        </tbody>
      </table>
    }
    <div style="margin-top:10px;display:flex;gap:8px">
      <a href="/Sales" class="btn btn-outline btn-sm">@Localizer["All Sales"] &rarr;</a>
      @if (Model.ShowTotals) {
      <a href="/Reports/EndOfDay" class="btn btn-outline btn-sm">📅 @Localizer["End of Day"] &rarr;</a>
      }
    </div>
  </div>

  <div class="card">
    <div class="card-title">⚠ @Localizer["Low / Out of Stock"]</div>
    @if (!Model.LowStock.Any()) { <p style="color:#059669;font-size:13px">✓ @Localizer["All stock levels are above threshold."]</p> }
    else {
      <table>
        <thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Stock"]</th><th>@Localizer["Alert at"]</th></tr></thead>
        <tbody>
        @foreach (var s in Model.LowStock) {
          <tr>
            <td><strong>@s.ProductName</strong><br/><code style="font-size:10px;color:#9ca3af">@s.SKU</code></td>
            <td><span class="badge @(s.CurrentStock<=0?"err":"warn")">@s.CurrentStock.ToString("N0")</span></td>
            <td style="color:#9ca3af;font-size:12px">≤ @s.LowStockThreshold</td>
          </tr>
        }
        </tbody>
      </table>
    }
    <div style="margin-top:10px;display:flex;gap:8px">
      <a href="/Products?showEmpty=true" class="btn btn-outline btn-sm">@Localizer["View All"] &rarr;</a>
    </div>
  </div>
</div>
