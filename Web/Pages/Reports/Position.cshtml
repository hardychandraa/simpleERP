@page "/Reports/Position"
@model SimpleERP.Web.Pages.Reports.PositionModel
@{ ViewData["Title"] = Localizer["Position Summary"].Value; }

@* Localization note: the Indonesian domain terms below (Ringkasan Posisi, Persediaan,
   Piutang/Utang Usaha, Nota Kredit/Debit, Posisi Bersih, Rebat, Komisi, PPN…) are
   deliberately left as bare literals and never routed through the localizer — they are
   identical in both languages, because they are the terms staff, the tax consultant and the
   printed paperwork already use. Only the English chrome and explanatory prose switch. *@

<partial name="_PendingChecks" model="Model.PendingChecks" />
<div style="display:flex;justify-content:flex-end;margin-bottom:18px" class="no-print">
  <button onclick="window.print()" class="btn btn-outline btn-sm">🖨 @Localizer["Print Report"]</button>
</div>

<div style="text-align:center;margin-bottom:16px">
  @* Bilingual letterhead: the Indonesian name is the report's identity, the English line
     underneath is its standard English name. Both stay put in either language. *@
  <div style="font-size:22px;font-weight:800;color:#1a1a2e">Ringkasan Posisi</div>
  <div style="font-size:13px;color:#9ca3af">Position Summary</div>
  <div style="color:#6b7280;margin-top:4px">
    @Localizer["as of"] @Model.Report.AsOf.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
  </div>
</div>

<div class="stats" style="grid-template-columns:repeat(3,1fr)">
  <div class="stat blue">
    <div class="stat-lbl">Total Aset Lancar</div>
    <div class="stat-val" style="font-size:18px">@Model.Report.TotalAssets.ToString("N0")</div>
  </div>
  <div class="stat red">
    <div class="stat-lbl">Total Kewajiban</div>
    <div class="stat-val" style="font-size:18px">@Model.Report.TotalLiabilities.ToString("N0")</div>
  </div>
  <div class="stat @(Model.Report.NetPosition >= 0 ? "green" : "red")">
    <div class="stat-lbl">Posisi Bersih</div>
    <div class="stat-val" style="font-size:18px">@Model.Report.NetPosition.ToString("N0")</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

  <div class="card">
    <div class="card-title">Aset &mdash; @Localizer["what the business holds"]</div>
    <table style="width:100%;font-size:14px">
      <tbody>
        <tr>
          <td style="padding:7px 0">
            Persediaan <span style="color:#9ca3af;font-size:11px">(@Localizer["stock on hand"])</span>
            <div style="color:#9ca3af;font-size:11px">
              @(Model.Report.ProductsInStock == 1
                  ? Localizer["{0} product in stock",  Model.Report.ProductsInStock]
                  : Localizer["{0} products in stock", Model.Report.ProductsInStock])
              &middot; <a href="/Products?showEmpty=true" class="no-print">@Localizer["Products"] &rarr;</a>
            </div>
          </td>
          <td style="text-align:right;font-weight:600;vertical-align:top">@Model.Report.InventoryValue.ToString("N0")</td>
        </tr>

        <tr>
          <td style="padding:7px 0;border-top:1px solid #f3f4f6">
            Piutang Usaha <span style="color:#9ca3af;font-size:11px">(@Localizer["incl. PPN"])</span>
            <div style="color:#9ca3af;font-size:11px">
              @(Model.Report.OpenInvoices == 1
                  ? Localizer["{0} open invoice",  Model.Report.OpenInvoices]
                  : Localizer["{0} open invoices", Model.Report.OpenInvoices])
              &middot; <a href="/Sales/Due" class="no-print">@Localizer["AR Due"] &rarr;</a>
            </div>
          </td>
          <td style="text-align:right;font-weight:600;vertical-align:top;border-top:1px solid #f3f4f6">@Model.Report.ReceivablesGross.ToString("N0")</td>
        </tr>
        @if (Model.Report.CreditNotesApplied > 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#dc2626;font-size:13px" title="@Localizer["Credit notes applied to specific invoices"]">
              (&minus;) Nota Kredit diterapkan
            </td>
            <td style="text-align:right;color:#dc2626;font-size:13px">@Model.Report.CreditNotesApplied.ToString("N0")</td>
          </tr>
          <tr>
            <td style="padding:5px 0">Piutang Bersih</td>
            <td style="text-align:right;font-weight:600">@Model.Report.ReceivablesNet.ToString("N0")</td>
          </tr>
        }
        @{ var ar = Model.Report.ReceivablesAging; }
        @if (ar.Total > 0)
        {
          <tr>
            <td colspan="2" style="padding:6px 0 2px 14px">
              <table style="width:100%;font-size:11px;color:#6b7280">
                <tr>
                  <td>@Localizer["Not yet due"]</td>
                  <td style="text-align:right">@ar.NotYetDue.ToString("N0")</td>
                  <td style="width:14px"></td>
                  <td style="color:@(ar.Days1To30  > 0 ? "#b45309" : "#9ca3af")">1&ndash;30</td>
                  <td style="text-align:right;color:@(ar.Days1To30  > 0 ? "#b45309" : "#9ca3af")">@ar.Days1To30.ToString("N0")</td>
                </tr>
                <tr>
                  <td style="color:@(ar.Days31To60 > 0 ? "#c2410c" : "#9ca3af")">31&ndash;60</td>
                  <td style="text-align:right;color:@(ar.Days31To60 > 0 ? "#c2410c" : "#9ca3af")">@ar.Days31To60.ToString("N0")</td>
                  <td></td>
                  <td style="color:@(ar.Days61To90 > 0 ? "#dc2626" : "#9ca3af")">61&ndash;90</td>
                  <td style="text-align:right;color:@(ar.Days61To90 > 0 ? "#dc2626" : "#9ca3af")">@ar.Days61To90.ToString("N0")</td>
                </tr>
                <tr>
                  <td style="color:@(ar.Days90Plus > 0 ? "#991b1b" : "#9ca3af");font-weight:@(ar.Days90Plus > 0 ? "700" : "400")">90+</td>
                  <td style="text-align:right;color:@(ar.Days90Plus > 0 ? "#991b1b" : "#9ca3af");font-weight:@(ar.Days90Plus > 0 ? "700" : "400")">@ar.Days90Plus.ToString("N0")</td>
                  <td></td>
                  @if (ar.NoDueDate > 0)
                  {
                    <td title="@Localizer["Credit with no payment term agreed, so there is no date to be late against"]">@Localizer["No due date"]</td>
                    <td style="text-align:right">@ar.NoDueDate.ToString("N0")</td>
                  }
                  else
                  {
                    <td></td><td></td>
                  }
                </tr>
              </table>
            </td>
          </tr>
        }
        @if (Model.Report.OpenCreditNotes > 0)
        {
          <tr>
            <td colspan="2" style="padding:4px 0 2px 14px;color:#9ca3af;font-size:11px"
                title="@Localizer["Not subtracted above — a note only reduces a balance once it is applied to a specific invoice"]">
              @Localizer["Plus {0} in open credit notes not yet applied to any invoice", Model.Report.OpenCreditNotes.ToString("N0")]
              &middot; <a href="/CreditNotes" class="no-print">@Localizer["Credit & Debit Notes"] &rarr;</a>
            </td>
          </tr>
        }

        <tr>
          <td style="padding:7px 0;border-top:1px solid #f3f4f6">
            Rebat belum diklaim
            <div style="color:#9ca3af;font-size:11px">
              @(Model.Report.UnclaimedRebateCount == 1
                  ? Localizer["{0} cash accrual",  Model.Report.UnclaimedRebateCount]
                  : Localizer["{0} cash accruals", Model.Report.UnclaimedRebateCount])
              &middot; <a href="/Rebates" class="no-print">@Localizer["Rebates"] &rarr;</a>
            </div>
          </td>
          <td style="text-align:right;font-weight:600;vertical-align:top;border-top:1px solid #f3f4f6">@Model.Report.UnclaimedRebate.ToString("N0")</td>
        </tr>
        @if (Model.Report.RebateInKindOutstanding > 0 || Model.Report.RebateLuckyDrawOutstanding > 0)
        {
          <tr>
            <td colspan="2" style="padding:2px 0 2px 14px;color:#9ca3af;font-size:11px">
              @Localizer["plus {0} in-kind and {1} lucky-draw accrual(s) outstanding, carried without a cash value until settled",
                         Model.Report.RebateInKindOutstanding, Model.Report.RebateLuckyDrawOutstanding]
            </td>
          </tr>
        }

        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:700;font-size:15px">Total Aset Lancar</td>
          <td style="text-align:right;font-weight:700;font-size:15px;color:#059669">@Model.Report.TotalAssets.ToString("N0")</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-title">Kewajiban &mdash; @Localizer["what the business owes"]</div>
    <table style="width:100%;font-size:14px">
      <tbody>
        <tr>
          <td style="padding:7px 0">
            Utang Usaha <span style="color:#9ca3af;font-size:11px">(@Localizer["incl. PPN"])</span>
            <div style="color:#9ca3af;font-size:11px">
              @(Model.Report.OpenPurchases == 1
                  ? Localizer["{0} open purchase",  Model.Report.OpenPurchases]
                  : Localizer["{0} open purchases", Model.Report.OpenPurchases])
              &middot; <a href="/Purchases/Due" class="no-print">@Localizer["AP Due"] &rarr;</a>
            </div>
          </td>
          <td style="text-align:right;font-weight:600;vertical-align:top">@Model.Report.PayablesGross.ToString("N0")</td>
        </tr>
        @if (Model.Report.DebitNotesApplied > 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#059669;font-size:13px" title="@Localizer["Debit notes applied to specific purchases"]">
              (&minus;) Nota Debit diterapkan
            </td>
            <td style="text-align:right;color:#059669;font-size:13px">@Model.Report.DebitNotesApplied.ToString("N0")</td>
          </tr>
          <tr>
            <td style="padding:5px 0">Utang Bersih</td>
            <td style="text-align:right;font-weight:600">@Model.Report.PayablesNet.ToString("N0")</td>
          </tr>
        }
        @{ var ap = Model.Report.PayablesAging; }
        @if (ap.Total > 0)
        {
          <tr>
            <td colspan="2" style="padding:6px 0 2px 14px">
              <table style="width:100%;font-size:11px;color:#6b7280">
                <tr>
                  <td>@Localizer["Not yet due"]</td>
                  <td style="text-align:right">@ap.NotYetDue.ToString("N0")</td>
                  <td style="width:14px"></td>
                  <td style="color:@(ap.Days1To30  > 0 ? "#b45309" : "#9ca3af")">1&ndash;30</td>
                  <td style="text-align:right;color:@(ap.Days1To30  > 0 ? "#b45309" : "#9ca3af")">@ap.Days1To30.ToString("N0")</td>
                </tr>
                <tr>
                  <td style="color:@(ap.Days31To60 > 0 ? "#c2410c" : "#9ca3af")">31&ndash;60</td>
                  <td style="text-align:right;color:@(ap.Days31To60 > 0 ? "#c2410c" : "#9ca3af")">@ap.Days31To60.ToString("N0")</td>
                  <td></td>
                  <td style="color:@(ap.Days61To90 > 0 ? "#dc2626" : "#9ca3af")">61&ndash;90</td>
                  <td style="text-align:right;color:@(ap.Days61To90 > 0 ? "#dc2626" : "#9ca3af")">@ap.Days61To90.ToString("N0")</td>
                </tr>
                <tr>
                  <td style="color:@(ap.Days90Plus > 0 ? "#991b1b" : "#9ca3af");font-weight:@(ap.Days90Plus > 0 ? "700" : "400")">90+</td>
                  <td style="text-align:right;color:@(ap.Days90Plus > 0 ? "#991b1b" : "#9ca3af");font-weight:@(ap.Days90Plus > 0 ? "700" : "400")">@ap.Days90Plus.ToString("N0")</td>
                  <td></td>
                  @if (ap.NoDueDate > 0)
                  {
                    <td title="@Localizer["Credit with no payment term agreed, so there is no date to be late against"]">@Localizer["No due date"]</td>
                    <td style="text-align:right">@ap.NoDueDate.ToString("N0")</td>
                  }
                  else
                  {
                    <td></td><td></td>
                  }
                </tr>
              </table>
            </td>
          </tr>
        }
        @if (Model.Report.OpenDebitNotes > 0)
        {
          <tr>
            <td colspan="2" style="padding:4px 0 2px 14px;color:#9ca3af;font-size:11px"
                title="@Localizer["Not subtracted above — a note only reduces a balance once it is applied to a specific purchase"]">
              @Localizer["Plus {0} in open debit notes not yet applied to any purchase", Model.Report.OpenDebitNotes.ToString("N0")]
              &middot; <a href="/CreditNotes" class="no-print">@Localizer["Credit & Debit Notes"] &rarr;</a>
            </td>
          </tr>
        }

        <tr>
          <td style="padding:7px 0;border-top:1px solid #f3f4f6">
            Komisi terutang
            <div style="color:#9ca3af;font-size:11px">
              @(Model.Report.CommissionPayableCount == 1
                  ? Localizer["{0} unpaid accrual",  Model.Report.CommissionPayableCount]
                  : Localizer["{0} unpaid accruals", Model.Report.CommissionPayableCount])
              &middot; <a href="/Commissions" class="no-print">@Localizer["Commissions"] &rarr;</a>
            </div>
          </td>
          <td style="text-align:right;font-weight:600;vertical-align:top;border-top:1px solid #f3f4f6">@Model.Report.CommissionPayable.ToString("N0")</td>
        </tr>

        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:700;font-size:15px">Total Kewajiban</td>
          <td style="text-align:right;font-weight:700;font-size:15px;color:#dc2626">@Model.Report.TotalLiabilities.ToString("N0")</td>
        </tr>
        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:800;font-size:16px">Posisi Bersih</td>
          <td style="text-align:right;font-weight:800;font-size:16px;color:@(Model.Report.NetPosition >= 0 ? "#059669" : "#dc2626")">
            @Model.Report.NetPosition.ToString("N0")
          </td>
        </tr>
      </tbody>
    </table>

    <div class="alert alert-warning" style="margin-top:16px;font-size:12px;line-height:1.6">
      <strong>@Localizer["This is not a balance sheet (Neraca)."]</strong>
      @Localizer["It shows the five balances SimpleERP can derive and prove from its own documents. Cash at bank, fixed assets, capital, retained earnings and tax positions are not in this system, so Posisi Bersih is a working-position indicator, not net worth — and it is not expected to balance to zero."]
    </div>
  </div>

</div>

<p style="font-size:11px;color:#9ca3af;margin-top:14px;line-height:1.6">
  @Localizer["A point-in-time position, read live — there is no date filter, and re-opening this page will show different numbers once anything moves. Receivables and payables are tax-inclusive, because they are cash owed rather than turnover. Credit and debit notes net off against the specific invoice or purchase they are applied to; a note not yet applied to anything is listed separately and does not reduce the net figures. Unclaimed rebate is shown gross of the 15% withholding, which is deducted when the claim actually settles."]
</p>
