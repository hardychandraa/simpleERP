@page "/Reports/EndOfDay"
@model SimpleERP.Web.Pages.Reports.EndOfDayModel
@{ ViewData["Title"] = Localizer["End of Day"].Value; }
@* One link per invoice number; on paper it prints as plain text. (There used to be a second
   "print-only" copy, but no such class exists, so the number showed twice on screen.) *@
<style>@@media print { .eod-inv { color: inherit !important; font-weight: normal !important; } }</style>

<div style="display:flex;align-items:flex-end;gap:12px;margin-bottom:18px" class="no-print">
  <form method="get" style="display:flex;gap:10px;align-items:flex-end">
    <div class="fg" style="margin:0">
      <label>@Localizer["Date"]</label>
      <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")"/>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["View"]</button>
  </form>
  <button onclick="window.print()" class="btn btn-outline btn-sm">🖨 @Localizer["Print Report"]</button>
</div>

<div style="text-align:center;margin-bottom:16px">
  <div style="font-size:22px;font-weight:800;color:#1a1a2e">@Localizer["End of Day Report"]</div>
  <div style="color:#6b7280">@Model.SelectedDate.ToString("dddd, dd MMMM yyyy")</div>
</div>

<!-- Summary stats -->
<div class="stats" style="grid-template-columns:repeat(3,1fr)">
  <div class="stat green"><div class="stat-lbl">@Localizer["Total Revenue"]</div><div class="stat-val" style="font-size:18px">@Model.Report.TotalRevenue.ToString("N0")</div></div>
  <div class="stat blue"><div class="stat-lbl">@Localizer["Cash In (Sales + Collections)"]</div><div class="stat-val" style="font-size:18px">@Model.Report.TotalCashIn.ToString("N0")</div></div>
  <div class="stat red"><div class="stat-lbl">@Localizer["All-time Outstanding Due"]</div><div class="stat-val" style="font-size:18px">@Model.Report.OutstandingDueTotal.ToString("N0")</div></div>
</div>
<div class="stats" style="grid-template-columns:repeat(4,1fr)">
  <div class="stat blue"><div class="stat-lbl">@Localizer["Total Sales"]</div><div class="stat-val">@Model.Report.TotalSales</div></div>
  <div class="stat green"><div class="stat-lbl">@Localizer["Cash Sales"]</div><div class="stat-val">@Model.Report.CashSales</div></div>
  <div class="stat orange"><div class="stat-lbl">@Localizer["Due Sales"]</div><div class="stat-val">@Model.Report.DueSales</div></div>
  <div class="stat red"><div class="stat-lbl">@Localizer["Cancelled"]</div><div class="stat-val">@Model.Report.CancelledSales</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <!-- Revenue breakdown -->
  <div class="card">
    <div class="card-title">@Localizer["Revenue Breakdown"]</div>
    <table>
      <tbody>
        <tr><td>@Localizer["Cash sales revenue"]</td><td style="text-align:right;font-weight:600;color:#059669">@Model.Report.CashRevenue.ToString("N0")</td></tr>
        <tr><td>@Localizer["Due sales revenue (invoiced)"]</td><td style="text-align:right;font-weight:600;color:#d97706">@Model.Report.DueRevenue.ToString("N0")</td></tr>
        <tr><td>@Localizer["Payments Collected Today"]</td><td style="text-align:right;font-weight:600;color:#2563eb">@Model.Report.PaymentsCollected.ToString("N0")</td></tr>
        @if (Model.Report.NotesNetted > 0) {
          <tr><td>(−) @Localizer["Settled by credit notes (no cash)"]</td><td style="text-align:right;font-weight:600;color:#dc2626">@Model.Report.NotesNetted.ToString("N0")</td></tr>
        }
        <tr style="border-top:2px solid #e5e7eb;background:#f9fafb">
          <td style="font-weight:700">@Localizer["Total Cash In Hand"]</td>
          <td style="text-align:right;font-weight:700;font-size:15px;color:#059669">@Model.Report.TotalCashIn.ToString("N0")</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Payments collected today -->
  <div class="card">
    <div class="card-title">@Localizer["Payments Collected Today"] (@Model.Report.PaymentsList.Count)</div>
    @if (!Model.Report.PaymentsList.Any()) {
      <p style="color:#9ca3af;font-size:13px">@Localizer["No payments collected today."]</p>
    } else {
      <table>
        <thead><tr><th>@Localizer["Invoice"]</th><th>@Localizer["Customer"]</th><th style="text-align:right">@Localizer["Amount"]</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Report.PaymentsList) {
          <tr>
            <td style="font-size:12px">@p.InvoiceNumber</td>
            <td>@p.CustomerName</td>
            <td style="text-align:right;font-weight:600;color:#059669">@p.Amount.ToString("N0")</td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>
</div>

<!-- Sales list -->
<div class="card">
  <div class="card-title">@Localizer["Sales Today"] (@Model.Report.TotalSales)</div>
  @if (!Model.Report.SalesList.Any()) {
    <p style="color:#9ca3af;font-size:13px">@Localizer["No sales recorded for this date."]</p>
  } else {
    <table>
      <thead><tr><th>@Localizer["Invoice"]</th><th>@Localizer["Customer"]</th><th>@Localizer["Payment"]</th><th style="text-align:right">@Localizer["Total"]</th><th style="text-align:right">@Localizer["Paid"]</th><th style="text-align:right">@Localizer["Balance"]</th></tr></thead>
      <tbody>
      @foreach (var s in Model.Report.SalesList) {
        <tr>
          <td><a href="/Sales/@s.Id" class="eod-inv" style="color:#2563eb;text-decoration:none;font-weight:600">@s.InvoiceNumber</a></td>
          <td>@s.CustomerName</td>
          <td><span class="badge @(s.PaymentType=="Cash"?"ok":"warn")">@Localizer[EnumDisplay.Key("PaymentType", s.PaymentType)]</span></td>
          <td style="text-align:right">@s.GrandTotal.ToString("N0")</td>
          <td style="text-align:right">@((s.AmountPaid + s.AppliedNotesTotal).ToString("N0"))</td>
          <td style="text-align:right">
            @if (s.NetBalanceDue > 0) { <span style="color:#dc2626;font-weight:700">@s.NetBalanceDue.ToString("N0")</span> }
            else { <span style="color:#9ca3af">—</span> }
          </td>
        </tr>
      }
      <tr style="background:#f9fafb;font-weight:700;border-top:2px solid #e5e7eb">
        <td colspan="3">@Localizer["Total"]</td>
        <td style="text-align:right">@Model.Report.TotalRevenue.ToString("N0")</td>
        <td style="text-align:right">@Model.Report.SalesList.Sum(s=>s.AmountPaid + s.AppliedNotesTotal).ToString("N0")</td>
        <td style="text-align:right;color:#dc2626">@Model.Report.SalesList.Sum(s=>s.NetBalanceDue).ToString("N0")</td>
      </tr>
      </tbody>
    </table>
  }
</div>
