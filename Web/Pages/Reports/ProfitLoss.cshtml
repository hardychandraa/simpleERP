@page "/Reports/ProfitLoss"
@model SimpleERP.Web.Pages.Reports.ProfitLossModel
@{ ViewData["Title"] = Localizer["Profit & Loss"].Value; }

@* Localization note: the Indonesian domain terms below (Laba Rugi, Penjualan, HPP, Laba
   Kotor/Usaha/Bersih, Biaya Usaha, Komisi Penjualan, Retur, Pendapatan Rebat, PPN
   Keluaran/Masukan…) are deliberately left as bare literals and never routed through the
   localizer — they are identical in both languages, because they are the terms staff, the
   tax consultant and the printed paperwork already use. Only the English chrome and the
   explanatory prose switch. *@

<div style="display:flex;align-items:flex-end;gap:12px;margin-bottom:18px" class="no-print">
  <form method="get" style="display:flex;gap:10px;align-items:flex-end">
    <div class="fg" style="margin:0">
      <label>@Localizer["From"]</label>
      <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/>
    </div>
    <div class="fg" style="margin:0">
      <label>@Localizer["To"]</label>
      <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/>
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["View"]</button>
  </form>
  <button onclick="window.print()" class="btn btn-outline btn-sm">🖨 @Localizer["Print Report"]</button>
</div>

<div style="text-align:center;margin-bottom:16px">
  @* Bilingual letterhead — see Position.cshtml for the same pattern. *@
  <div style="font-size:22px;font-weight:800;color:#1a1a2e">Laporan Laba Rugi</div>
  <div style="font-size:13px;color:#9ca3af">Profit &amp; Loss Statement</div>
  <div style="color:#6b7280;margin-top:4px">
    @Model.From.ToString("dd MMM yyyy") &ndash; @Model.To.ToString("dd MMM yyyy")
    <span style="color:#9ca3af">&middot;
      @(Model.Report.InvoiceCount == 1
          ? Localizer["{0} invoice",  Model.Report.InvoiceCount]
          : Localizer["{0} invoices", Model.Report.InvoiceCount])
    </span>
  </div>
</div>

<div class="stats" style="grid-template-columns:repeat(3,1fr)">
  <div class="stat blue"><div class="stat-lbl">Penjualan Bersih (@Localizer["excl. PPN"])</div><div class="stat-val" style="font-size:18px">@Model.Report.NetRevenue.ToString("N0")</div></div>
  <div class="stat orange"><div class="stat-lbl">HPP Bersih</div><div class="stat-val" style="font-size:18px">@Model.Report.NetCogs.ToString("N0")</div></div>
  <div class="stat green"><div class="stat-lbl">Laba Kotor</div><div class="stat-val" style="font-size:18px">@Model.Report.GrossProfit.ToString("N0")</div></div>
</div>
<div class="stats" style="grid-template-columns:repeat(3,1fr)">
  <div class="stat red"><div class="stat-lbl">Biaya Usaha + Komisi</div><div class="stat-val" style="font-size:18px">@((Model.Report.OperatingExpenses + Model.Report.CommissionExpense).ToString("N0"))</div></div>
  <div class="stat @(Model.Report.OperatingProfit >= 0 ? "green" : "red")"><div class="stat-lbl">Laba Usaha</div><div class="stat-val" style="font-size:18px">@Model.Report.OperatingProfit.ToString("N0")</div></div>
  <div class="stat @(Model.Report.NetProfit >= 0 ? "green" : "red")"><div class="stat-lbl">Laba Bersih</div><div class="stat-val" style="font-size:18px">@Model.Report.NetProfit.ToString("N0")</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

  <div class="card">
    <div class="card-title">Laba Rugi</div>
    <table style="width:100%;font-size:14px">
      <tbody>
        <tr>
          <td style="padding:7px 0">Penjualan <span style="color:#9ca3af;font-size:11px">(@Localizer["excl. PPN"])</span></td>
          <td style="text-align:right;font-weight:600">@Model.Report.Revenue.ToString("N0")</td>
        </tr>
        @if (Model.Report.SalesReturnCount > 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#dc2626;font-size:13px">
              (&minus;) Retur Penjualan
              <span style="color:#d1d5db;font-size:11px">×@Model.Report.SalesReturnCount</span>
            </td>
            <td style="text-align:right;color:#dc2626;font-size:13px">@Model.Report.SalesReturns.ToString("N0")</td>
          </tr>
          <tr>
            <td style="padding:5px 0;border-top:1px solid #f3f4f6">Penjualan Bersih</td>
            <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6">@Model.Report.NetRevenue.ToString("N0")</td>
          </tr>
        }
        <tr>
          <td style="padding:7px 0;color:#dc2626">(&minus;) Harga Pokok Penjualan</td>
          <td style="text-align:right;font-weight:600;color:#dc2626">@Model.Report.Cogs.ToString("N0")</td>
        </tr>
        @if (Model.Report.SalesReturnCogs != 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#059669;font-size:13px" title="@Localizer["Cost of returned goods put back into stock, at the same cost the sale expensed"]">
              (+) HPP atas Retur <span style="color:#9ca3af;font-size:11px">(dikembalikan ke stok)</span>
            </td>
            <td style="text-align:right;color:#059669;font-size:13px">@Model.Report.SalesReturnCogs.ToString("N0")</td>
          </tr>
          <tr>
            <td style="padding:5px 0;border-top:1px solid #f3f4f6;color:#dc2626">HPP Bersih</td>
            <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6;color:#dc2626">@Model.Report.NetCogs.ToString("N0")</td>
          </tr>
        }
        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:700;font-size:15px">Laba Kotor</td>
          <td style="text-align:right;font-weight:700;font-size:15px;color:#059669">@Model.Report.GrossProfit.ToString("N0")</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#6b7280;font-size:12px">@Localizer["Margin"]</td>
          <td style="text-align:right;color:#6b7280;font-size:12px">@Model.Report.GrossMarginPct.ToString("N2")%</td>
        </tr>

        <tr>
          <td colspan="2" style="padding:14px 0 4px;font-weight:700;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6">
            Biaya Usaha
          </td>
        </tr>
        @if (Model.Report.ExpenseLines.Count == 0)
        {
          <tr>
            <td colspan="2" style="padding:4px 0;color:#9ca3af;font-size:12px">
              @Localizer["No expenses recorded in this period."]
            </td>
          </tr>
        }
        else
        {
          @foreach (var line in Model.Report.ExpenseLines)
          {
            <tr>
              <td style="padding:4px 0 4px 14px;color:#6b7280;font-size:13px">
                @line.CategoryName
                <span style="color:#d1d5db;font-size:11px">×@line.EntryCount</span>
                @if (!line.IsTaxDeductible)
                {
                  <span style="color:#d97706;font-size:10px;font-weight:600" title="@Localizer["Added back as a fiscal correction"]">@Localizer["non-ded."]</span>
                }
              </td>
              <td style="text-align:right;color:#dc2626;font-size:13px">@line.Amount.ToString("N0")</td>
            </tr>
          }
        }
        <tr>
          <td style="padding:7px 0;color:#dc2626;border-top:1px solid #f3f4f6">(&minus;) Total Biaya Usaha</td>
          <td style="text-align:right;font-weight:600;color:#dc2626;border-top:1px solid #f3f4f6">@Model.Report.OperatingExpenses.ToString("N0")</td>
        </tr>
        <tr>
          <td style="padding:7px 0;color:#dc2626" title="@Localizer["Commission accrued in this period. Earned on collection, so it follows the payment date, not the invoice date."]">
            (&minus;) Komisi Penjualan
            @if (Model.Report.CommissionAccrualCount > 0)
            {
              <span style="color:#d1d5db;font-size:11px">×@Model.Report.CommissionAccrualCount</span>
            }
          </td>
          <td style="text-align:right;font-weight:600;color:#dc2626">@Model.Report.CommissionExpense.ToString("N0")</td>
        </tr>
        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:700;font-size:15px">Laba Usaha</td>
          <td style="text-align:right;font-weight:700;font-size:15px;color:@(Model.Report.OperatingProfit >= 0 ? "#059669" : "#dc2626")">
            @Model.Report.OperatingProfit.ToString("N0")
          </td>
        </tr>
        @if (Model.Report.NonDeductibleExpenses > 0)
        {
          <tr>
            <td style="padding:4px 0;color:#d97706;font-size:11px">
              @Localizer["of which non-deductible (fiscal add-back)"]
            </td>
            <td style="text-align:right;color:#d97706;font-size:11px">@Model.Report.NonDeductibleExpenses.ToString("N0")</td>
          </tr>
        }

        <tr>
          <td colspan="2" style="padding:14px 0 4px;font-weight:700;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6">
            Pendapatan / Beban Luar Usaha
          </td>
        </tr>
        <tr>
          <td style="padding:5px 0 5px 14px;color:#6b7280;font-size:13px" title="@Localizer["Rebate earned from suppliers, gross of the 15% withholding"]">
            (+) Pendapatan Rebat
            @if (Model.Report.RebateAccrualCount > 0)
            {
              <span style="color:#d1d5db;font-size:11px">×@Model.Report.RebateAccrualCount</span>
            }
          </td>
          <td style="text-align:right;color:#059669;font-size:13px">@Model.Report.RebateIncome.ToString("N0")</td>
        </tr>
        @if (Model.Report.RebateLuckyDrawRealized != 0)
        {
          <tr>
            <td style="padding:2px 0 2px 28px;color:#9ca3af;font-size:11px">
              @Localizer["of which Lucky Draw, recognised on settlement"]
            </td>
            <td style="text-align:right;color:#9ca3af;font-size:11px">@Model.Report.RebateLuckyDrawRealized.ToString("N0")</td>
          </tr>
        }
        @if (Model.Report.RebateInKindCount > 0)
        {
          <tr>
            <td colspan="2" style="padding:2px 0 2px 28px;color:#9ca3af;font-size:11px">
              @(Model.Report.RebateInKindCount == 1
                  ? Localizer["{0} in-kind reward received — booked as stock, not income, so the benefit shows up in margin when sold",  Model.Report.RebateInKindCount]
                  : Localizer["{0} in-kind rewards received — booked as stock, not income, so the benefit shows up in margin when sold", Model.Report.RebateInKindCount])
            </td>
          </tr>
        }
        @if (Model.Report.PurchaseReturnCount > 0)
        {
          <tr>
            <td style="padding:5px 0 5px 14px;color:#6b7280;font-size:13px"
                title="@Localizer["What the supplier credited back ({0}) less the inventory value the goods left at ({1})", Model.Report.PurchaseReturnCredit.ToString("N0"), Model.Report.PurchaseReturnStockValue.ToString("N0")]">
              (&plusmn;) Selisih Retur Pembelian
              <span style="color:#d1d5db;font-size:11px">×@Model.Report.PurchaseReturnCount</span>
            </td>
            <td style="text-align:right;font-size:13px;color:@(Model.Report.PurchaseReturnVariance >= 0 ? "#059669" : "#dc2626")">
              @Model.Report.PurchaseReturnVariance.ToString("N0")
            </td>
          </tr>
        }
        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:800;font-size:16px">Laba Bersih</td>
          <td style="text-align:right;font-weight:800;font-size:16px;color:@(Model.Report.NetProfit >= 0 ? "#059669" : "#dc2626")">
            @Model.Report.NetProfit.ToString("N0")
          </td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#6b7280;font-size:12px">Margin bersih</td>
          <td style="text-align:right;color:#6b7280;font-size:12px">@Model.Report.NetMarginPct.ToString("N2")%</td>
        </tr>
      </tbody>
    </table>

    @if (!Model.Report.IsComplete)
    {
      <div class="alert alert-warning" style="margin-top:16px;font-size:12px;line-height:1.6">
        <strong>@Localizer["This is not yet a complete P&L."]</strong>
        @Localizer["The sections below have no data source in the system yet, so they are named rather than silently omitted:"]
        <ul style="margin:8px 0 0 18px;padding:0">
          @foreach (var s in Model.Report.PendingSections)
          {
            <li style="margin-bottom:3px">@s</li>
          }
        </ul>
      </div>
    }
  </div>

  <div class="card">
    <div class="card-title">PPN &amp; @Localizer["Reconciliation"]</div>
    <table style="width:100%;font-size:14px">
      <tbody>
        <tr>
          <td style="padding:7px 0">PPN Keluaran @Localizer["collected"]</td>
          <td style="text-align:right;font-weight:600">@Model.Report.TaxCollected.ToString("N0")</td>
        </tr>
        @if (Model.Report.TaxOnSalesReturns != 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#6b7280;font-size:13px">(&minus;) @Localizer["reversed by sales returns"]</td>
            <td style="text-align:right;color:#dc2626;font-size:13px">@Model.Report.TaxOnSalesReturns.ToString("N0")</td>
          </tr>
        }
        <tr>
          <td style="padding:7px 0;border-top:1px solid #f3f4f6">PPN Masukan @Localizer["paid"] <span style="color:#9ca3af;font-size:11px">(@Localizer["reclaimable"])</span></td>
          <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6">@Model.Report.TaxPaid.ToString("N0")</td>
        </tr>
        @if (Model.Report.TaxOnPurchaseReturns != 0)
        {
          <tr>
            <td style="padding:4px 0 4px 14px;color:#6b7280;font-size:13px">(&minus;) @Localizer["reversed by purchase returns"]</td>
            <td style="text-align:right;color:#dc2626;font-size:13px">@Model.Report.TaxOnPurchaseReturns.ToString("N0")</td>
          </tr>
        }
        <tr style="border-top:2px solid #1a1a2e">
          <td style="padding:9px 0;font-weight:700">
            @(Model.Report.NetVatPosition >= 0 ? "PPN owed (Kurang Bayar)" : "PPN credit (Lebih Bayar)")
          </td>
          <td style="text-align:right;font-weight:700;color:@(Model.Report.NetVatPosition >= 0 ? "#dc2626" : "#059669")">
            @Math.Abs(Model.Report.NetVatPosition).ToString("N0")
          </td>
        </tr>
        <tr>
          <td style="padding:7px 0;border-top:1px solid #f3f4f6">@Localizer["Total invoiced"] <span style="color:#9ca3af;font-size:11px">(@Localizer["incl. PPN"])</span></td>
          <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6">@Model.Report.GrossSales.ToString("N0")</td>
        </tr>
      </tbody>
    </table>
    <p style="font-size:11px;color:#6b7280;margin-top:14px;line-height:1.6">
      @Localizer["PPN is shown as a memo, not as income. It is collected on the government's behalf and owed onward, so including it in Penjualan would overstate turnover. Total invoiced is the tax-inclusive figure — use that one when tying this report back to cash received and outstanding receivables."]
    </p>
    <p style="font-size:11px;color:#9ca3af;margin-top:10px;line-height:1.6">
      @Localizer["The net PPN figure is indicative only: it is this period's output tax less this period's input tax, and does not model credits carried forward from earlier months. Your SPT Masa filing remains the consultant's work — this gives them the inputs."]
    </p>
  </div>

</div>

<p style="font-size:11px;color:#9ca3af;margin-top:14px;line-height:1.6">
  @Localizer["Commercial basis, matching the SPT column of the annual statement. Fiscal corrections and PPh Badan remain your tax consultant's work — this report supplies the inputs. Cancelled invoices, purchases and returns are excluded; HPP uses each line's cost as captured at the moment of sale, so later cost changes cannot restate historical margin. Rebate is recognised when it is earned and komisi when it is collected on, so both follow their own timing rather than the invoice date — a period's commission will not tie exactly to that period's Penjualan, by design."]
</p>
