@page "/Commissions"
@model SimpleERP.Web.Pages.Commissions.IndexModel
@{ ViewData["Title"] = "Commissions"; }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="card" style="margin-bottom:14px">
    <div style="display:flex;align-items:center;justify-content:space-between">
        <div class="card-title" style="margin:0">🧾 Commission Payouts</div>
        <a href="/CommissionRules" class="btn btn-outline btn-sm">⚙ Manage Rules</a>
    </div>
    <p style="font-size:12px;color:#6b7280;margin-top:10px;line-height:1.6">
        Commission accrues automatically as sales are collected. Pay a salesperson out
        here — one payout settles all their unpaid accruals.
    </p>
</div>

<div class="card">
    <div class="card-title">Unpaid Commission</div>
    @if (Model.Unpaid.Count == 0)
    {
        <p style="color:#9ca3af;font-size:13px">No unpaid commission.</p>
    }
    else
    {
        <table style="width:100%">
            <thead>
                <tr>
                    <th>Sales Person</th>
                    <th style="text-align:center">Accruals</th>
                    <th style="text-align:right">Amount Owed</th>
                    <th style="width:300px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Unpaid)
            {
                <tr>
                    <td style="font-weight:600">@u.SalesPersonName</td>
                    <td style="text-align:center">@u.AccrualCount</td>
                    <td style="text-align:right;font-weight:600;color:#059669">@u.Amount.ToString("N0")</td>
                    <td>
                        <form method="post" asp-page-handler="Payout"
                              style="display:flex;gap:6px;align-items:center;flex-wrap:wrap"
                              onsubmit="return confirm('Pay out @u.Amount.ToString("N0") to @u.SalesPersonName?');">
                            <input type="hidden" name="input.SalesPersonId" value="@u.SalesPersonId" />
                            <input type="text" name="input.Notes" placeholder="Notes (optional)" style="width:150px" maxlength="500" />
                            <button type="submit" class="btn btn-success btn-sm">Pay Out</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <div class="card-title">Payout History (@Model.History.Count)</div>
    @if (Model.History.Count == 0)
    {
        <p style="color:#9ca3af;font-size:13px">No payouts recorded yet.</p>
    }
    else
    {
        <table style="width:100%">
            <thead>
                <tr>
                    <th>Date</th><th>Sales Person</th>
                    <th style="text-align:center">Accruals</th>
                    <th style="text-align:right">Amount</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var h in Model.History)
            {
                <tr>
                    <td style="font-size:12px">@h.PayoutDate.ToLocalTime().ToString("dd-MMM-yy")</td>
                    <td>@h.SalesPersonName</td>
                    <td style="text-align:center">@h.AccrualCount</td>
                    <td style="text-align:right;font-weight:600;color:#059669">@h.Amount.ToString("N0")</td>
                    <td style="font-size:12px;color:#9ca3af">@(h.Notes ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
