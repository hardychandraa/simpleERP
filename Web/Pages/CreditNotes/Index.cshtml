@page "/CreditNotes"
@model SimpleERP.Web.Pages.CreditNotes.IndexModel
@using SimpleERP.Domain.Enums
@{
    ViewData["Title"] = Localizer["Credit & Debit Notes"].Value;
    // Staff see customer credit notes only; debit notes are supplier-side (HC, 2026-10-08).
    var supplierSide = User.SeesSupplierSide();
}

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="stats" style="grid-template-columns:repeat(@(supplierSide ? 2 : 1),1fr)">
    <div class="stat orange">
        <div class="stat-lbl">@Localizer["Open credit — owed to customers"]</div>
        <div class="stat-val">@Model.OpenCredit.ToString("N0")</div>
        <div style="font-size:11px;color:#9ca3af;margin-top:2px">@Localizer["Not yet applied to any invoice"]</div>
    </div>
    @if (supplierSide)
    {
    <div class="stat teal">
        <div class="stat-lbl">@Localizer["Open debit — owed by suppliers"]</div>
        <div class="stat-val">@Model.OpenDebit.ToString("N0")</div>
        <div style="font-size:11px;color:#9ca3af;margin-top:2px">@Localizer["Not yet applied to any purchase"]</div>
    </div>
    }
</div>

<!-- ── Raise a standalone note ───────────────────────────────────────────────── -->
<div class="card">
    <div class="card-title">＋ @Localizer["Raise a Note"]</div>
    <p style="font-size:12px;color:#6b7280;margin-bottom:12px;line-height:1.6">
        @Localizer["For adjustments with no goods behind them — a price dispute, a billing error, a rebate credited against the payable. A note for returned goods is raised automatically by the"]
        <a href="/Returns">@Localizer["Return"]</a>
        @Localizer["itself, so it reverses the stock at the same time."]
    </p>
    <form method="post" asp-page-handler="Create">
        <div class="frow frow3">
            <div class="fg">
                <label>@Localizer["Direction"]</label>
                <select asp-for="NewNote.Type" id="note-type">
                    <option value="@((int)CreditDebitType.Credit)">@Localizer["Credit note — we owe a customer"]</option>
                    @if (supplierSide) { <option value="@((int)CreditDebitType.Debit)">@Localizer["Debit note — a supplier owes us"]</option> }
                </select>
            </div>
            <div class="fg" id="fg-customer">
                <label>@Localizer["Customer"]</label>
                <select data-searchable asp-for="NewNote.CustomerId">
                    <option value="">— @Localizer["Select"] —</option>
                    @foreach (var c in Model.CustomerOptions)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            @if (supplierSide)
            {
            <div class="fg" id="fg-supplier" style="display:none">
                <label>@Localizer["Supplier"]</label>
                <select data-searchable asp-for="NewNote.SupplierId">
                    <option value="">— @Localizer["Select"] —</option>
                    @foreach (var s in Model.SupplierOptions)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            }
        </div>
        <div class="frow frow3">
            <div class="fg">
                <label>@Localizer["Category"]</label>
                @* Still-typed enums here, so the generic EnumDisplay.Key overload applies. *@
                <select asp-for="NewNote.Category">
                    <option value="@((int)CreditNoteCategory.PriceDispute)">@Localizer[EnumDisplay.Key(CreditNoteCategory.PriceDispute)]</option>
                    <option value="@((int)CreditNoteCategory.BillingError)">@Localizer[EnumDisplay.Key(CreditNoteCategory.BillingError)]</option>
                    @if (supplierSide) { <option value="@((int)CreditNoteCategory.RebateSettlement)">@Localizer[EnumDisplay.Key(CreditNoteCategory.RebateSettlement)]</option> }
                    <option value="@((int)CreditNoteCategory.Return)">@Localizer[EnumDisplay.Key(CreditNoteCategory.Return)]</option>
                    <option value="@((int)CreditNoteCategory.Other)">@Localizer[EnumDisplay.Key(CreditNoteCategory.Other)]</option>
                </select>
            </div>
            <div class="fg">
                <label>@Localizer["Note date"]</label>
                <input type="date" asp-for="NewNote.NoteDate" required />
            </div>
            <div class="fg">
                <label>@Localizer["Amount"]</label>
                <input type="number" asp-for="NewNote.Amount" min="0.01" step="0.01" required placeholder="0" />
                <label style="margin-top:6px;text-transform:none;font-weight:400;font-size:12px;display:flex;gap:6px;align-items:center">
                    <input type="checkbox" asp-for="NewNote.IsTaxInclusive" style="width:auto" />
                    @* PPN stays bare — identical in both languages. *@
                    @Localizer["Amount already includes"] PPN
                </label>
            </div>
        </div>
        <div class="frow frow2">
            <div class="fg">
                <label>@Localizer["Reason"] <span style="color:#dc2626">*</span></label>
                <input type="text" asp-for="NewNote.Reason" maxlength="500" required
                       placeholder="@Localizer["e.g. Agreed price correction on Jan delivery"]" />
            </div>
            <div class="fg">
                <label>@Localizer["Notes (optional)"]</label>
                <input type="text" asp-for="NewNote.Notes" maxlength="500" />
            </div>
        </div>
        <button type="submit" class="btn btn-success">✓ @Localizer["Raise Note"]</button>
    </form>
</div>

<!-- ── Register ──────────────────────────────────────────────────────────────── -->
<div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
        <div class="card-title" style="margin:0">@Localizer["Register"] (@Model.Notes.Count)</div>
        <form method="get" style="display:flex;gap:8px;align-items:center">
            @if (supplierSide)
            {
            <select name="type" style="width:auto">
                <option value="">@Localizer["All directions"]</option>
                <option value="@((int)CreditDebitType.Credit)" selected="@(Model.FilterType == CreditDebitType.Credit)">@Localizer["Credit only"]</option>
                <option value="@((int)CreditDebitType.Debit)"  selected="@(Model.FilterType == CreditDebitType.Debit)">@Localizer["Debit only"]</option>
            </select>
            }
            <select name="status" style="width:auto">
                <option value="">@Localizer["All statuses"]</option>
                <option value="@((int)CreditNoteStatus.Open)"      selected="@(Model.FilterStatus == CreditNoteStatus.Open)">@Localizer[EnumDisplay.Key(CreditNoteStatus.Open)]</option>
                <option value="@((int)CreditNoteStatus.Settled)"   selected="@(Model.FilterStatus == CreditNoteStatus.Settled)">@Localizer[EnumDisplay.Key(CreditNoteStatus.Settled)]</option>
                <option value="@((int)CreditNoteStatus.Cancelled)" selected="@(Model.FilterStatus == CreditNoteStatus.Cancelled)">@Localizer[EnumDisplay.Key(CreditNoteStatus.Cancelled)]</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Filter"]</button>
            <a href="/CreditNotes" class="btn btn-outline btn-sm">@Localizer["Reset"]</a>
        </form>
    </div>

    @if (Model.Notes.Count == 0)
    {
        <p style="color:#9ca3af;font-size:13px;margin-top:12px">@Localizer["No notes match."]</p>
    }
    else
    {
        <table style="margin-top:12px">
            <thead>
                <tr>
                    <th>@Localizer["Number"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Direction"]</th>
                    <th>@Localizer["Counterparty"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["Source"]</th>
                    <th>@Localizer["Reason"]</th>
                    <th style="text-align:right">@Localizer["Amount"]</th>
                    <th style="text-align:center">@Localizer["Status"]</th>
                    <th style="width:260px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var n in Model.Notes)
            {
                <tr>
                    <td><strong>@n.DocumentNumber</strong></td>
                    <td>@n.NoteDate.ToLocalTime().ToString("dd-MMM-yy")</td>
                    <td>
                        <span class="badge @(n.IsCredit ? "warn" : "info")">
                            @Localizer[EnumDisplay.Key(n.IsCredit ? CreditDebitType.Credit : CreditDebitType.Debit)]
                        </span>
                    </td>
                    <td>@n.CounterpartyName</td>
                    <td style="font-size:12px">@Localizer[EnumDisplay.Key("CreditNoteCategory", n.Category)]</td>
                    <td style="font-size:12px">
                        @if (n.SourceCustomerReturnId.HasValue)
                        {
                            <a href="/Returns/Customer/@n.SourceCustomerReturnId" style="color:#2563eb">@n.SourceDocument</a>
                        }
                        else if (n.SourceSupplierReturnId.HasValue)
                        {
                            <a href="/Returns/Supplier/@n.SourceSupplierReturnId" style="color:#2563eb">@n.SourceDocument</a>
                        }
                        else if (n.SourceSaleId.HasValue)
                        {
                            <a href="/Sales/@n.SourceSaleId" style="color:#2563eb">@n.SourceDocument</a>
                        }
                        else if (n.SourcePurchaseId.HasValue)
                        {
                            <a href="/Purchases/@n.SourcePurchaseId" style="color:#2563eb">@n.SourceDocument</a>
                        }
                        else
                        {
                            <span style="color:#9ca3af">@Localizer["standalone"]</span>
                        }
                    </td>
                    <td style="font-size:12px;color:#6b7280">@n.Reason</td>
                    <td style="text-align:right;font-weight:600">
                        @n.Amount.ToString("N0")
                        @if (n.TaxAmount > 0)
                        {
                            <br /><small style="color:#9ca3af;font-weight:400">@Localizer["incl. PPN"] @n.TaxAmount.ToString("N0")</small>
                        }
                        @if (n.IsPartiallyApplied)
                        {
                            <br /><small style="color:#b45309;font-weight:600">@Localizer["{0} left", n.RemainingAmount.ToString("N0")]</small>
                        }
                    </td>
                    <td style="text-align:center">
                        <span class="badge @(n.Status == "Open" ? "warn" : n.Status == "Settled" ? "ok" : "gray")">@Localizer[EnumDisplay.Key("CreditNoteStatus", n.Status)]</span>
                        @if (n.SettledDate.HasValue)
                        {
                            <div style="font-size:10px;color:#9ca3af;margin-top:2px">@n.SettledDate.Value.ToLocalTime().ToString("dd-MMM-yy")</div>
                        }
                    </td>
                    <td>
                        @if (n.IsOpen)
                        {
                            @* Apply against a named document — the reason this page can now
                               answer "which invoice did this note cover?". Only offered when
                               the counterparty actually has something open to apply against. *@
                            @if (n.OpenDocuments.Count > 0)
                            {
                                <form method="post" asp-page-handler="Apply" style="display:flex;gap:4px;align-items:center;flex-wrap:wrap">
                                    <input type="hidden" name="Apply.CreditNoteId" value="@n.Id" />
                                    <select data-searchable name="@(n.IsCredit ? "Apply.SaleId" : "Apply.PurchaseId")" style="width:150px;font-size:11px">
                                        @foreach (var d in n.OpenDocuments)
                                        {
                                            <option value="@d.DocumentId" data-balance="@d.NetBalanceDue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">@d.DocumentNumber (@d.NetBalanceDue.ToString("N0"))</option>
                                        }
                                    </select>
                                    <input type="number" name="Apply.Amount" step="0.01" min="0.01"
                                           max="@n.RemainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           value="@n.RemainingAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           style="width:90px;font-size:11px" />
                                    @* The smaller of what is left on the note and what the chosen document still owes. *@
                                    <button type="button" class="btn btn-outline btn-sm" onclick="fillApply(this)">@Localizer["Full amount"]</button>
                                    <button type="submit" class="btn btn-primary btn-sm">@Localizer["Apply"]</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Settle" style="display:flex;gap:5px;align-items:center;margin-top:4px">
                                <input type="hidden" name="Settle.Id" value="@n.Id" />
                                <input type="text" name="Settle.SettlementNotes" maxlength="500"
                                       placeholder="@Localizer["Refunded / written off"]" style="width:130px" />
                                <button type="submit" class="btn btn-success btn-sm">@Localizer["Settle"]</button>
                            </form>
                            @if (!n.SourceCustomerReturnId.HasValue && !n.SourceSupplierReturnId.HasValue)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@n.Id"
                                      style="margin-top:4px"
                                      onsubmit="return confirm('@Localizer["Cancel this note?"]')">
                                    <button type="submit" class="btn btn-outline btn-sm">@Localizer["Cancel note"]</button>
                                </form>
                            }
                        }
                        else if (!string.IsNullOrEmpty(n.SettlementNotes))
                        {
                            <span style="font-size:11px;color:#6b7280">@n.SettlementNotes</span>
                        }

                        @* Where the note actually went. Reversed rows stay visible, struck
                           through — the correction is part of the record. *@
                        @if (n.Applications.Count > 0)
                        {
                            <div style="margin-top:6px;font-size:11px;line-height:1.7">
                                @foreach (var a in n.Applications)
                                {
                                    <div style="@(a.IsReversed ? "color:#9ca3af;text-decoration:line-through" : "color:#6b7280")">
                                        @Localizer["Applied to"]
                                        <a href="@(a.SaleId.HasValue ? $"/Sales/{a.SaleId}" : $"/Purchases/{a.PurchaseId}")"
                                           style="color:@(a.IsReversed ? "#9ca3af" : "#2563eb")">@a.DocumentNumber</a>
                                        <strong>@a.Amount.ToString("N0")</strong>
                                        <span style="color:#9ca3af">@a.ApplicationDate.ToLocalTime().ToString("dd-MMM-yy")</span>
                                        @if (a.CanReverse)
                                        {
                                            <form method="post" asp-page-handler="ReverseApplication" asp-route-applicationId="@a.Id"
                                                  style="display:inline"
                                                  onsubmit="return confirm('@Localizer["Reverse this application?"]')">
                                                <button type="submit" class="btn btn-outline btn-sm" style="padding:1px 6px;font-size:10px">@Localizer["Reverse"]</button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <p style="font-size:11px;color:#9ca3af;margin-top:10px">
            @Localizer["A note raised by a return can only be voided by cancelling that return, which reverses the goods movement at the same time."]
        </p>
    }
</div>

@section Scripts {
<script>
// A credit note needs a customer, a debit note needs a supplier — show only the one
// the chosen direction will actually accept.
const typeSel = document.getElementById('note-type');
function syncCounterparty() {
    const isCredit = typeSel.value === '@((int)CreditDebitType.Credit)';
    document.getElementById('fg-customer').style.display = isCredit ? '' : 'none';
    const sup = document.getElementById('fg-supplier');   // Admin only
    if (sup) sup.style.display = isCredit ? 'none' : '';
}
typeSel.addEventListener('change', syncCounterparty);
syncCounterparty();

// "Full amount" on Apply: the smaller of the note's remainder (the input's max) and what the
// chosen document still owes.
function fillApply(btn) {
    const f = btn.form, amt = f.querySelector('input[name="Apply.Amount"]');
    const opt = f.querySelector('select').selectedOptions[0];
    const bal = parseFloat(opt?.dataset.balance), rem = parseFloat(amt.max);
    amt.value = isNaN(bal) ? rem : Math.min(bal, rem);
}
</script>
}
