@page
@model SimpleERP.Web.Pages.Sales.IndexModel
@{ ViewData["Title"] = Localizer["Sales History"].Value; }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="card" style="margin-bottom:14px">
    <form method="get" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap">
        <div class="fg" style="margin:0;flex:1;min-width:140px">
            <label>@Localizer["From"]</label>
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1;min-width:140px">
            <label>@Localizer["To"]</label>
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="fg" style="margin:0;flex:1;min-width:180px">
            <label>@Localizer["Search"]</label>
            <input type="text" name="search" value="@Model.Search" placeholder="@Localizer["Invoice, customer, or phone..."]" />
        </div>
        <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
        <a href="/Sales" class="btn btn-outline">@Localizer["Reset"]</a>
        <a href="/Sales/Create" class="btn btn-success" style="margin-left:auto">＋ @Localizer["New Sale"]</a>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>@Localizer["Invoice"]</th>
                <th>@Localizer["Date"]</th>
                <th>@Localizer["Customer"]</th>
                <th>@Localizer["Payment"]</th>
                <th>@Localizer["Total"]</th>
                <th>@Localizer["Paid"]</th>
                <th>@Localizer["Balance"]</th>
                <th>@Localizer["Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Sales)
            {
                <tr>
                    <td><strong>@s.InvoiceNumber</strong></td>
                    <td>@s.SaleDate.ToLocalTime().ToString("dd-MMM-yy HH:mm")</td>
                    <td>
                        @s.CustomerName
                        @if (!string.IsNullOrEmpty(s.SalesPersonName)) {
                            <div style="font-size:11px;color:#9ca3af">👤 @s.SalesPersonName</div>
                        }
                    </td>
                    <td><span class="badge @(s.PaymentType == "Cash" ? "ok" : "warn")">
                        @Localizer[EnumDisplay.Key("PaymentType", s.PaymentType)]
                    </span>
                    @if (!string.IsNullOrEmpty(s.PaymentTermName)) {
                        <div style="font-size:11px;color:#6b7280">@s.PaymentTermName</div>
                    }
                    @if (s.DueDate.HasValue && s.NetBalanceDue > 0) {
                        var od = s.IsOverdue;
                        <div style="font-size:11px;color:@(od?"#dc2626":"#d97706");font-weight:600">
                            @(od ? $"⚠ {Localizer["OVERDUE"].Value}" : "") @s.DueDate.Value.ToString("dd-MMM-yy")
                        </div>
                    }
                    </td>
                    <td>@s.GrandTotal.ToString("N0")</td>
                    @* Paid includes applied credit notes and Balance is net of them, so an
                       invoice settled by a note no longer shows as owing (2026-10-05). *@
                    <td>@((s.AmountPaid + s.AppliedNotesTotal).ToString("N0"))</td>
                    <td>
                        @if (s.NetBalanceDue > 0)
                        {
                            <span style="color:#dc2626;font-weight:700">@s.NetBalanceDue.ToString("N0")</span>
                        }
                        else
                        {
                            <span style="color:#9ca3af">—</span>
                        }
                    </td>
                    <td><span class="badge @(s.Status == "Active" ? "ok" : "err")">@Localizer[EnumDisplay.Key("SaleStatus", s.Status)]</span></td>
                    <td><a href="/Sales/@s.Id" class="btn btn-outline btn-sm">@Localizer["View"]</a></td>
                </tr>
            }
            @if (!Model.Sales.Any())
            {
                <tr>
                    <td colspan="9" style="text-align:center;color:#9ca3af;padding:30px">
                        @Localizer["No sales found."] <a href="/Sales/Create">@Localizer["Create one"] &rarr;</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
