@page
@model SimpleERP.Web.Pages.Sales.CreateModel
@using System.Text.Json
@{ ViewData["Title"] = Localizer["New Sale"].Value; }

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" id="saleForm">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px">

        <!-- Left: header fields -->
        <div class="card" style="margin-bottom:0">
            <div class="card-title">@Localizer["Sale Info"]</div>
            <div class="fg">
                <label>@Localizer["Customer"] *</label>
                <select asp-for="CustomerId" asp-items="Model.CustomerOptions" required>
                    <option value="">— @Localizer["Select customer"] —</option>
                </select>
            </div>
            <div class="fg">
                <label>@Localizer["Sale Date"] *</label>
                <input type="date" asp-for="SaleDate" id="saleDateInput" required
                       max="@DateTime.Now.Date.ToString("yyyy-MM-dd")"
                       value="@((Model.SaleDate ?? DateTime.Now.Date).ToString("yyyy-MM-dd"))"
                       onchange="updateDueDatePreview()" />
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    @Localizer["Defaults to today. Backdate it to enter a sale that was written up earlier — a future date isn't accepted."]
                </div>
            </div>
            <div class="fg">
                <label>@Localizer["Sales Person"]</label>
                <select asp-for="SalesPersonId">
                    <option value="">— @Localizer["none (unattributed)"] —</option>
                    @foreach (var p in Model.SalesPersonOptions)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    @Localizer["Optional. Manage under"] <a href="/SalesPersons">@Localizer["Sales People"]</a>.
                </div>
            </div>
            <div class="fg">
                <label>@Localizer["Payment Type"]</label>
                <select asp-for="PaymentType" id="paymentTypeSelect" onchange="onPaymentTypeChange()">
                    <option value="1">@Localizer["Cash — paid now"]</option>
                    <option value="2">@Localizer["Credit — pay later"]</option>
                </select>
            </div>
            <div class="fg" id="paymentTermRow" style="display:none">
                <label>@Localizer["Credit Term"]</label>
                <select asp-for="PaymentTermId" id="paymentTermSelect" onchange="updateDueDatePreview()">
                    <option value="">— @Localizer["open credit (no fixed due date)"] —</option>
                    @foreach (var t in Model.TermOptions)
                    {
                        <option value="@t.Id" data-days="@t.DueDays">
                            @t.Name (@(t.DueDays == 0
                                ? Localizer["same day"]
                                : t.DueDays == 1 ? Localizer["{0} day", t.DueDays] : Localizer["{0} days", t.DueDays]))
                        </option>
                    }
                </select>
                <div style="font-size:11px;color:#9ca3af;margin-top:4px">
                    @Localizer["Manage these under"] <a href="/PaymentTerms">@Localizer["Payment Terms"]</a>.
                </div>
            </div>
            <div id="dueDatePreview" style="display:none;margin-top:6px">
                <span style="font-size:13px;color:#6b7280">@Localizer["Estimated due date:"] </span>
                <span id="dueDateText" style="font-weight:600;color:#d97706"></span>
            </div>
            <div class="fg" style="margin-top:10px;display:flex;align-items:center;gap:10px">
                <input type="checkbox" asp-for="IsTaxInclusive" id="taxInclusiveCheck"
                       style="width:18px;height:18px;margin:0" onchange="render()" />
                <label for="taxInclusiveCheck" style="margin:0;white-space:nowrap">
                    @* PPN stays bare — identical in both languages. *@
                    @Localizer["Prices already include"] PPN
                </label>
            </div>
            <div style="font-size:11px;color:#9ca3af;margin:-4px 0 10px 28px">
                @Localizer["Unticked: PPN is added on top of the prices entered. Ticked: the prices entered already contain PPN, and it's extracted from them."]
            </div>
            <div class="fg" style="margin-top:10px">
                <label>@Localizer["Sale Notes"]</label>
                <input type="text" asp-for="Notes" maxlength="500" placeholder="@Localizer["Optional remarks..."]" />
            </div>
        </div>

        <!-- Right: live summary + submit -->
        <div class="card" style="margin-bottom:0">
            <div class="card-title">@Localizer["Summary"]</div>
            <table style="font-size:14px;width:100%">
                <tr>
                    <td style="padding:6px 0;color:#6b7280">@Localizer["Subtotal"]</td>
                    <td style="text-align:right;font-weight:600" id="sumSub">0</td>
                </tr>
                <tr>
                    <td style="padding:6px 0;color:#dc2626">@Localizer["Line discount"]</td>
                    <td style="text-align:right;color:#dc2626" id="sumDisc">—</td>
                </tr>
            </table>

            <!-- Whole-invoice discount: spread across lines pro-rata on save, so
                 per-line margin, commission and returns stay correct. -->
            <div style="border-top:1px solid #f3f4f6;padding-top:10px;margin-top:4px">
                <label style="font-size:12px;color:#6b7280">@Localizer["Invoice Discount"]</label>
                <div style="display:flex;gap:4px;margin-top:4px">
                    <input type="number" asp-for="InvoiceDiscountInput" min="0" step="0.01"
                           placeholder="0" style="flex:1;min-width:0" oninput="render()" />
                    <select id="invDiscMode" onchange="onInvDiscModeChange()"
                            style="width:58px;flex:none;padding:0 2px 0 8px"
                            title="@Localizer["Fixed amount off the invoice, or a percentage of the total"]">
                        <option value="amt">Rp</option>
                        <option value="pct">%</option>
                    </select>
                </div>
                <input type="hidden" asp-for="InvoiceDiscountIsPercent" id="invDiscIsPct" value="false" />
                <div id="invDiscHint" style="font-size:11px;color:#9ca3af;margin-top:4px;min-height:14px"></div>
            </div>

            <table style="font-size:14px;width:100%;margin-top:6px">
                <tr id="rowInvDisc" style="display:none">
                    <td style="padding:6px 0;color:#dc2626">@Localizer["Invoice Discount"]</td>
                    <td style="text-align:right;color:#dc2626" id="sumInvDisc">—</td>
                </tr>
                @* DPP and PPN stay bare — identical in both languages. *@
                <tr>
                    <td style="padding:6px 0;color:#6b7280;border-top:1px solid #f3f4f6">DPP <span style="font-size:11px;color:#9ca3af">(@Localizer["tax base"])</span></td>
                    <td style="text-align:right;font-weight:600;border-top:1px solid #f3f4f6" id="sumBase">0</td>
                </tr>
                <tr>
                    <td style="padding:6px 0;color:#6b7280">PPN <span id="sumVatLabel" style="font-size:11px;color:#9ca3af"></span></td>
                    <td style="text-align:right" id="sumTax">0</td>
                </tr>
                <tr style="border-top:2px solid #e5e7eb">
                    <td style="padding:10px 0;font-size:17px;font-weight:700">@Localizer["Grand Total"]</td>
                    <td style="text-align:right;font-size:17px;font-weight:700;color:#059669" id="sumTotal">0</td>
                </tr>
            </table>
            <input type="hidden" name="ItemsJson" id="ItemsJson" value="[]" />
            <button type="submit" id="submitBtn" class="btn btn-primary"
                    style="width:100%;margin-top:14px;padding:12px;font-size:15px">
                🧾 @Localizer["Create Invoice"]
            </button>
            <div id="submitErr" class="alert alert-danger" style="display:none;margin-top:10px"></div>
        </div>
    </div>

    <!-- Item builder -->
    <div class="card">
        <div class="card-title">@Localizer["Add Items"]</div>

        <!-- Row 1: product, qty, price, discount, warranty, add button -->
        <div style="display:grid;grid-template-columns:2.5fr 0.7fr 1.1fr 1.35fr 0.8fr auto;gap:10px;align-items:flex-end;margin-bottom:8px">
            <div>
                <label>@Localizer["Product"]</label>
                <select id="inProd" onchange="onProductChange()">
                    <option value="">— @Localizer["Select"] —</option>
                    @foreach (var p in Model.AvailableProducts)
                    {
                        <option value="@p.Id"
                                data-price="@p.UnitPrice"
                                data-stock="@p.CurrentStock"
                                data-warranty="@(p.DefaultWarrantyMonths ?? 0)"
                                data-name="@p.Name">
                            @p.Name (@p.SKU) — @Localizer["Stk:"] @p.CurrentStock.ToString("N0")
                        </option>
                    }
                </select>
            </div>
            <div>
                <label>@Localizer["Qty"]</label>
                <input type="number" id="inQty" min="0.01" step="0.01" value="1" />
            </div>
            <div>
                <label>@Localizer["Unit Price"]</label>
                <input type="number" id="inPrice" min="0" step="0.01" placeholder="0" oninput="onPriceInput()" />
            </div>
            <!-- position:relative so the resolved-amount hint can sit below without
                 adding height to this cell, which would break the row's flex-end alignment -->
            <div style="position:relative">
                <label>@Localizer["Discount"]</label>
                <div style="display:flex;gap:4px">
                    <input type="number" id="inDisc" min="0" step="0.01" value="0" placeholder="0"
                           style="flex:1;min-width:0" oninput="onDiscountInput()" />
                    <!-- Zero vertical padding: a native select is intrinsically ~2px taller
                         than a text input, and via flex stretch it would drag the whole cell
                         out of line with Qty/Price/Warranty. Letting the input set the height
                         keeps the row aligned without hardcoding a pixel value. -->
                    <select id="inDiscMode" onchange="onDiscountInput()"
                            style="width:58px;flex:none;padding:0 2px 0 8px"
                            title="@Localizer["Fixed amount per unit, or a percentage of unit price"]">
                        <option value="amt">Rp</option>
                        <option value="pct">%</option>
                    </select>
                </div>
                <div id="discHint"
                     style="position:absolute;top:100%;left:0;font-size:10px;color:#9ca3af;
                            white-space:nowrap;pointer-events:none;line-height:1.3"></div>
            </div>
            <div>
                <label>@Localizer["Warranty(mo)"]</label>
                <input type="number" id="inWarranty" min="0" value="0" placeholder="0" />
            </div>
            <div>
                <label>&nbsp;</label>
                <button type="button" class="btn btn-success" onclick="addItem()">@Localizer["Add"]</button>
            </div>
        </div>

        <!-- Row 2: line notes + price reason (contextual) -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
            <div>
                <label style="font-size:12px;color:#6b7280">@Localizer["Line Notes"] <span style="font-weight:400">(@Localizer["serial number, condition, etc."])</span></label>
                <input type="text" id="inNotes" maxlength="500" placeholder="@Localizer["Optional..."]" />
            </div>
            <div id="priceReasonBlock" style="display:none">
                <label style="font-size:12px;color:#d97706">⚠ @Localizer["Price Override Reason"] <span style="font-weight:700;color:#dc2626">*@Localizer["Required"]</span></label>
                <input type="text" id="inPriceReason" maxlength="300" placeholder="@Localizer["e.g. Special customer rate, clearance..."]" />
            </div>
        </div>

        <div id="addErr" class="alert alert-danger" style="display:none;margin-bottom:10px"></div>

        <table id="tbl">
            <thead>
                <tr>
                    <th>@Localizer["Product"]</th>
                    <th style="text-align:center">@Localizer["Qty"]</th>
                    <th style="text-align:right">@Localizer["Price"]</th>
                    <th style="text-align:right">@Localizer["Disc"]</th>
                    <th style="text-align:right">@Localizer["Total"]</th>
                    <th style="text-align:center">@Localizer["Warranty"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tblBody">
                <tr id="emptyRow">
                    <td colspan="7" style="text-align:center;color:#9ca3af;padding:24px">
                        @Localizer["No items yet — select a product above and click Add."]
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</form>

@section Scripts {
<script>
// Every string this script writes into the page comes from the SAME resx keys the markup
// uses — one source of truth per phrase, not a parallel JS-only translation table.
// Json.Serialize (not manual quoting) does the escaping, so an Indonesian translation
// containing a quote or backslash can't break out and corrupt this <script> block.
const T = {
    selectProduct:  @Html.Raw(Json.Serialize(Localizer["Please select a product."].Value)),
    qtyPositive:    @Html.Raw(Json.Serialize(Localizer["Quantity must be greater than zero."].Value)),
    priceNegative:  @Html.Raw(Json.Serialize(Localizer["Price cannot be negative."].Value)),
    discNegative:   @Html.Raw(Json.Serialize(Localizer["Discount cannot be negative."].Value)),
    discPctMax:     @Html.Raw(Json.Serialize(Localizer["Discount percent must be less than 100."].Value)),
    discExceeds:    @Html.Raw(Json.Serialize(Localizer["Discount cannot equal or exceed price."].Value)),
    productMissing: @Html.Raw(Json.Serialize(Localizer["Product not found."].Value)),
    needReason:     @Html.Raw(Json.Serialize(Localizer["Price differs from master price ({0}). Please enter a price override reason."].Value)),
    notEnough:      @Html.Raw(Json.Serialize(Localizer["Not enough stock. Available: {0}"].Value)),
    needItem:       @Html.Raw(Json.Serialize(Localizer["Please add at least one item before creating the invoice."].Value)),
    needCustomer:   @Html.Raw(Json.Serialize(Localizer["Please select a customer."].Value)),
    perUnit:        @Html.Raw(Json.Serialize(Localizer["/unit"].Value)),
    offInvoice:     @Html.Raw(Json.Serialize(Localizer["off the invoice"].Value)),
    included:       @Html.Raw(Json.Serialize(Localizer["included"].Value)),
    mo:             @Html.Raw(Json.Serialize(Localizer["mo"].Value))
};

// Product data from server (master prices stored for price-override detection)
const PRODUCTS = @Html.Raw(JsonSerializer.Serialize(
    Model.AvailableProducts.Select(p => new {
        id = p.Id.ToString(),
        name = p.Name,
        price = p.UnitPrice,
        stock = p.CurrentStock,
        warranty = p.DefaultWarrantyMonths ?? 0
    })
));

let items = [];  // { productId, name, masterPrice, qty, price, disc, warranty, notes, priceReason, total }

// ── Payment type → due date preview ──────────────────────────────────────────
function onPaymentTypeChange() {
    const val    = document.getElementById('paymentTypeSelect').value;
    const isCash = val === '1';

    // Credit term only applies to non-cash sales.
    const termRow = document.getElementById('paymentTermRow');
    termRow.style.display = isCash ? 'none' : 'block';
    if (isCash) document.getElementById('paymentTermSelect').value = '';

    updateDueDatePreview();
}

// The selected PaymentTerm is the only source of a due date — mirrors the server.
// No term on a credit sale means open credit, so no date is previewed.
function updateDueDatePreview() {
    const typeVal  = document.getElementById('paymentTypeSelect').value;
    const termSel  = document.getElementById('paymentTermSelect');
    const termOpt  = termSel.options[termSel.selectedIndex];
    const termDays = termOpt && termOpt.value ? parseInt(termOpt.dataset.days, 10) : null;

    const days  = (termDays !== null && !isNaN(termDays)) ? termDays : null;
    const block = document.getElementById('dueDatePreview');

    if (typeVal !== '1' && days !== null) {
        // Counted from the sale date, not today — mirrors the server, so backdating
        // a credit sale previews the same due date it will actually be given.
        const saleDateVal = document.getElementById('saleDateInput').value;
        const d = saleDateVal ? new Date(saleDateVal + 'T00:00:00') : new Date();
        d.setDate(d.getDate() + days);
        document.getElementById('dueDateText').textContent = d.toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'});
        block.style.display = 'block';
    } else {
        block.style.display = 'none';
    }
}

// ── Product selection → auto-fill price + warranty ───────────────────────────
function onProductChange() {
    const opt = document.getElementById('inProd').options[document.getElementById('inProd').selectedIndex];
    if (!opt.value) return;
    document.getElementById('inPrice').value    = opt.dataset.price;
    document.getElementById('inWarranty').value = opt.dataset.warranty;
    onPriceInput();  // re-evaluate override reason visibility
}

// ── Price input → show/hide price reason block ───────────────────────────────
function onPriceInput() {
    const prodId = document.getElementById('inProd').value;
    if (!prodId) return;
    const prod = PRODUCTS.find(p => p.id === prodId);
    if (!prod) return;
    const inputPrice = parseFloat(document.getElementById('inPrice').value) || 0;
    const differs = Math.abs(inputPrice - prod.price) > 0.001;
    document.getElementById('priceReasonBlock').style.display = differs ? 'block' : 'none';
    if (!differs) document.getElementById('inPriceReason').value = '';
}

// Shows what a percentage resolves to per unit, so staff can see the real
// number before committing the line.
function onDiscountInput() {
    const val   = parseFloat(document.getElementById('inDisc').value) || 0;
    const isPct = document.getElementById('inDiscMode').value === 'pct';
    const price = parseFloat(document.getElementById('inPrice').value) || 0;
    const hint  = document.getElementById('discHint');

    if (isPct && val > 0 && price > 0) {
        const amt = Math.round((price * val / 100) * 100) / 100;
        hint.textContent = '= ' + fmt(amt) + ' ' + T.perUnit;
    } else {
        hint.textContent = '';
    }
}

function addItem() {
    hideErr('addErr');
    const selEl      = document.getElementById('inProd');
    const prodId     = selEl.value;
    const qty        = parseFloat(document.getElementById('inQty').value)   || 0;
    const price      = parseFloat(document.getElementById('inPrice').value)  || 0;
    const discInput  = parseFloat(document.getElementById('inDisc').value)   || 0;
    const discIsPct  = document.getElementById('inDiscMode').value === 'pct';
    const warranty   = parseInt(document.getElementById('inWarranty').value) || 0;
    const notes      = document.getElementById('inNotes').value.trim();
    const priceReason= document.getElementById('inPriceReason').value.trim();

    if (!prodId)   return showErr('addErr', T.selectProduct);
    if (qty <= 0)  return showErr('addErr', T.qtyPositive);
    if (price < 0) return showErr('addErr', T.priceNegative);
    if (discInput < 0) return showErr('addErr', T.discNegative);
    if (discIsPct && discInput >= 100)
        return showErr('addErr', T.discPctMax);

    // Resolve percent to a per-unit amount, mirroring the server so the preview
    // totals match what actually gets posted. The server recomputes it regardless.
    const discPct = discIsPct ? discInput : null;
    const discAmt = discIsPct ? Math.round((price * discInput / 100) * 100) / 100 : discInput;

    if (discAmt >= price && price > 0) return showErr('addErr', T.discExceeds);

    const prod = PRODUCTS.find(p => p.id === prodId);
    if (!prod) return showErr('addErr', T.productMissing);

    // Price override requires reason
    const differs = Math.abs(price - prod.price) > 0.001;
    if (differs && !priceReason)
        return showErr('addErr', T.needReason.replace('{0}', fmt(prod.price)));

    // Check total qty for this product across all items
    const alreadyQty = items.filter(i => i.productId === prodId).reduce((s,i) => s + i.qty, 0);
    if (alreadyQty + qty > prod.stock)
        return showErr('addErr', T.notEnough.replace('{0}', fmt(prod.stock - alreadyQty)));

    items.push({
        productId:   prodId,
        name:        prod.name,
        masterPrice: prod.price,
        qty, price, warranty,
        disc:        discAmt,
        discPct:     discPct,
        notes:       notes || null,
        priceReason: differs ? priceReason : null,
        total:       (price - discAmt) * qty
    });

    render();

    // Reset inputs
    selEl.value = '';
    document.getElementById('inQty').value        = '1';
    document.getElementById('inPrice').value      = '';
    document.getElementById('inDisc').value       = '0';
    document.getElementById('inDiscMode').value   = 'amt';
    onDiscountInput();
    document.getElementById('inWarranty').value   = '0';
    document.getElementById('inNotes').value      = '';
    document.getElementById('inPriceReason').value= '';
    document.getElementById('priceReasonBlock').style.display = 'none';
}

function removeItem(idx) {
    items.splice(idx, 1);
    render();
}

function render() {
    const body = document.getElementById('tblBody');

    if (items.length === 0) {
        body.innerHTML = '';
        body.appendChild(document.getElementById('emptyRow'));
        syncSummary(0, 0);
        document.getElementById('ItemsJson').value = '[]';
        return;
    }

    let subTotal = 0, discTotal = 0;
    let html = '';
    items.forEach((item, i) => {
        subTotal  += item.price * item.qty;
        discTotal += item.disc  * item.qty;
        const overrideTag = item.priceReason
            ? `<br><small style="color:#d97706">⚠ ${esc(item.priceReason)}</small>` : '';
        const notesTag = item.notes
            ? `<br><small style="color:#6b7280">📝 ${esc(item.notes)}</small>` : '';
        html += `<tr>
            <td><strong>${esc(item.name)}</strong>${overrideTag}${notesTag}</td>
            <td style="text-align:center">${item.qty}</td>
            <td style="text-align:right">${fmt(item.price)}</td>
            <td style="text-align:right;color:#dc2626">${item.disc > 0
                ? '-' + fmt(item.disc) + (item.discPct ? `<br><small style="color:#9ca3af">(${item.discPct}%)</small>` : '')
                : '—'}</td>
            <td style="text-align:right;font-weight:600">${fmt(item.total)}</td>
            <td style="text-align:center">${item.warranty > 0 ? item.warranty + ' ' + T.mo : '—'}</td>
            <td><button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})">✕</button></td>
        </tr>`;
    });
    body.innerHTML = html;
    syncSummary(subTotal, discTotal);

    document.getElementById('ItemsJson').value = JSON.stringify(items.map(i => ({
        productId:      i.productId,
        qty:            i.qty,
        unitPrice:      i.price,
        discountAmount: i.disc,
        discountPercent: i.discPct,
        warrantyMonths: i.warranty || null,
        notes:          i.notes    || null,
        priceReason:    i.priceReason || null
    })));
}

const VAT_RATE = @Model.VatRate.ToString(System.Globalization.CultureInfo.InvariantCulture);

function onInvDiscModeChange() {
    // Keep the hidden bound field in step with the visible selector.
    const isPct = document.getElementById('invDiscMode').value === 'pct';
    document.getElementById('invDiscIsPct').value = isPct ? 'true' : 'false';
    render();
}

// Mirrors SaleService exactly: resolve the invoice discount, then apply PPN on the
// remainder. Kept in step deliberately — a preview that disagrees with the posted
// invoice is worse than no preview, and this one silently did before PPN existed.
function syncSummary(sub, disc) {
    const lineNet   = sub - disc;
    const rawInput  = parseFloat(document.getElementById('InvoiceDiscountInput').value) || 0;
    const isPct     = document.getElementById('invDiscMode').value === 'pct';
    const taxIncl   = document.getElementById('taxInclusiveCheck').checked;

    let invDisc = isPct
        ? Math.round((lineNet * rawInput / 100) * 100) / 100
        : rawInput;
    if (invDisc < 0) invDisc = 0;
    if (invDisc > lineNet) invDisc = lineNet;   // preview only; the server rejects this outright

    const netTotal = lineNet - invDisc;

    let base, tax, grand;
    if (VAT_RATE <= 0) {
        base = netTotal; tax = 0; grand = netTotal;
    } else if (taxIncl) {
        grand = netTotal;
        base  = Math.round((netTotal / (1 + VAT_RATE)) * 100) / 100;
        tax   = netTotal - base;
    } else {
        base  = netTotal;
        tax   = Math.round((netTotal * VAT_RATE) * 100) / 100;
        grand = base + tax;
    }

    document.getElementById('sumSub').textContent  = fmt(sub);
    document.getElementById('sumDisc').textContent = disc > 0 ? '-' + fmt(disc) : '—';

    document.getElementById('rowInvDisc').style.display = invDisc > 0 ? '' : 'none';
    document.getElementById('sumInvDisc').textContent   = invDisc > 0 ? '-' + fmt(invDisc) : '—';

    const hint = document.getElementById('invDiscHint');
    hint.textContent = (isPct && rawInput > 0 && lineNet > 0)
        ? '= ' + fmt(invDisc) + ' ' + T.offInvoice
        : '';

    document.getElementById('sumBase').textContent = fmt(base);
    document.getElementById('sumTax').textContent  = fmt(tax);
    document.getElementById('sumVatLabel').textContent =
        VAT_RATE > 0 ? '(' + (VAT_RATE * 100).toFixed(2).replace(/\.?0+$/, '') + '%' + (taxIncl ? ', ' + T.included : '') + ')' : '';
    document.getElementById('sumTotal').textContent = fmt(grand);
}

document.getElementById('saleForm').addEventListener('submit', function(e) {
    if (items.length === 0) {
        e.preventDefault();
        showErr('submitErr', T.needItem);
    }
    if (!document.querySelector('select[name="CustomerId"]').value) {
        e.preventDefault();
        showErr('submitErr', T.needCustomer);
    }
});

function fmt(n)    { return Math.round(n).toLocaleString(); }
function esc(s)    { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
function showErr(id, msg) { const el = document.getElementById(id); el.textContent = msg; el.style.display = 'block'; }
function hideErr(id)      { document.getElementById(id).style.display = 'none'; }
</script>
}
