@page "/Sales/{id:guid}"
@model SimpleERP.Web.Pages.Sales.DetailModel
@{ ViewData["Title"] = $"Invoice {Model.Sale.InvoiceNumber}"; }

@if (Model.Msg != null) {
  <div class="alert @(Model.IsErr?"alert-danger":"alert-success") no-print">@Model.Msg</div>
}

<!-- Action Bar -->
<div class="no-print" style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
  <a href="/Sales" class="btn btn-outline btn-sm">← Sales</a>
  <button onclick="window.print()" class="btn btn-secondary btn-sm">🖨 Browser Print</button>
  @if (Model.AppSettings.PrinterEnabled && !string.IsNullOrEmpty(Model.AppSettings.PrinterName)) {
    <button id="btnDot" class="btn btn-success btn-sm" onclick="dotPrint('@Model.Sale.Id')">
      🖨 Print to @Model.AppSettings.PrinterName
    </button>
  } else {
    <a href="/Settings" class="btn btn-outline btn-sm" style="color:#9ca3af">🖨 Set up printer →</a>
  }
  <a href="?handler=Txt&id=@Model.Sale.Id" class="btn btn-outline btn-sm">📄 TXT</a>
  @if (Model.Sale.Status == "Active") {
    <a href="/Returns/Customer/New/@Model.Sale.Id" class="btn btn-warn btn-sm">↩ Return items</a>
    <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Sale.Id" style="margin-left:auto"
          onsubmit="return confirm('Cancel this sale? Stock will be reversed.')">
      <button type="submit" class="btn btn-danger btn-sm">✕ Cancel Sale</button>
    </form>
  }
</div>
<div id="printStatus" class="alert" style="display:none;margin-bottom:10px"></div>

<div style="display:grid;grid-template-columns:1fr 360px;gap:16px">
<!-- Invoice -->
<div class="card" id="invoiceCard">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
    <div>
      <div style="font-size:20px;font-weight:800;color:#1a1a2e">@Model.AppSettings.StoreName</div>
      @if (!string.IsNullOrEmpty(Model.AppSettings.StoreAddress)) {
        <div style="color:#6b7280;font-size:12px">@Model.AppSettings.StoreAddress</div>
      }
      @if (!string.IsNullOrEmpty(Model.AppSettings.StorePhone)) {
        <div style="color:#6b7280;font-size:12px">Tel: @Model.AppSettings.StorePhone</div>
      }
    </div>
    <div style="text-align:right">
      <div style="font-size:18px;font-weight:700;color:#2563eb">@Model.Sale.InvoiceNumber</div>
      <div style="color:#9ca3af;font-size:12px">@Model.Sale.SaleDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
      @if (Model.Sale.Status == "Cancelled") {
        <div style="color:#dc2626;font-weight:700;font-size:13px;margin-top:4px">⛔ CANCELLED</div>
      }
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;padding:12px;background:#f9fafb;border-radius:6px">
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Customer</div>
      <div style="font-weight:600">@Model.Sale.CustomerName</div>
      @if (!string.IsNullOrEmpty(Model.Sale.CustomerPhone)) {
        <div style="color:#6b7280;font-size:12px">📞 @Model.Sale.CustomerPhone</div>
      }
      @if (!string.IsNullOrEmpty(Model.Sale.SalesPersonName)) {
        <div style="color:#6b7280;font-size:12px;margin-top:4px">👤 Sold by @Model.Sale.SalesPersonName</div>
      }
    </div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">Payment</div>
      @{
        var isCash  = Model.Sale.PaymentType == "Cash";
        var ptLabel = isCash ? "💵 Cash" : "📋 Credit";
        var ptClass = isCash ? "ok" : "warn";
        var isOverdue = Model.Sale.DueDate.HasValue
                     && Model.Sale.DueDate.Value.Date < DateTime.UtcNow.Date
                     && Model.Sale.BalanceDue > 0;
      }
      <span class="badge @ptClass">@ptLabel</span>
      @if (!string.IsNullOrEmpty(Model.Sale.PaymentTermName)) {
        <span style="font-size:12px;color:#6b7280"> · @Model.Sale.PaymentTermName</span>
      }
      @if (Model.Sale.DueDate.HasValue) {
        var dueLbl = isOverdue
            ? $"⚠ OVERDUE since {Model.Sale.DueDate.Value:dd MMM yyyy}"
            : $"Due by {Model.Sale.DueDate.Value:dd MMM yyyy}";
        var dueColor = isOverdue ? "#dc2626" : "#d97706";
        <div style="font-size:12px;font-weight:600;color:@dueColor;margin-top:3px">@dueLbl</div>
      }
      @if (Model.StillOwed > 0) {
        <div style="color:#dc2626;font-weight:700;font-size:12px;margin-top:3px">Still owed: @Model.StillOwed.ToString("N0")</div>
      } else if (!isCash && Model.Sale.Status == "Active") {
        <div style="color:#059669;font-size:12px;margin-top:3px">✓ Fully paid</div>
      }
    </div>
  </div>

  <table style="margin-bottom:14px">
    <thead><tr><th>Product</th><th style="text-align:center">Qty</th><th style="text-align:right">Price</th><th style="text-align:right">Disc</th><th style="text-align:right">Total</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Sale.Items) {
      <tr>
        <td>
          <div style="font-weight:600">@item.ProductName</div>
          <div style="font-size:11px;color:#9ca3af">@item.SKU</div>
          @if (!string.IsNullOrEmpty(item.Notes)) {
            <div style="font-size:11px;color:#4b5563">📝 @item.Notes</div>
          }
          @if (!string.IsNullOrEmpty(item.PriceReason)) {
            <div style="font-size:11px;color:#d97706">⚠ Price adj: @item.PriceReason</div>
          }
          @if (item.WarrantyExpiry.HasValue) {
            <div style="font-size:11px;color:#059669">🛡 Warranty until @item.WarrantyExpiry.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
          }
        </td>
        <td style="text-align:center">@item.Qty.ToString("N0")</td>
        <td style="text-align:right">@item.UnitPrice.ToString("N0")</td>
        <td style="text-align:right;color:#dc2626">
          @if (item.DiscountAmount > 0)
          {
            @($"-{item.DiscountAmount:N0}")
            @if (item.DiscountPercent.HasValue)
            {
              <br /><small style="color:#9ca3af">(@item.DiscountPercent.Value.ToString("0.##")%)</small>
            }
          }
          else
          {
            @("—")
          }
        </td>
        <td style="text-align:right;font-weight:600">@item.LineTotal.ToString("N0")</td>
      </tr>
    }
    </tbody>
  </table>

  <div style="max-width:240px;margin-left:auto">
    <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">Subtotal</span><span>@Model.Sale.SubTotal.ToString("N0")</span></div>
    @if (Model.Sale.DiscountTotal > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#dc2626">Line discount</span><span style="color:#dc2626">-@Model.Sale.DiscountTotal.ToString("N0")</span></div>
    }
    @if (Model.Sale.InvoiceDiscountAmount > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0">
        <span style="color:#dc2626">
          Invoice discount
          @if (Model.Sale.InvoiceDiscountPercent.HasValue) {
            <span style="font-size:11px;color:#9ca3af">(@Model.Sale.InvoiceDiscountPercent.Value.ToString("0.##")%)</span>
          }
        </span>
        <span style="color:#dc2626">-@Model.Sale.InvoiceDiscountAmount.ToString("N0")</span>
      </div>
    }
    @if (Model.Sale.TaxAmount > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">DPP (tax base)</span><span>@Model.Sale.TaxBase.ToString("N0")</span></div>
      <div style="display:flex;justify-content:space-between;padding:4px 0">
        <span style="color:#6b7280">
          PPN @((Model.Sale.TaxRate * 100).ToString("0.##"))%
          @if (Model.Sale.IsTaxInclusive) { <span style="font-size:11px;color:#9ca3af">(included)</span> }
        </span>
        <span>@Model.Sale.TaxAmount.ToString("N0")</span>
      </div>
    }
    <div style="display:flex;justify-content:space-between;padding:9px 0;border-top:2px solid #1a1a2e;font-size:16px;font-weight:700"><span>Grand Total</span><span>@Model.Sale.GrandTotal.ToString("N0")</span></div>
    <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">Paid (at sale)</span><span style="color:#059669;font-weight:600">@Model.Sale.AmountPaid.ToString("N0")</span></div>
    @if (Model.TotalCollected > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">Collected later</span><span style="color:#059669;font-weight:600">@Model.TotalCollected.ToString("N0")</span></div>
    }
    @if (Model.StillOwed > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0;font-weight:700;color:#dc2626"><span>Balance Due</span><span>@Model.StillOwed.ToString("N0")</span></div>
    }
  </div>

  @if (!string.IsNullOrEmpty(Model.Sale.Notes)) {
    <div style="margin-top:12px;padding:10px;background:#f9fafb;border-radius:6px;font-size:13px;color:#6b7280"><strong>Notes:</strong> @Model.Sale.Notes</div>
  }
  <div style="text-align:center;margin-top:18px;padding-top:12px;border-top:1px solid #f3f4f6;color:#9ca3af;font-size:12px">@Model.AppSettings.StoreFooter</div>
</div>

<!-- Side panel: Payments + Record -->
<div class="no-print">
  @{
    var isCreditTerm = Model.Sale.PaymentType != "Cash";
  }
  @if (isCreditTerm && Model.Sale.Status == "Active") {
    <!-- Record Payment -->
    <div class="card">
      <div class="card-title">💳 Record Payment</div>
      @if (Model.StillOwed <= 0) {
        <div class="alert alert-success" style="font-size:12px">✓ Fully paid. No balance remaining.</div>
      } else {
        <form method="post" asp-page-handler="Payment" asp-route-id="@Model.Sale.Id">
          <div class="fg">
            <label>Amount to collect</label>
            <input type="number" asp-for="PayInput.Amount" min="0.01" step="0.01" max="@Model.StillOwed" placeholder="@Model.StillOwed.ToString("N0")" required/>
            <div style="font-size:11px;color:#6b7280;margin-top:3px">Outstanding: @Model.StillOwed.ToString("N0")</div>
          </div>
          <div class="fg">
            <label>Notes (optional)</label>
            <input type="text" asp-for="PayInput.Notes" placeholder="e.g. Cash, transfer..."/>
          </div>
          <button type="submit" class="btn btn-success" style="width:100%">✓ Confirm Payment</button>
        </form>
      }
    </div>
  }

  <!-- Returns -->
  @if (Model.Returns.Any()) {
    <div class="card">
      <div class="card-title">↩ Returns Against This Invoice</div>
      <table>
        <thead><tr><th>Return</th><th style="text-align:right">Credited</th><th style="text-align:center">Status</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Returns) {
          <tr>
            <td style="font-size:12px">
              <a href="/Returns/Customer/@r.Id" style="color:#2563eb;font-weight:600">@r.ReturnNumber</a>
              <div style="color:#9ca3af;font-size:11px">@r.ReturnDate.ToLocalTime().ToString("dd-MMM-yy") · @r.LineCount line(s)</div>
            </td>
            <td style="text-align:right;font-weight:600">@r.GrandTotal.ToString("N0")</td>
            <td style="text-align:center;font-size:11px">
              <span class="badge @(r.Status == "Active" ? "ok" : "gray")">@r.Status</span>
            </td>
          </tr>
        }
        </tbody>
      </table>
      <p style="font-size:11px;color:#9ca3af;margin-top:8px">
        The invoice total above is unchanged by design — what the customer is owed sits on the
        credit note each return raised.
      </p>
    </div>
  }

  <!-- Commission -->
  @if (Model.Commissions.Any()) {
    <div class="card">
      <div class="card-title">🧾 Commission Accrued</div>
      <table>
        <thead><tr><th>Sales Person</th><th style="text-align:right">Amount</th><th style="text-align:center">Status</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Commissions) {
          <tr>
            <td style="font-size:12px">
              @c.SalesPersonName
              <div style="color:#9ca3af;font-size:11px">@c.RuleName · @c.Rate.ToString("0.##")%</div>
            </td>
            <td style="text-align:right;font-weight:600">@c.Amount.ToString("N0")</td>
            <td style="text-align:center;font-size:11px">
              @if (c.IsVoided) {
                <span style="color:#9ca3af;font-weight:600;text-decoration:line-through">Voided</span>
              } else if (c.IsPaid) {
                <span style="color:#059669;font-weight:600">Paid</span>
              } else {
                <span style="color:#d97706;font-weight:600">Unpaid</span>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
      <p style="font-size:11px;color:#9ca3af;margin-top:8px">
        Pay salespeople out on the <a href="/Commissions">Commissions</a> page.
      </p>
    </div>
  }

  <!-- Payment History -->
  @if (Model.Payments.Any()) {
    <div class="card">
      <div class="card-title">Payment History</div>
      <table>
        <thead><tr><th>Date</th><th style="text-align:right">Amount</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Payments) {
          <tr>
            <td style="font-size:12px">@p.PaymentDate.ToLocalTime().ToString("dd-MMM-yy HH:mm")</td>
            <td style="text-align:right;font-weight:600;color:#059669">@p.Amount.ToString("N0")</td>
            <td style="color:#9ca3af;font-size:12px">@(p.Notes ?? "—")</td>
          </tr>
        }
        <tr style="background:#f9fafb">
          <td style="font-weight:700">Total</td>
          <td style="text-align:right;font-weight:700;color:#059669">@Model.TotalCollected.ToString("N0")</td>
          <td></td>
        </tr>
        </tbody>
      </table>
    </div>
  }
</div>
</div>

@section Scripts {
<script>
async function dotPrint(saleId) {
    const btn = document.getElementById('btnDot');
    const status = document.getElementById('printStatus');
    btn.disabled = true;
    btn.textContent = '⏳ Sending...';
    status.style.display = 'none';
    try {
        const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const r = await fetch(`/api/print/invoice/${saleId}`, {
            method: 'POST', headers: { 'RequestVerificationToken': tok }
        });
        const d = await r.json();
        status.className = r.ok ? 'alert alert-success' : 'alert alert-danger';
        status.textContent = r.ok ? '✓ ' + d.message : '✗ ' + d.error;
    } catch(e) {
        status.className = 'alert alert-danger';
        status.textContent = '✗ Could not reach printer service.';
    }
    status.style.display = 'block';
    btn.disabled = false;
    btn.textContent = '🖨 Print to @Model.AppSettings.PrinterName';
}
</script>
}
