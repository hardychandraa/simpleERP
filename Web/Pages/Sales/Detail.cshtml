@page "/Sales/{id:guid}"
@model SimpleERP.Web.Pages.Sales.DetailModel
@{ ViewData["Title"] = Localizer["Invoice {0}", Model.Sale.InvoiceNumber].Value; }

@if (Model.Msg != null) {
  <div class="alert @(Model.IsErr?"alert-danger":"alert-success") no-print">@Model.Msg</div>
}

<!-- Action Bar -->
<div class="no-print" style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
  <a href="/Sales" class="btn btn-outline btn-sm">&larr; @Localizer["Sales"]</a>
  <button onclick="window.print()" class="btn btn-secondary btn-sm">🖨 @Localizer["Browser Print"]</button>
  @if (Model.AppSettings.PrinterEnabled && !string.IsNullOrEmpty(Model.AppSettings.PrinterName)) {
    <button id="btnDot" class="btn btn-success btn-sm" onclick="dotPrint('@Model.Sale.Id')">
      🖨 @Localizer["Print to {0}", Model.AppSettings.PrinterName]
    </button>
  } else {
    <a href="/Settings" class="btn btn-outline btn-sm" style="color:#9ca3af">🖨 @Localizer["Set up printer"] &rarr;</a>
  }
  <a href="?handler=Txt&id=@Model.Sale.Id" class="btn btn-outline btn-sm">📄 TXT</a>
  @if (Model.Sale.Status == "Active") {
    <a href="/Returns/Customer/New/@Model.Sale.Id" class="btn btn-warn btn-sm">↩ @Localizer["Return items"]</a>
    @* Hidden once a credit invoice has payments — ReviseAsync refuses it anyway. *@
    @if (Model.Sale.PaymentType == "Cash" || Model.Sale.AmountPaid == 0) {
    <a href="/Sales/Create?revise=@Model.Sale.Id" class="btn btn-outline btn-sm"
       title="@Localizer["Opens a pre-filled copy. Saving it cancels this invoice and issues a corrected one."]">✎ @Localizer["Revise"]</a>
    }
    <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Sale.Id" style="margin-left:auto"
          onsubmit="return confirm('@Localizer["Cancel this sale? Stock will be reversed."]')">
      <button type="submit" class="btn btn-danger btn-sm">✕ @Localizer["Cancel Sale"]</button>
    </form>
  }
</div>
<div id="printStatus" class="alert" style="display:none;margin-bottom:10px"></div>

<div style="display:grid;grid-template-columns:1fr 360px;gap:16px">
<!-- Invoice -->
<div class="card" id="invoiceCard">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
    <div>
      <div style="font-size:20px;font-weight:800;color:#1a1a2e">@Model.AppSettings.StoreName</div>
      @if (!string.IsNullOrEmpty(Model.AppSettings.StoreAddress)) {
        <div style="color:#6b7280;font-size:12px">@Model.AppSettings.StoreAddress</div>
      }
      @if (!string.IsNullOrEmpty(Model.AppSettings.StorePhone)) {
        <div style="color:#6b7280;font-size:12px">@Localizer["Tel:"] @Model.AppSettings.StorePhone</div>
      }
    </div>
    <div style="text-align:right">
      <div style="font-size:18px;font-weight:700;color:#2563eb">@Model.Sale.InvoiceNumber</div>
      <div style="color:#9ca3af;font-size:12px">@Model.Sale.SaleDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
      @if (Model.Sale.Status == "Cancelled") {
        <div style="color:#dc2626;font-weight:700;font-size:13px;margin-top:4px;text-transform:uppercase">⛔ @Localizer["Cancelled"]</div>
      }
      @if (Model.Sale.ReplacedBySaleId.HasValue) {
        <div style="font-size:12px;margin-top:4px">@Localizer["Replaced by"] <a href="/Sales/@Model.Sale.ReplacedBySaleId">@Model.Sale.ReplacedByInvoiceNumber</a></div>
      }
      @if (Model.Sale.ReplacesSaleId.HasValue) {
        <div style="font-size:12px;margin-top:4px">@Localizer["Revision of"] <a href="/Sales/@Model.Sale.ReplacesSaleId">@Model.Sale.ReplacesInvoiceNumber</a></div>
      }
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;padding:12px;background:#f9fafb;border-radius:6px">
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">@Localizer["Customer"]</div>
      <div style="font-weight:600">@Model.Sale.CustomerName</div>
      @if (!string.IsNullOrEmpty(Model.Sale.CustomerPhone)) {
        <div style="color:#6b7280;font-size:12px">📞 @Model.Sale.CustomerPhone</div>
      }
      @if (!string.IsNullOrEmpty(Model.Sale.SalesPersonName)) {
        <div style="color:#6b7280;font-size:12px;margin-top:4px">👤 @Localizer["Sold by {0}", Model.Sale.SalesPersonName]</div>
      }
    </div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#9ca3af;margin-bottom:3px">@Localizer["Payment"]</div>
      @{
        var isCash  = Model.Sale.PaymentType == "Cash";
        var ptLabel = (isCash ? "💵 " : "📋 ") + Localizer[EnumDisplay.Key("PaymentType", Model.Sale.PaymentType)].Value;
        var ptClass = isCash ? "ok" : "warn";
        var isOverdue = Model.Sale.DueDate.HasValue
                     && Model.Sale.DueDate.Value.Date < DateTime.UtcNow.Date
                     && Model.Sale.BalanceDue > 0;
      }
      <span class="badge @ptClass">@ptLabel</span>
      @if (!string.IsNullOrEmpty(Model.Sale.PaymentTermName)) {
        <span style="font-size:12px;color:#6b7280"> · @Model.Sale.PaymentTermName</span>
      }
      @if (Model.Sale.DueDate.HasValue) {
        var dueLbl = isOverdue
            ? Localizer["⚠ OVERDUE since {0}", Model.Sale.DueDate.Value.ToString("dd MMM yyyy")].Value
            : Localizer["Due by {0}", Model.Sale.DueDate.Value.ToString("dd MMM yyyy")].Value;
        var dueColor = isOverdue ? "#dc2626" : "#d97706";
        <div style="font-size:12px;font-weight:600;color:@dueColor;margin-top:3px">@dueLbl</div>
      }
      @if (Model.StillOwed > 0) {
        <div style="color:#dc2626;font-weight:700;font-size:12px;margin-top:3px">@Localizer["Still owed:"] @Model.StillOwed.ToString("N0")</div>
      } else if (!isCash && Model.Sale.Status == "Active") {
        <div style="color:#059669;font-size:12px;margin-top:3px">✓ @Localizer["Fully paid"]</div>
      }
    </div>
  </div>

  <table style="margin-bottom:14px">
    <thead><tr><th>@Localizer["Product"]</th><th style="text-align:center">@Localizer["Qty"]</th><th style="text-align:right">@Localizer["Price"]</th><th style="text-align:right">@Localizer["Disc"]</th><th style="text-align:right">@Localizer["Total"]</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Sale.Items) {
      <tr>
        <td>
          <div style="font-weight:600">@item.ProductName</div>
          <div style="font-size:11px;color:#9ca3af">@item.SKU</div>
          @if (!string.IsNullOrEmpty(item.Notes)) {
            <div style="font-size:11px;color:#4b5563">📝 @item.Notes</div>
          }
          @if (!string.IsNullOrEmpty(item.PriceReason)) {
            @* no-print: an internal note, kept off every printout (HC, 2026-10-05) *@
            <div class="no-print" style="font-size:11px;color:#d97706">⚠ @Localizer["Price adj:"] @item.PriceReason</div>
          }
          @if (item.WarrantyExpiry.HasValue) {
            <div style="font-size:11px;color:#059669">🛡 @Localizer["Warranty until {0}", item.WarrantyExpiry.Value.ToLocalTime().ToString("dd MMM yyyy")]</div>
          }
        </td>
        <td style="text-align:center">@item.Qty.ToString("N0")</td>
        <td style="text-align:right">@item.UnitPrice.ToString("N0")</td>
        <td style="text-align:right;color:#dc2626">
          @if (item.DiscountAmount > 0)
          {
            @($"-{item.DiscountAmount:N0}")
            @if (item.DiscountPercent.HasValue)
            {
              <br /><small style="color:#9ca3af">(@item.DiscountPercent.Value.ToString("0.##")%)</small>
            }
          }
          else
          {
            @("—")
          }
        </td>
        <td style="text-align:right;font-weight:600">@item.LineTotal.ToString("N0")</td>
      </tr>
    }
    </tbody>
  </table>

  <div style="max-width:240px;margin-left:auto">
    <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">@Localizer["Subtotal"]</span><span>@Model.Sale.SubTotal.ToString("N0")</span></div>
    @if (Model.Sale.DiscountTotal > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#dc2626">@Localizer["Line discount"]</span><span style="color:#dc2626">-@Model.Sale.DiscountTotal.ToString("N0")</span></div>
    }
    @if (Model.Sale.InvoiceDiscountAmount > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0">
        <span style="color:#dc2626">
          @Localizer["Invoice Discount"]
          @if (Model.Sale.InvoiceDiscountPercent.HasValue) {
            <span style="font-size:11px;color:#9ca3af">(@Model.Sale.InvoiceDiscountPercent.Value.ToString("0.##")%)</span>
          }
        </span>
        <span style="color:#dc2626">-@Model.Sale.InvoiceDiscountAmount.ToString("N0")</span>
      </div>
    }
    @if (Model.Sale.TaxAmount > 0) {
      @* DPP and PPN are Indonesian tax terms — identical in both languages, left bare.
         Only the English gloss next to DPP is localized. *@
      <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #f3f4f6"><span style="color:#6b7280">DPP (@Localizer["tax base"])</span><span>@Model.Sale.TaxBase.ToString("N0")</span></div>
      <div style="display:flex;justify-content:space-between;padding:4px 0">
        <span style="color:#6b7280">
          PPN @((Model.Sale.TaxRate * 100).ToString("0.##"))%
          @if (Model.Sale.IsTaxInclusive) { <span style="font-size:11px;color:#9ca3af">(@Localizer["included"])</span> }
        </span>
        <span>@Model.Sale.TaxAmount.ToString("N0")</span>
      </div>
    }
    <div style="display:flex;justify-content:space-between;padding:9px 0;border-top:2px solid #1a1a2e;font-size:16px;font-weight:700"><span>@Localizer["Grand Total"]</span><span>@Model.Sale.GrandTotal.ToString("N0")</span></div>
    <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">@Localizer["Paid (at sale)"]</span><span style="color:#059669;font-weight:600">@Model.Sale.AmountPaid.ToString("N0")</span></div>
    @if (Model.TotalCollected > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">@Localizer["Collected later"]</span><span style="color:#059669;font-weight:600">@Model.TotalCollected.ToString("N0")</span></div>
    }
    @if (Model.Sale.AppliedNotesTotal > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0"><span style="color:#6b7280">@Localizer["Credit notes applied"]</span><span style="color:#059669;font-weight:600">@Model.Sale.AppliedNotesTotal.ToString("N0")</span></div>
    }
    @if (Model.StillOwed > 0) {
      <div style="display:flex;justify-content:space-between;padding:4px 0;font-weight:700;color:#dc2626"><span>@Localizer["Balance Due"]</span><span>@Model.StillOwed.ToString("N0")</span></div>
    }
  </div>

  @if (!string.IsNullOrEmpty(Model.Sale.Notes)) {
    <div style="margin-top:12px;padding:10px;background:#f9fafb;border-radius:6px;font-size:13px;color:#6b7280"><strong>@Localizer["Notes:"]</strong> @Model.Sale.Notes</div>
  }
  <div style="text-align:center;margin-top:18px;padding-top:12px;border-top:1px solid #f3f4f6;color:#9ca3af;font-size:12px">@Model.AppSettings.StoreFooter</div>
</div>

<!-- Side panel: Payments + Record -->
<div class="no-print">
  @{
    var isCreditTerm = Model.Sale.PaymentType != "Cash";
  }
  @if (isCreditTerm && Model.Sale.Status == "Active") {
    <!-- Record Payment -->
    <div class="card">
      <div class="card-title">💳 @Localizer["Record Payment"]</div>
      @if (Model.StillOwed <= 0) {
        <div class="alert alert-success" style="font-size:12px">✓ @Localizer["Fully paid. No balance remaining."]</div>
      } else {
        <form method="post" asp-page-handler="Payment" asp-route-id="@Model.Sale.Id">
          <div class="fg">
            <label>@Localizer["Amount to collect"]</label>
            <input type="number" asp-for="PayInput.Amount" min="0.01" step="0.01" max="@Model.StillOwed.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="@Model.StillOwed.ToString("N0")" required/>
            <div style="font-size:11px;color:#6b7280;margin-top:3px">@Localizer["Outstanding:"] @Model.StillOwed.ToString("N0")</div>
          </div>
          <div class="fg">
            <label>@Localizer["Notes (optional)"]</label>
            <input type="text" asp-for="PayInput.Notes" placeholder="@Localizer["e.g. Cash, transfer..."]"/>
          </div>
          <button type="submit" class="btn btn-success" style="width:100%">✓ @Localizer["Confirm Payment"]</button>
        </form>
      }
    </div>
  }

  <!-- Returns -->
  @if (Model.Returns.Any()) {
    <div class="card">
      <div class="card-title">↩ @Localizer["Returns Against This Invoice"]</div>
      <table>
        <thead><tr><th>@Localizer["Return"]</th><th style="text-align:right">@Localizer["Credited"]</th><th style="text-align:center">@Localizer["Status"]</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Returns) {
          <tr>
            <td style="font-size:12px">
              <a href="/Returns/Customer/@r.Id" style="color:#2563eb;font-weight:600">@r.ReturnNumber</a>
              <div style="color:#9ca3af;font-size:11px">@r.ReturnDate.ToLocalTime().ToString("dd-MMM-yy") ·
                @(r.LineCount == 1 ? Localizer["{0} line", r.LineCount] : Localizer["{0} lines", r.LineCount])
              </div>
            </td>
            <td style="text-align:right;font-weight:600">@r.GrandTotal.ToString("N0")</td>
            <td style="text-align:center;font-size:11px">
              <span class="badge @(r.Status == "Active" ? "ok" : "gray")">@Localizer[EnumDisplay.Key("ReturnStatus", r.Status)]</span>
            </td>
          </tr>
        }
        </tbody>
      </table>
      <p style="font-size:11px;color:#9ca3af;margin-top:8px">
        @Localizer["The invoice total above is unchanged by design — what the customer is owed sits on the credit note each return raised."]
      </p>
    </div>
  }

  <!-- Credit notes applied to this invoice -->
  @if (Model.NoteApplications.Any()) {
    <div class="card">
      <div class="card-title">🧮 @Localizer["Credit Notes Applied to This Invoice"]</div>
      <table>
        <thead><tr><th>@Localizer["Note"]</th><th style="text-align:right">@Localizer["Applied"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model.NoteApplications) {
          <tr style="@(a.IsReversed ? "color:#9ca3af" : "")">
            <td style="font-size:12px">
              <a href="/CreditNotes" style="color:@(a.IsReversed ? "#9ca3af" : "#2563eb");font-weight:600;@(a.IsReversed ? "text-decoration:line-through" : "")">@a.CreditNoteNumber</a>
              <div style="color:#9ca3af;font-size:11px">
                @a.ApplicationDate.ToLocalTime().ToString("dd-MMM-yy")
                @if (a.IsReversed) {
                  <span> · @Localizer["reversed by {0}", a.ReversedBy ?? ""]</span>
                }
              </div>
            </td>
            <td style="text-align:right;font-weight:600;@(a.IsReversed ? "text-decoration:line-through" : "")">@a.Amount.ToString("N0")</td>
            <td style="text-align:right">
              @if (a.CanReverse) {
                <form method="post" asp-page-handler="ReverseApplication" asp-route-id="@Model.Sale.Id" asp-route-applicationId="@a.Id"
                      onsubmit="return confirm('@Localizer["Reverse this application?"]')">
                  <button type="submit" class="btn btn-outline btn-sm">@Localizer["Reverse"]</button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
      <p style="font-size:11px;color:#9ca3af;margin-top:8px">
        @Localizer["The invoice total is unchanged — an applied note reduces the balance still due, not what was originally invoiced."]
      </p>
    </div>
  }

  <!-- Commission -->
  @if (Model.Commissions.Any()) {
    <div class="card">
      <div class="card-title">🧾 @Localizer["Commission Accrued"]</div>
      <table>
        <thead><tr><th>@Localizer["Sales Person"]</th><th style="text-align:right">@Localizer["Amount"]</th><th style="text-align:center">@Localizer["Status"]</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Commissions) {
          <tr>
            <td style="font-size:12px">
              @c.SalesPersonName
              <div style="color:#9ca3af;font-size:11px">@c.RuleName · @c.Rate.ToString("0.##")%</div>
            </td>
            <td style="text-align:right;font-weight:600">@c.Amount.ToString("N0")</td>
            <td style="text-align:center;font-size:11px">
              @if (c.IsVoided) {
                <span style="color:#9ca3af;font-weight:600;text-decoration:line-through">@Localizer["Voided"]</span>
              } else if (c.IsPaid) {
                <span style="color:#059669;font-weight:600">@Localizer["Paid"]</span>
              } else {
                <span style="color:#d97706;font-weight:600">@Localizer["Unpaid"]</span>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
      <p style="font-size:11px;color:#9ca3af;margin-top:8px">
        @Localizer["Pay salespeople out on the"] <a href="/Commissions">@Localizer["Commissions"]</a> @Localizer["page."]
      </p>
    </div>
  }

  <!-- Payment History -->
  @if (Model.Payments.Any()) {
    <div class="card">
      <div class="card-title">@Localizer["Payment History"]</div>
      <table>
        <thead><tr><th>@Localizer["Date"]</th><th style="text-align:right">@Localizer["Amount"]</th><th>@Localizer["Notes"]</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Payments) {
          <tr>
            <td style="font-size:12px">@p.PaymentDate.ToLocalTime().ToString("dd-MMM-yy HH:mm")</td>
            <td style="text-align:right;font-weight:600;color:#059669">@p.Amount.ToString("N0")</td>
            <td style="color:#9ca3af;font-size:12px">@(p.Notes ?? "—")</td>
          </tr>
        }
        <tr style="background:#f9fafb">
          <td style="font-weight:700">@Localizer["Total"]</td>
          <td style="text-align:right;font-weight:700;color:#059669">@Model.TotalCollected.ToString("N0")</td>
          <td></td>
        </tr>
        </tbody>
      </table>
    </div>
  }
</div>
</div>

@section Scripts {
<script>
// Client-only strings, sourced from the same resx keys the markup uses.
const T = {
    sending:    @Html.Raw(Json.Serialize(Localizer["Sending..."].Value)),
    noPrinter:  @Html.Raw(Json.Serialize(Localizer["Could not reach printer service."].Value)),
    loggedOut:  @Html.Raw(Json.Serialize(Localizer["You have been logged out. Reload the page and sign in again."].Value)),
    printTo:    @Html.Raw(Json.Serialize(Localizer["Print to {0}", Model.AppSettings.PrinterName].Value))
};

async function dotPrint(saleId) {
    const btn = document.getElementById('btnDot');
    const status = document.getElementById('printStatus');
    btn.disabled = true;
    btn.textContent = '⏳ ' + T.sending;
    status.style.display = 'none';
    try {
        const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        // X-CSRF-TOKEN is the header name configured in Program.cs (AddAntiforgery). This
        // used to send 'RequestVerificationToken', which the server never reads — so every
        // print was refused with "session expired" and the printer was never reached.
        const r = await fetch(`/api/print/invoice/${saleId}`, {
            method: 'POST', headers: { 'X-CSRF-TOKEN': tok }
        });
        // 401 = the login itself lapsed; the body is empty, not JSON.
        const d = r.status === 401 ? { error: T.loggedOut } : await r.json();
        status.className = r.ok ? 'alert alert-success' : 'alert alert-danger';
        status.textContent = r.ok ? '✓ ' + d.message : '✗ ' + d.error;
    } catch(e) {
        status.className = 'alert alert-danger';
        status.textContent = '✗ ' + T.noPrinter;
    }
    status.style.display = 'block';
    btn.disabled = false;
    btn.textContent = '🖨 ' + T.printTo;
}
</script>
}
