@page
@model SimpleERP.Web.Pages.Sales.DueModel
@{ ViewData["Title"] = Localizer["Due Payments by Customer"].Value; }
@if (Model.Msg != null) { <div class="alert alert-success">@Model.Msg</div> }
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
  <div>
    <span style="font-size:13px;color:#6b7280">@Localizer["Total outstanding:"] </span>
    <span style="font-size:20px;font-weight:700;color:#dc2626">@Model.TotalOutstanding.ToString("N0")</span>
  </div>
  <a href="/Payments" class="btn btn-outline btn-sm">@Localizer["View by Invoice"] &rarr;</a>
</div>
@if (!Model.Summary.Any()) {
<div class="card"><p style="color:#059669;font-size:14px;text-align:center;padding:20px">✓ @Localizer["No outstanding due payments!"]</p></div>
} else {
<div class="card">
<table>
<thead><tr>
  <th>@Localizer["Customer"]</th><th>@Localizer["Phone"]</th><th>@Localizer["Open Invoices"]</th>
  <th style="text-align:right">@Localizer["Total Due"]</th>
  <th style="text-align:right">@Localizer["Not yet due"]</th>
  <th style="text-align:right">1&ndash;30</th>
  <th style="text-align:right">31&ndash;60</th>
  <th style="text-align:right">61&ndash;90</th>
  <th style="text-align:right">90+</th>
  <th></th>
</tr></thead>
<tbody>
@foreach (var d in Model.Summary) {
<tr style="@(d.HasOverdue?"background:#fff7f7":"")">
  <td>
    <strong>@d.CustomerName</strong>
    @if (d.HasOverdue) {
      <span style="margin-left:6px;background:#fee2e2;color:#b91c1c;font-size:11px;font-weight:700;padding:2px 6px;border-radius:8px">⚠ @Localizer["OVERDUE"]</span>
    }
    @if (d.Aging.NoDueDate > 0) {
      <div style="font-size:11px;color:#9ca3af" title="@Localizer["Credit with no payment term agreed, so there is no date to be late against"]">
        @Localizer["incl. {0} with no due date", d.Aging.NoDueDate.ToString("N0")]
      </div>
    }
  </td>
  <td>@(d.Phone ?? "—")</td>
  <td><span class="badge info">@d.OpenInvoices</span></td>
  <td style="text-align:right"><span style="font-weight:700;color:#dc2626">@d.TotalDue.ToString("N0")</span></td>
  <td style="text-align:right;color:#6b7280">@(d.Aging.NotYetDue  > 0 ? d.Aging.NotYetDue.ToString("N0")  : "—")</td>
  <td style="text-align:right;color:@(d.Aging.Days1To30  > 0 ? "#b45309" : "#d1d5db")">@(d.Aging.Days1To30  > 0 ? d.Aging.Days1To30.ToString("N0")  : "—")</td>
  <td style="text-align:right;color:@(d.Aging.Days31To60 > 0 ? "#c2410c" : "#d1d5db")">@(d.Aging.Days31To60 > 0 ? d.Aging.Days31To60.ToString("N0") : "—")</td>
  <td style="text-align:right;color:@(d.Aging.Days61To90 > 0 ? "#dc2626" : "#d1d5db")">@(d.Aging.Days61To90 > 0 ? d.Aging.Days61To90.ToString("N0") : "—")</td>
  <td style="text-align:right;font-weight:@(d.Aging.Days90Plus > 0 ? "700" : "400");color:@(d.Aging.Days90Plus > 0 ? "#991b1b" : "#d1d5db")">@(d.Aging.Days90Plus > 0 ? d.Aging.Days90Plus.ToString("N0") : "—")</td>
  <td style="text-align:right;white-space:nowrap">
    <a href="/Sales?search=@Uri.EscapeDataString(d.CustomerName)" class="btn btn-outline btn-sm">
      @Localizer["Invoices"] &rarr;
    </a>
    <a href="/Payments/Statement/@d.CustomerId" class="btn btn-primary btn-sm">📄 @Localizer["Statement & Collect"]</a>
  </td>
</tr>}
</tbody>
</table>
</div>}
