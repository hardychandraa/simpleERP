@page
@model SimpleERP.Web.Pages.Sales.DueModel
@{ ViewData["Title"] = "Due Payments by Customer"; }
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
  <div>
    <span style="font-size:13px;color:#6b7280">Total Outstanding: </span>
    <span style="font-size:20px;font-weight:700;color:#dc2626">@Model.TotalOutstanding.ToString("N0")</span>
  </div>
  <a href="/Payments" class="btn btn-outline btn-sm">View by Invoice →</a>
</div>
@if (!Model.Summary.Any()) {
<div class="card"><p style="color:#059669;font-size:14px;text-align:center;padding:20px">✓ No outstanding due payments!</p></div>
} else {
<div class="card">
<table>
<thead><tr><th>Customer</th><th>Phone</th><th>Open Invoices</th><th>Total Due</th><th></th></tr></thead>
<tbody>
@foreach (var d in Model.Summary) {
<tr style="@(d.HasOverdue?"background:#fff7f7":"")">
  <td>
    <strong>@d.CustomerName</strong>
    @if (d.HasOverdue) {
      <span style="margin-left:6px;background:#fee2e2;color:#b91c1c;font-size:11px;font-weight:700;padding:2px 6px;border-radius:8px">⚠ OVERDUE</span>
    }
  </td>
  <td>@(d.Phone ?? "—")</td>
  <td><span class="badge info">@d.OpenInvoices</span></td>
  <td><span style="font-weight:700;color:#dc2626">@d.TotalDue.ToString("N0")</span></td>
  <td>
    <a href="/Sales?search=@Uri.EscapeDataString(d.CustomerName)" class="btn btn-outline btn-sm">
      View Invoices →
    </a>
  </td>
</tr>}
</tbody>
</table>
</div>}
