@page "/Account/ChangePassword"
@model SimpleERP.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = Localizer["Change Password"].Value; }

@if (Model.Msg != null)
{
    <div class="alert @(Model.IsErr ? "alert-danger" : "alert-success")">@Model.Msg</div>
}

<div class="card" style="max-width:460px">
    <div class="card-title">🔑 @Localizer["Change Password"]</div>
    <p style="font-size:12px;color:#6b7280;margin-bottom:16px;line-height:1.6">
        @Localizer["Changing your password signs nobody out — your current session stays open, but the old password stops working immediately."]
    </p>
    <form method="post">
        <div class="fg">
            <label>@Localizer["Current password"] *</label>
            <input type="password" asp-for="CurrentPassword" required autocomplete="current-password" />
        </div>
        <div class="fg">
            <label>@Localizer["New password"] *</label>
            <input type="password" asp-for="NewPassword" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="fg">
            <label>@Localizer["Confirm new password"] *</label>
            <input type="password" asp-for="ConfirmPassword" required minlength="8" autocomplete="new-password" />
        </div>
        <p style="font-size:11px;color:#9ca3af;margin-bottom:14px">
            @Localizer["At least 8 characters."]
        </p>
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
        <a href="/" class="btn btn-outline">@Localizer["Cancel"]</a>
    </form>
</div>
