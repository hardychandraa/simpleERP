@page "/Account/Denied"
@model SimpleERP.Web.Pages.Account.DeniedModel
@{ ViewData["Title"] = Localizer["Not permitted"].Value; }

<div class="card" style="max-width:560px">
    <div class="card-title">🔒 @Localizer["Not permitted"]</div>
    <p style="font-size:13px;color:#374151;line-height:1.7">
        @Localizer["This page is for administrators only. Purchasing, purchase prices and costs, commission, rebates, expenses and the financial reports are handled by an administrator."]
    </p>
    <p style="font-size:12px;color:#9ca3af;margin-top:12px;line-height:1.6">
        @Localizer["If you need access to it, ask an administrator to change your role."]
    </p>
    <div style="margin-top:18px">
        <a href="/" class="btn btn-primary">@Localizer["Back to Dashboard"]</a>
    </div>
</div>
